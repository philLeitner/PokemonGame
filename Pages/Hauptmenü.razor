@inject GameService Game

<div class="hauptmenu-screen">
    <div class="hauptmenu-box">
        <div class="spiel-logo">
            <span class="logo-icon">⚔️</span>
            <h1 class="spiel-titel">Monster Kampf</h1>
            <p class="spiel-untertitel">Fange, trainiere, kämpfe!</p>
        </div>

        <div class="menu-form">
            <label class="form-label">Dein Name:</label>
            <input class="form-input" @bind="spielerName" placeholder="Trainer" maxlength="12" />
        </div>

        <div class="menu-buttons">
            <button class="btn-start" @onclick="SpielStarten">▶ Neues Spiel</button>
            <button class="btn-editor" @onclick="Game.ZuMapEditor">🗺️ Map-Editor</button>
        </div>

        <div class="menu-info">
            <p>@Game.AlleMonster.Count Monster · @Game.AlleAttacken.Count Attacken · @TypeChart.AlleTypen.Length Typen</p>
        </div>
    </div>
</div>

@code {
    private string spielerName = "Trainer";

    private void SpielStarten()
    {
        if (string.IsNullOrWhiteSpace(spielerName)) spielerName = "Trainer";
        Game.SpielStarten(spielerName.Trim());
    }
}
