@inject GameService Game

<div class="hauptmenu-screen">
    <div class="hauptmenu-box">
        <div class="spiel-logo">
            <span class="logo-icon">⚔️</span>
            <h1 class="spiel-titel">Monster Kampf</h1>
            <p class="spiel-untertitel">Fange, trainiere, kämpfe!</p>
        </div>

        <div class="menu-form">
            <label class="form-label">Dein Name:</label>
            <input class="form-input" @bind="spielerName" placeholder="Trainer" maxlength="12" />
        </div>

        <div class="menu-buttons">
            <button class="btn-start" @onclick="SpielStarten">▶ Neues Spiel (Klassisch)</button>
            @if (Game.AlleRegionen.Any())
            {
                <button class="btn-start btn-gen-karte" @onclick="GenerierteKarteStarten">🗺️ Generierte Karte</button>
            }
            @if (Game.HatSpeicherstand)
            {
                <button class="btn-laden" @onclick="SpielLaden">📂 Spiel laden</button>
            }
            <button class="btn-editor" @onclick="Game.ZuMapEditor">🗺️ Map-Editor</button>
            <button class="btn-einstellungen" @onclick="Game.ZuEinstellungen">⚙️ Einstellungen &amp; Relikte</button>
            <button class="btn-eigene-map" @onclick="Game.ZuEigeneMapStart">🗺️ Eigene Map</button>
            <button class="btn-pokedex-menu" @onclick="Game.ZuPokédex">📖 Pokédex</button>
            <button class="btn-monster-editor" @onclick="Game.ZuMonsterEditor">🐾 Monster-Editor</button>
            <button class="btn-admin" @onclick="Game.ZuAdminPanel">🔧 Admin</button>
            @if (Game.SpielAbgeschlossen)
            {
                <button class="btn-zaehne" @onclick="Game.ZuZähneShop">🦷 Zähne-Shop</button>
            }
        </div>

        <div class="menu-info">
            <p>@Game.AlleMonster.Count Monster · @Game.AlleAttacken.Count Attacken · @TypeChart.AlleTypen.Length Typen</p>
        </div>
    </div>
</div>

@code {
    private string spielerName = "Trainer";

    private void SpielStarten()
    {
        if (string.IsNullOrWhiteSpace(spielerName)) spielerName = "Trainer";
        Game.SpielStarten(spielerName.Trim());
    }

    private void GenerierteKarteStarten()
    {
        if (string.IsNullOrWhiteSpace(spielerName)) spielerName = "Trainer";
        Game.GenerierteKarteSpielStarten(spielerName.Trim());
    }

    private async Task SpielLaden()
    {
        await Game.SpielstandLaden();
    }
}
