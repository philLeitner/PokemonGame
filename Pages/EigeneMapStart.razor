@using MonsterKampf.Services
@using MonsterKampf.Models
@inject GameService Game
@implements IDisposable

@* ══════════════════════════════════════════════════════════════════════════════
   EIGENE MAP START – Schöner Hub-Screen
   Separater Spielstand · kein Zähne/Boni · Map-Editor Zugang
══════════════════════════════════════════════════════════════════════════════ *@

<div class="ems-screen">
    <!-- Hintergrund-Deko -->
    <div class="ems-bg-grid"></div>

    <div class="ems-container">

        <!-- Header -->
        <div class="ems-header">
            <button class="ems-back-btn" @onclick="Game.ZuHauptmenü">← Hauptmenü</button>
            <div class="ems-title-block">
                <span class="ems-title-icon">🗺️</span>
                <h1 class="ems-title">Eigene Map</h1>
                <p class="ems-subtitle">Gestalte deine Welt – spiele auf deinen eigenen Regeln</p>
            </div>
            <div class="ems-badge-warn">⚠️ Kein Zähne &amp; Boni</div>
        </div>

        <!-- Zwei Spalten: Spielstand + Editor -->
        <div class="ems-body">

            <!-- Linke Karte: Spielstand -->
            <div class="ems-card ems-card-spielstand">
                <div class="ems-card-icon">💾</div>
                <h2 class="ems-card-titel">Spielstand</h2>
                <p class="ems-card-info">
                    Dein eigener Map-Spielstand ist <strong>komplett getrennt</strong> vom normalen Gen 1–8 Spielstand.
                    Er wird niemals überschrieben.
                </p>

                @if (ladevorgang)
                {
                    <div class="ems-laden">
                        <div class="ems-spinner">⚫</div>
                        <span>Lade...</span>
                    </div>
                }
                else if (fehler != null)
                {
                    <div class="ems-fehler">
                        <span>⚠️ @fehler</span>
                        <button class="ems-btn ems-btn-secondary" @onclick="() => fehler = null">Erneut versuchen</button>
                    </div>
                }
                else if (Game.HatEigeneMapSpeicherstand)
                {
                    <!-- Spielstand vorhanden -->
                    <div class="ems-spielstand-aktionen">
                        <button class="ems-btn ems-btn-primary" @onclick="WeiterSpielen">
                            ▶️ Weiterspielen
                        </button>
                        <button class="ems-btn ems-btn-secondary" @onclick="() => zeigeNeuStart = !zeigeNeuStart">
                            🔄 Neu starten
                        </button>
                    </div>

                    @if (zeigeNeuStart)
                    {
                        <div class="ems-neustart-panel">
                            <p class="ems-neustart-warnung">⚠️ Eigener Spielstand wird gelöscht!</p>
                            <div class="ems-neustart-optionen">
                                @if (Game.HatSpeicherstand)
                                {
                                    <button class="ems-neustart-btn ems-neustart-kopieren" @onclick="NeuMitKopie">
                                        <span class="ems-neustart-icon">📋</span>
                                        <span>Gen 1–8 kopieren</span>
                                    </button>
                                }
                                <button class="ems-neustart-btn ems-neustart-frisch" @onclick="NeuFrisch">
                                    <span class="ems-neustart-icon">✨</span>
                                    <span>Komplett neu</span>
                                </button>
                                <button class="ems-neustart-btn ems-neustart-abbrechen" @onclick="() => zeigeNeuStart = false">
                                    Abbrechen
                                </button>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <!-- Kein Spielstand -->
                    <div class="ems-spielstart-optionen">
                        @if (Game.HatSpeicherstand)
                        {
                            <button class="ems-start-option ems-start-kopieren" @onclick="StartenMitKopie">
                                <div class="ems-start-option-icon">📋</div>
                                <div class="ems-start-option-text">
                                    <strong>Spielstand kopieren</strong>
                                    <span>Pokémon &amp; Items aus Gen 1–8 übernehmen</span>
                                </div>
                            </button>
                        }
                        <button class="ems-start-option ems-start-neu" @onclick="StartenFrisch">
                            <div class="ems-start-option-icon">✨</div>
                            <div class="ems-start-option-text">
                                <strong>Neu starten</strong>
                                <span>Starter wählen &amp; von vorne beginnen</span>
                            </div>
                        </button>
                    </div>
                }
            </div>



        </div>

        <!-- Info-Footer -->
        <div class="ems-footer-info">
            <span>💡 Tipp: Erstelle zuerst deine Map im Editor, dann starte das Spiel!</span>
        </div>

    </div>
</div>

@code {
    bool ladevorgang = false;
    bool zeigeNeuStart = false;
    string? fehler = null;

    protected override void OnInitialized()
    {
        Game.OnChange += StateHasChanged;
    }

    public void Dispose() => Game.OnChange -= StateHasChanged;

    private async Task WeiterSpielen()
    {
        fehler = null;
        ladevorgang = true;
        StateHasChanged();
        try { await Game.EigeneMapStarten(spielstandKopieren: false); }
        catch (Exception ex) { fehler = ex.Message; }
        ladevorgang = false;
    }

    private async Task StartenMitKopie()
    {
        fehler = null;
        ladevorgang = true;
        StateHasChanged();
        try { await Game.EigeneMapStarten(spielstandKopieren: true); }
        catch (Exception ex) { fehler = ex.Message; }
        ladevorgang = false;
    }

    private async Task StartenFrisch()
    {
        fehler = null;
        ladevorgang = true;
        StateHasChanged();
        try { await Game.EigeneMapStarten(spielstandKopieren: false); }
        catch (Exception ex) { fehler = ex.Message; }
        ladevorgang = false;
    }

    private async Task NeuMitKopie()
    {
        zeigeNeuStart = false;
        await Game.EigeneMapSpielstandLöschen();
        await StartenMitKopie();
    }

    private async Task NeuFrisch()
    {
        zeigeNeuStart = false;
        await Game.EigeneMapSpielstandLöschen();
        await StartenFrisch();
    }
}
