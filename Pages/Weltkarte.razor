    private string OrtIcon(Ort ort) => ort.Typ switch
    {
        "stadt"  => ort.Arena != null ? "🏆" : "🏙️",
        "route"  => "🌿",
        "hoehle" => "⛰️",
        "wald"   => "🌲",
        _        => "📍"
    };

    private string RegionName(string ortId) => ortId.Length >= 3 ? ortId[..3] switch
    {
        "KAN" => "Kanto",
        "JOH" => "Johto",
        "HOE" => "Hoenn",
        "SIN" => "Sinnoh",
        "UNG" => "Unova",
        "KAL" => "Kalos",
        "ALO" => "Alola",
        "GAL" => "Galar",
        "PAL" => "Paldea",
        _     => "Unbekannt"
    } : "Unbekannt";

    private string GetTypEmoji(string typ) =>
        TypeChart.TypEmojis.GetValueOrDefault(typ, "❓");

    private string KpFarbe(MonsterInstanz mon)
    {
        float pct = mon.MaxKp > 0 ? (float)mon.AktuelleKp / mon.MaxKp : 0;
        return pct > 0.5f ? "kp-gruen" : pct > 0.25f ? "kp-gelb" : "kp-rot";
    }
    // ── Generierte Karte: Fog-of-War Helfer ─────────────────────────────────
    private bool GenOrtZugänglich(string ortId)
    {
        if (!Game.IstGenerierteKartenModus) return true;
        return Game.AktuelleGenerierteKarte?.FreigeschalteteOrte.Contains(ortId) ?? false;
    }
    private bool GenOrtImNebel(string ortId)
    {
        if (!Game.IstGenerierteKartenModus) return false;
        return !(Game.AktuelleGenerierteKarte?.FreigeschalteteOrte.Contains(ortId) ?? false);
    }
    private void ProfessorHeilen()
    {
        foreach (var mon in Game.Spieler.Team)
        {
            mon.AktuelleKp = mon.MaxKp;
            mon.Status = "none";
            mon.StatusZähler = 0;
            foreach (var atk in mon.Attacken)
                atk.AktuelleAp = atk.MaxAp;
        }
        meldung = "Alle Monster wurden geheilt!";
        Game.Notify();
    }
