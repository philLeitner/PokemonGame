    private string KpFarbe(MonsterInstanz mon)
    {
        float pct = mon.MaxKp > 0 ? (float)mon.AktuelleKp / mon.MaxKp : 0;
        return pct > 0.5f ? "kp-gruen" : pct > 0.25f ? "kp-gelb" : "kp-rot";
    }
    // ── Generierte Karte ──────────────────────────────────────────────────────
    private void EbeneAnklicken(GenerierteEbene ebene)
    {
        if (Game.AktuelleGenerierteKarte == null) return;
        var karte = Game.AktuelleGenerierteKarte;
        if (ebene.Index > karte.FreigeschalteBisIndex + 1) return;
        Game.GenerierteEbeneBetreten(ebene.Index);
    }
    private void ProfessorHeilen()
    {
        foreach (var mon in Game.Spieler.Team)
        {
            mon.AktuelleKp = mon.MaxKp;
            mon.Status = "none";
            mon.StatusZähler = 0;
            foreach (var atk in mon.Attacken)
                atk.AktuelleAp = atk.MaxAp;
        }
        meldung = "Alle Monster wurden geheilt!";
        Game.Notify();
    }
    private void ProfessorKarteUpdate()
    {
        if (Game.AktuelleGenerierteKarte == null) return;
        var karte = Game.AktuelleGenerierteKarte;
        var naechsteArena = karte.Ebenen
            .Skip(karte.AktuelleEbeneIndex)
            .FirstOrDefault(e => e.Typ == EbenenTyp.Arenaleiter);
        if (naechsteArena != null)
            karte.FreigeschalteBisIndex = Math.Max(karte.FreigeschalteBisIndex, naechsteArena.Index);
        meldung = "Karte aktualisiert! Neue Gebiete sichtbar.";
        Game.Notify();
    }
    private void GenArenaKampfStarten(GenerierteEbene arena)
    {
        Game.GenerierteArenaKampfStarten(arena);
    }
    private void GenErkunden()
    {
        var aktEbene = Game.AktuelleGenerierteEbene;
        if (aktEbene == null) return;
        var rng = new Random();
        var monster = Game.AlleMonster[rng.Next(Game.AlleMonster.Count)];
        int basisLevel = Math.Max(5, (aktEbene.Index / 10) * 5 + 5);
        int level = Game.GegnerLevelBerechnen(basisLevel);
        var begegnung = new WildBegegnung
        {
            MonsterId = monster.Id,
            MinLevel = level,
            MaxLevel = level + 2,
            Chance = 100
        };
        Game.WildkampfStarten(begegnung);
    }
