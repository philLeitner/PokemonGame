@inject GameService Game
@inject IJSRuntime JS
@implements IDisposable
@using MonsterKampf.Services
@using MonsterKampf.Models

<!-- Hauptcontainer für den Weltkarten-Bildschirm -->
<div class="weltkarte-screen">
    <!-- Linke Seitenleiste: Spieler-Infos, Team, Rucksack, Speichern/Laden, Navigation -->
    <div class="sidebar">
        <!-- Spieler-Info: Name, Geld, Orden-Anzeige -->
        <div class="spieler-info">
            <h3>🎮 @Game.Spieler.Name</h3>
            <p class="geld">💰 @Game.Spieler.Geld Münzen</p>
            <div class="orden-liste">
                @foreach (var orden in Game.Spieler.Orden)
                {
                    <span class="orden-badge" title="@orden">🏅</span>
                }
                @if (!Game.Spieler.Orden.Any())
                {
                    <span class="keine-orden">Noch keine Orden</span>
                }
            </div>
        </div>

        <!-- Team-Liste: Alle Monster im aktiven Team (max. 6), per Drag & Drop sortierbar -->
        <div class="team-liste">
            <h4>Mein Team <span class="team-anzahl">(@Game.Spieler.Team.Count/6)</span></h4>
            @for (int ti = 0; ti < Game.Spieler.Team.Count; ti++)
            {
                var mon = Game.Spieler.Team[ti];
                var idx = ti;
                <div class="team-eintrag @(mon.IstOhnmächtig ? "ohnmächtig" : "") @(DragIndex == idx ? "drag-aktiv" : "") @(DropIndex == idx ? "drop-ziel" : "")"
                     draggable="true"
                     @ondragstart="() => DragStart(idx)"
                     @ondragover:preventDefault
                     @ondragover="() => DragOver(idx)"
                     @ondrop="() => DragDrop()">
                    <span class="drag-handle" title="Reihenfolge ändern">☰</span>
                    <span class="team-emoji">@GetTypEmoji(mon.Typen.FirstOrDefault() ?? "")</span>
                    <div class="team-info">
                        <span class="team-name">@mon.Name</span>
                        <span class="team-level">Lv.@mon.Level</span>
                    </div>
                    <div class="team-kp-balken">
                        <div class="kp-fill @KpFarbe(mon)"
                             style="width: @(mon.MaxKp > 0 ? (mon.AktuelleKp * 100 / mon.MaxKp) : 0)%"></div>
                    </div>
                    <span class="team-kp-text">@mon.AktuelleKp/@mon.MaxKp</span>
                </div>
            }
        </div>

        <!-- Rucksack-Button: Öffnet das Inventar (nur sichtbar wenn Items vorhanden) -->
        @if (Game.Spieler.Inventar.Any())
        {
            <button class="btn-rucksack" @onclick="RucksackOeffnen">
                🎒 Rucksack (@Game.Spieler.Inventar.Sum(i => i.Menge))
            </button>
        }

        @if (Game.IstEigeneMapModus)
        {
            <div class="eigene-map-modus-badge">
                🗺️ Eigene Map
                <span class="eigene-map-kein-bonus-klein">(keine Boni)</span>
            </div>
        }

        <div class="speichern-buttons">
            @if (Game.ManuellSpeichernErlaubt)
            {
                <button class="btn-speichern" @onclick="SpielstandSpeichernAktuell">💾 Speichern</button>
            }
            else
            {
                <button class="btn-speichern" disabled title="Relikt: Manuelles Speichern gesperrt!">🚫 Speichern</button>
            }
            @if (!Game.IstEigeneMapModus)
            {
                <button class="btn-laden" @onclick="SpielstandLaden">📂 Laden</button>
            }
        </div>

        @if (Game.IstGenerierteKartenModus)
        {
            <button class="btn-generieren btn-neu-generieren" @onclick="NeuGenerierenBestaetigen">
                🎲 Reload / neu generieren
            </button>
        }
        @if (Game.IstEigeneMapModus)
        {
            <button class="btn-hauptmenu btn-eigene-map-verlassen" @onclick="ZumNormalenSpielstandWechseln">
                ← Gen 1–8 Spielstand
            </button>
        }
        else
        {
            <button class="btn-hauptmenu" @onclick="Game.ZuHauptmenü">🏠 Hauptmenü</button>
        }
        @if (Game.Einstellungen.HatRelikt(ReliktTyp.KeinPokédex))
        {
            <button class="btn-pokedex-klein" disabled title="Relikt: Monsterlexikon gesperrt!">🚫 Monsterlexikon</button>
        }
        else
        {
            <button class="btn-pokedex-klein" @onclick="Game.ZuPokédex">📖 Monsterlexikon</button>
        }
        <button class="btn-admin-klein" @onclick="Game.ZuAdminPanel">🔧 Admin</button>
    </div>

    <!-- Rechter Hauptbereich: Karte und Ort-Details -->
    <div class="karte-bereich">
        <h2 class="karte-titel">
            @if (Game.IstGenerierteKartenModus)
            {
                <span>🗺️ Generierte Karte</span>
                @if (Game.AktuelleGenerierteKarte != null)
                {
                    <button class="btn-seed-kopieren" title="Karten-Code kopieren"
                            @onclick="SeedKodierenKopieren">
                        🔑 @(Game.AktuelleGenerierteKarte.SeedCode.Length > 8 ? Game.AktuelleGenerierteKarte.SeedCode[..8] + "..." : Game.AktuelleGenerierteKarte.SeedCode)
                        <span class="seed-kopier-icon">@(seedKopiertMeldung ? "✓" : "📋")</span>
                    </button>
                }
            }
            else
            {
                <span>🗺️ Weltkarte</span>
            }
        </h2>

        <!-- Layout-Container: Minimap links, Ort-Details rechts -->
        <div class="karte-haupt-layout">

        <!-- Das 3x3 Navigations-Raster (Minimap): Zeigt den aktuellen Ort und die 4 Nachbarorte -->
        <div class="minimap-container">
        @{
            var aktOrt = Game.AktuellerOrt;
            Ort? GetOrt(string? id) => id == null ? null : Game.AlleOrte.FirstOrDefault(o => o.Id == id);
            var nord = GetOrt(aktOrt?.Nord);
            var süd  = GetOrt(aktOrt?.Sued);
            var ost  = GetOrt(aktOrt?.Ost);
            var west = GetOrt(aktOrt?.West);
            // Nur die 4 Hauptrichtungen anzeigen (keine Ecken NW/NO/SW/SO)
            var felder = new Ort?[3, 3]
            {
                { null, nord,   null },
                { west, aktOrt, ost  },
                { null, süd,   null }
            };
        }
        @if (aktOrt != null)
        {
            <div class="minimap-region-label">
                <span class="minimap-region-icon">🌍</span>
                <span>@RegionName(aktOrt.Id)</span>
                <span class="minimap-ort-aktuell">📍 @aktOrt.Name</span>
            </div>
            <div class="minimap-grid">
                @for (int row = 0; row < 3; row++)
                {
                    @for (int col = 0; col < 3; col++)
                    {
                        var feld = felder[row, col];
                        bool istZentrum = row == 1 && col == 1;
                        bool istAusgewählt = feld?.Id == ausgewähltOrtId;
                        if (feld != null)
                        {
                            var f = feld;
                            <div class="minimap-zelle @(istZentrum ? "zentrum" : "") @(istAusgewählt ? "ausgewaehlt" : "")"
                                 style="background: @WeltData.OrtFarben.GetValueOrDefault(f.Farbe, "#374151")"
                                 draggable="false"
                                 @ondragstart:preventDefault
                                 @onclick="() => MinimapKlick(f, row, col)">
                                <span class="minimap-icon">@OrtIcon(f)</span>
                                <span class="minimap-name">@f.Name</span>
                                @if (f.Arena != null && Game.Spieler.Orden.Contains(f.Arena.OrdenName))
                                {
                                    <span class="minimap-orden">✓</span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="minimap-zelle leer"></div>
                        }
                    }
                }
            </div>
        }
        else
        {
            <div class="minimap-leer">📍 Kein Startort gefunden</div>
        }
        </div>

        <!-- Ort-Details (rechts daneben) -->
        <div class="location-info">
        @{
            var anzeigeOrt = ausgewähltOrt ?? aktOrt;
        }
        @if (anzeigeOrt != null)
        {
            bool istHier2 = anzeigeOrt.Id == Game.Spieler.AktuellerOrt;
            var ortRef3 = Game.AlleOrte.First(o => o.Id == anzeigeOrt.Id);
            // Zugangsprüfung: neue einfache Methode
            string? zugangsFehler2 = istHier2 ? null : Game.ZugangPrüfen(ortRef3.Id);
            <div class="ort-details">
                <div class="ort-details-header">
                    <h3>@anzeigeOrt.Name</h3>
                    <span class="ort-typ-badge">@(char.ToUpper(anzeigeOrt.Typ[0]) + anzeigeOrt.Typ[1..])</span>
                </div>
                @if (!string.IsNullOrEmpty(anzeigeOrt.Beschreibung))
                {
                    <p class="ort-beschreibung">@anzeigeOrt.Beschreibung</p>
                }
                <div class="ort-aktionen">
                    @if (!istHier2)
                    {
                        @if (zugangsFehler2 != null)
                        {
                            <div class="ort-gesperrt-hinweis">
                                <span class="gesperrt-icon">⛔</span>
                                <span>@zugangsFehler2.Replace("⛔ ", "")</span>
                            </div>
                            <button class="btn-reisen btn-reisen-gesperrt" disabled>
                                🔒 Zugang gesperrt
                            </button>
                        }
                        else
                        {
                            <button class="btn-reisen" @onclick="ZumOrtReisen">
                                🚶 Nach @anzeigeOrt.Name reisen
                            </button>
                        }
                    }
                    else
                    {
                        <span class="aktueller-ort-label">📍 Du bist hier</span>

                        <!-- Wilde Monster -->
                        @if (ortRef3.WildMonster.Any())
                        {
                            <div class="ort-sektion">
                                <div class="ort-sektion-header">🌿 Wilde Monster</div>
                                <div class="wild-monster-liste">
                                    @foreach (var wm in ortRef3.WildMonster)
                                    {
                                        var monData = Game.AlleMonster.FirstOrDefault(m => m.Id == wm.MonsterId);
                                        if (monData != null)
                                        {
                                            <span class="wild-monster-chip">
                                                @GetTypEmoji(monData.Typen.FirstOrDefault() ?? "") @monData.Name
                                                <span class="wild-level">Lv.@wm.MinLevel–@wm.MaxLevel</span>
                                            </span>
                                        }
                                    }
                                </div>
                                <button class="btn-erkunden" @onclick="ImGrasErkunden">
                                    🌿 Im Gras erkunden
                                </button>
                            </div>
                        }

                        <!-- NPCs (Sensei, etc.) -->
                        @if (ortRef3.NPCs.Any())
                        {
                            <div class="ort-sektion">
                                <div class="ort-sektion-header">💬 Personen</div>
                                @foreach (var npc in ortRef3.NPCs)
                                {
                                    var n = npc;
                                    bool bereitsGesprochen = Game.Spieler.BesproacheneNPCs.Contains(n.Id);
                                    <button class="btn-npc @(bereitsGesprochen ? "gesprochen" : "")"
                                            @onclick="() => NpcSprechen(n)">
                                        @n.Emoji @n.Name
                                        @if (!bereitsGesprochen && n.GibtItemId != null)
                                        {
                                            <span class="npc-item-hint">🎁</span>
                                        }
                                    </button>
                                }
                            </div>
                        }

                        <!-- Kämpfe (Trainer + Arena) -->
                        @if (ortRef3.Trainer.Any(t => !Game.Spieler.BesiegteTrainer.Contains(t.Id) && t.Klasse != "Arena" && t.Klasse != "Arena/Boss") || ortRef3.Arena != null)
                        {
                            <div class="ort-sektion">
                                <div class="ort-sektion-header">⚔️ Kämpfe</div>
                                @foreach (var trainer in ortRef3.Trainer.Where(t => !Game.Spieler.BesiegteTrainer.Contains(t.Id) && t.Klasse != "Arena" && t.Klasse != "Arena/Boss"))
                                {
                                    var t2 = trainer;
                                    @if (t2.Klasse == "Rivale")
                                    {
                                        <button class="btn-rival" @onclick="() => TrainerKämpfen(t2)">
                                            ⚔️ @t2.Name
                                        </button>
                                    }
                                    else if (t2.Klasse.StartsWith("Team ") || t2.Klasse.StartsWith("Böse"))
                                    {
                                        <button class="btn-boeseorg" @onclick="() => TrainerKämpfen(t2)">
                                            😈 @t2.Name
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn-trainer" @onclick="() => TrainerKämpfen(t2)">
                                            🧑 @t2.Name
                                        </button>
                                    }
                                }
                                @if (ortRef3.Arena != null && !ortRef3.IstRivaleStadt)
                                {
                                    bool bereitsGewonnen = Game.Spieler.Orden.Contains(ortRef3.Arena!.OrdenName);
                                    <button class="btn-arena @(bereitsGewonnen ? "gewonnen" : "")"
                                            @onclick="() => ArenaKämpfen(ortRef3)"
                                            disabled="@bereitsGewonnen">
                                        🏆 @(bereitsGewonnen ? $"✓ {ortRef3.Arena!.OrdenName}" : $"Arena: {ortRef3.Arena!.Leiter}")
                                    </button>
                                }
                                @if (ortRef3.IstRivaleStadt && ortRef3.Arena != null)
                                {
                                    bool rivaleBesiegt = Game.Spieler.Orden.Contains(ortRef3.Arena!.OrdenName);
                                    <button class="btn-arena @(rivaleBesiegt ? "gewonnen" : "")"
                                            @onclick="() => ArenaKämpfen(ortRef3)"
                                            disabled="@rivaleBesiegt">
                                        ⚔️ @(rivaleBesiegt ? $"✓ Rivale besiegt" : $"Rivale: {ortRef3.Arena!.Leiter}")
                                    </button>
                                }
                            </div>
                        }

                        <!-- Einrichtungen -->
                        @if (ortRef3.HatMonsterCenter || ortRef3.HatMarkt || ortRef3.MarktAngebot.Any())
                        {
                            <div class="ort-sektion">
                                <div class="ort-sektion-header">🏢 Einrichtungen</div>
                                @if (ortRef3.HatMonsterCenter)
                                {
                                    <button class="btn-center" @onclick="MonsterZentrumHeilen">
                                        🏥 Monster Center
                                    </button>
                                }
                                @if (ortRef3.HatMarkt || ortRef3.MarktAngebot.Any())
                                {
                                    @if (Game.Einstellungen.HatRelikt(ReliktTyp.KeinMarkt))
                                    {
                                        <button class="btn-markt" disabled title="Relikt: Markt gesperrt!">
                                            🚫 Markt (gesperrt)
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn-markt" @onclick="MarktOeffnen">
                                            🏪 Markt (@ortRef3.MarktAngebot.Count Items)
                                        </button>
                                    }
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        }
        </div><!-- /location-info -->
        </div><!-- /karte-haupt-layout -->
    </div>
</div>

<!-- NPC Gesprächs-Dialog -->
@if (npcDialog != null)
{
    <div class="meldung-overlay" @onclick="NpcDialogSchließen">
        <div class="npc-dialog-box" @onclick:stopPropagation="true">
            <div class="npc-dialog-header">
                <span class="npc-dialog-emoji">@npcDialogEmoji</span>
                <span class="npc-dialog-name">@npcDialogName</span>
            </div>
            <p class="npc-dialog-text">@npcDialog</p>
            @if (npcGeschenktItem != null)
            {
                <div class="npc-item-erhalten">
                    <span>🎁 Du hast erhalten:</span>
                    <strong>@npcGeschenktItemEmoji @npcGeschenktItem</strong>
                </div>
            }
            <button class="btn-ok" @onclick="NpcDialogSchließen">OK</button>
        </div>
    </div>
}

@if (meldung != null)
{
    <div class="meldung-overlay" @onclick="MeldungSchließen">
        <div class="meldung-box">
            <p>@meldung</p>
            <button class="btn-ok" @onclick="MeldungSchließen">OK</button>
        </div>
    </div>
}

<!-- Rucksack-Overlay -->
@if (rucksackOffen)
{
    // Rucksack-Kategorien
    var rucksackKategorien = new[] { "Alle", "Heilitems", "Pokébälle", "Statusprobleme", "Ausrüstung", "Sonstiges" };
    var gefilterteItems = Game.Spieler.Inventar.Where(i => {
        if (aktiveRucksackTab == "Alle") return true;
        var d = Game.GetItemDef(i.ItemId);
        string kat = d?.Kategorie ?? i.Kategorie;
        return kat == aktiveRucksackTab;
    }).ToList();
    <div class="meldung-overlay" @onclick="RucksackSchließen">
        <div class="rucksack-box rucksack-box-neu" @onclick:stopPropagation="true">
            <div class="markt-header">
                <h3>🎒 Rucksack</h3>
                <span class="markt-geld">💰 @Game.Spieler.Geld Münzen</span>
                <button class="btn-schliessen" @onclick="RucksackSchließen">✕</button>
            </div>
            <!-- Registerkarten -->
            <div class="rucksack-tabs">
                @foreach (var tab in rucksackKategorien)
                {
                    var t = tab;
                    int anzahl = t == "Alle" ? Game.Spieler.Inventar.Count
                        : Game.Spieler.Inventar.Count(i => { var d = Game.GetItemDef(i.ItemId); return (d?.Kategorie ?? i.Kategorie) == t; });
                    <button class="rucksack-tab @(aktiveRucksackTab == t ? "aktiv" : "")" @onclick="() => aktiveRucksackTab = t">
                        @t @(anzahl > 0 ? $"({anzahl})" : "")
                    </button>
                }
            </div>
            <!-- Ausrüstungs-Dialog: Monster wählen -->
            @if (ausrüstItemId != null)
            {
                var ausrüstDef = Game.GetItemDef(ausrüstItemId);
                <div class="ausrüst-dialog">
                    <p>🐎 <strong>@ausrüstDef?.Name</strong> welchem Monster geben?</p>
                    <div class="ausrüst-team">
                        @foreach (var mon in Game.Spieler.Team)
                        {
                            var m = mon;
                            bool trägtSchon = m.GetrageneItemId == ausrüstItemId;
                            <button class="ausrüst-mon-btn" style="@(trägtSchon ? "border-color:#f59e0b;background:rgba(245,158,11,0.2)" : "")" @onclick="() => ItemAusrüstenMon(m)">
                                @m.AngezeigterName Lv.@m.Level
                                @if (!string.IsNullOrEmpty(m.GetrageneItemId))
                                {
                                    var getItem = Game.GetItemDef(m.GetrageneItemId);
                                    <span class="mon-item-badge">@getItem?.Emoji @getItem?.Name</span>
                                }
                            </button>
                        }
                    </div>
                    <button class="btn-abbrechen" @onclick="() => ausrüstItemId = null">Abbrechen</button>
                </div>
            }
            @if (steinItemId != null)
            {
                <div class="ausrüst-dialog">
                    <p>@steinItemEmoji <strong>@steinItemName</strong> auf welches Monster anwenden?</p>
                    <p style="font-size:0.8em;color:#aaa;">Nur kompatible Monster können sich entwickeln.</p>
                    <div class="ausrüst-team">
                        @foreach (var mon in Game.Spieler.Team)
                        {
                            var m = mon;
                            bool kompatibel = !string.IsNullOrEmpty(m.EntwickeltZu) &&
                                (m.EntwicklungTrigger ?? "").Equals(steinItemTrigger, StringComparison.OrdinalIgnoreCase);
                            <button class="ausrüst-mon-btn" style="@(kompatibel ? "border-color:#22c55e;background:rgba(34,197,94,0.15)" : "opacity:0.5")" @onclick="() => SteinAufMonsterAnwenden(m)">
                                @m.AngezeigterName Lv.@m.Level
                                @if (kompatibel)
                                {
                                    <span class="mon-item-badge" style="background:#22c55e20;color:#22c55e">✨ kann sich entwickeln</span>
                                }
                            </button>
                        }
                    </div>
                    <button class="btn-abbrechen" @onclick="() => steinItemId = null">Abbrechen</button>
                </div>
            }
            <!-- Item-Liste -->
            <div class="rucksack-items">
                @if (!gefilterteItems.Any())
                {
                    <p class="rucksack-leer">Keine Items in dieser Kategorie.</p>
                }
                else
                {
                    @foreach (var item in gefilterteItems)
                    {
                        var itm = item;
                        var itemDef = Game.GetItemDef(itm.ItemId);
                        bool istKarteItem = itm.ItemId.StartsWith("ITEM-KARTE", StringComparison.OrdinalIgnoreCase)
                            || itm.Name.EndsWith("-Karte", StringComparison.OrdinalIgnoreCase)
                            || itm.Name.EndsWith("karte", StringComparison.OrdinalIgnoreCase);
                        bool istAusrüstung = itemDef?.Effekt.Typ == "Ausrüstung";
                        bool istVerwendbar = !istKarteItem && itemDef != null && itemDef.Effekt.Typ != "Keine";
                        <div class="rucksack-item @(istKarteItem ? "karte-item" : "")">
                            <span class="item-emoji">@itm.Emoji</span>
                            <div class="item-info">
                                <span class="item-name">@itm.Name <span class="item-menge-badge">×@itm.Menge</span></span>
                                @if (itemDef != null)
                                {
                                    <span class="item-beschreibung">@itemDef.Beschreibung</span>
                                }
                            </div>
                            <div class="rucksack-item-aktionen">
                                @if (istKarteItem)
                                {
                                    <button class="btn-item-verwenden" @onclick="() => RucksackItemKlick(itm)">🗺️ Anzeigen</button>
                                }
                                else if (istAusrüstung)
                                {
                                    <button class="btn-item-verwenden btn-ausrüsten" @onclick="() => ausrüstItemId = itm.ItemId">⚔️ Ausrüsten</button>
                                }
                                else if (istVerwendbar && Game.Spieler.Team.Any())
                                {
                                    <button class="btn-item-verwenden" @onclick="() => RucksackItemAnwenden(itm)">✅ Verwenden</button>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

@if (vollkarteOffen)
{
    var vollkarteRegion = vollkarteRegionId;
    var istGenModus = Game.IstGenerierteKartenModus && Game.AktuelleGenerierteKarte != null;
    var genMeta = Game.AktuelleGenerierteKarte;
    var alleFreischalten = vollkarteAlleFreischalten;

    // Klassischer Modus: Ortsliste nach Region
    var vollkarteOrteKlassisch = (string.IsNullOrEmpty(vollkarteRegion)
        ? Game.AlleOrte
        : Game.AlleOrte.Where(o => o.Id.StartsWith(vollkarteRegion + "-", StringComparison.OrdinalIgnoreCase)).ToList());

    <div class="meldung-overlay" @onclick="VollkarteSchliessen">
        <div class="vollkarte-box @(istGenModus ? "vollkarte-netz" : "")" @onclick:stopPropagation="true">
            <div class="markt-header">
                <h3>🗺️ @vollkarteName</h3>
                @if (istGenModus)
                {
                    @if (alleFreischalten)
                    {
                        <span class="vollkarte-anzahl vollkarte-alle-badge">🗺️ Gesamte Karte</span>
                    }
                    else
                    {
                        <span class="vollkarte-anzahl">@genMeta!.FreigeschalteteOrte.Count / @genMeta.OrtReihenfolge.Count freigeschaltet</span>
                    }
                }
                else
                {
                    <span class="vollkarte-anzahl">@vollkarteOrteKlassisch.Count Orte</span>
                }
                <button class="btn-schliessen" @onclick="VollkarteSchliessen">✕</button>
            </div>

            @if (istGenModus && genMeta != null && genMeta.OrtKoordinaten.Count > 0)
            {
                <!-- Grafische Netzansicht (wie HTML-Generator) -->
                var coords = genMeta.OrtKoordinaten;
                int minX = coords.Values.Min(c => c.X);
                int maxX = coords.Values.Max(c => c.X);
                int minY = coords.Values.Min(c => c.Y);
                int maxY = coords.Values.Max(c => c.Y);
                int TILE = 110; int PAD = 60;
                int svgW = (maxX - minX + 1) * TILE + PAD * 2;
                int svgH = (maxY - minY + 1) * TILE + PAD * 2;
                Func<int,int> netzOffX = x => (x - minX) * TILE + PAD;
                Func<int,int> netzOffY = y => (y - minY) * TILE + PAD;
                var alleGenOrte = genMeta.OrtReihenfolge
                    .Select(id => Game.AlleOrte.FirstOrDefault(o => o.Id == id))
                    .Where(o => o != null).Cast<Ort>().ToList();
                <div class="vollkarte-netz-scroll">
                            <div class="vollkarte-legende">
                                <span class="vk-leg"><span class="vk-dot" style="background:#6366f1"></span>Stadt</span>
                                <span class="vk-leg"><span class="vk-dot" style="background:#22c55e"></span>Route</span>
                                <span class="vk-leg"><span class="vk-dot" style="background:#78716c"></span>Höhle</span>
                                <span class="vk-leg"><span class="vk-dot" style="background:#16a34a"></span>Wald</span>
                                <span class="vk-leg"><span class="vk-dot" style="background:#f59e0b"></span>Arena</span>
                                <span class="vk-leg"><span class="vk-dot" style="background:#374151"></span>Unbekannt</span>
                            </div>
                            <div class="vk-netz-container" style="width:@(svgW)px; height:@(svgH)px; position:relative;">
                                <!-- SVG-Linien -->
                                <svg style="position:absolute;top:0;left:0;width:@(svgW)px;height:@(svgH)px;pointer-events:none;">
                                    @foreach (var ort in alleGenOrte)
                                    {
                                        if (!coords.TryGetValue(ort.Id, out var posA)) continue;
                                        int ax = netzOffX(posA.X) + 45; int ay = netzOffY(posA.Y) + 20;
                                        bool freiA = alleFreischalten || genMeta.FreigeschalteteOrte.Contains(ort.Id);
                                        // Ost-Verbindung
                                        if (!string.IsNullOrEmpty(ort.Ost) && coords.TryGetValue(ort.Ost, out var posB))
                                        {
                                            bool freiB = alleFreischalten || genMeta.FreigeschalteteOrte.Contains(ort.Ost);
                                            string lc = (freiA && freiB) ? "#4b5563" : "#1f2937";
                                            <line x1="@ax" y1="@ay" x2="@(netzOffX(posB.X)+45)" y2="@(netzOffY(posB.Y)+20)" stroke="@lc" stroke-width="2" />
                                        }
                                        // Süd-Verbindung
                                        if (!string.IsNullOrEmpty(ort.Sued) && coords.TryGetValue(ort.Sued, out var posC))
                                        {
                                            bool freiC = alleFreischalten || genMeta.FreigeschalteteOrte.Contains(ort.Sued);
                                            string lc = (freiA && freiC) ? "#4b5563" : "#1f2937";
                                            <line x1="@ax" y1="@ay" x2="@(netzOffX(posC.X)+45)" y2="@(netzOffY(posC.Y)+20)" stroke="@lc" stroke-width="2" />
                                        }
                                    }
                                </svg>
                                <!-- Ort-Boxen -->
                                @foreach (var ort in alleGenOrte)
                                {
                                    if (!coords.TryGetValue(ort.Id, out var pos)) continue;
                                    bool istFrei = alleFreischalten || genMeta.FreigeschalteteOrte.Contains(ort.Id);
                                    bool istHier = ort.Id == Game.Spieler.AktuellerOrt;
                                    bool hatOrden = ort.Arena != null && !ort.IstRivaleStadt && Game.Spieler.Orden.Contains(ort.Arena.OrdenName);
                                    bool istArena = ort.Arena != null && !ort.IstRivaleStadt;
                                    bool istBesiegt = istArena && genMeta.BesiegteArenen.Contains(ort.Id);
                                    string boxClass = "vk-netz-box"
                                        + (istHier ? " vk-hier" : "")
                                        + (istArena ? " vk-arena-box" : "")
                                        + (istBesiegt ? " vk-besiegt" : "")
                                        + (!istFrei ? " vk-fog" : "");
                                    int bx = netzOffX(pos.X); int by = netzOffY(pos.Y);
                                    <div class="@boxClass"
                                         style="left:@(bx)px; top:@(by)px;"
                                         @onclick="() => { if(istFrei) VollkarteOrtWählen(ort); }">
                                        @if (!istFrei)
                                        {
                                            <span class="vk-netz-nr">?</span>
                                            <span class="vk-netz-name">???</span>
                                        }
                                        else
                                        {
                                            <span class="vk-netz-icon">@OrtIcon(ort)</span>
                                            <span class="vk-netz-name">@ort.Name</span>
                                            @if (istArena) { <span class="vk-netz-orden">@(hatOrden ? "✓" : "🏆")</span> }
                                            @if (ort.IstRivaleStadt) { <span class="vk-netz-orden">⚔️</span> }
                                            @if (istHier) { <span class="vk-netz-hier">►</span> }
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            }
            else
            {
                <!-- Klassische Listansicht -->
                <div class="vollkarte-inhalt">
                    <div class="vollkarte-legende">
                        <span class="vk-leg"><span class="vk-dot" style="background:#6366f1"></span>Stadt</span>
                        <span class="vk-leg"><span class="vk-dot" style="background:#22c55e"></span>Route</span>
                        <span class="vk-leg"><span class="vk-dot" style="background:#78716c"></span>Höhle</span>
                        <span class="vk-leg"><span class="vk-dot" style="background:#16a34a"></span>Wald</span>
                        <span class="vk-leg"><span class="vk-dot" style="background:#f59e0b"></span>Arena</span>
                    </div>
                    <div class="vollkarte-liste">
                        @foreach (var ort in vollkarteOrteKlassisch)
                        {
                            var o = ort;
                            bool istHier = o.Id == Game.Spieler.AktuellerOrt;
                            bool hatOrden = o.Arena != null && !o.IstRivaleStadt && Game.Spieler.Orden.Contains(o.Arena.OrdenName);
                            string farbe = o.Arena != null && !o.IstRivaleStadt ? "#f59e0b"
                                : o.Typ == "stadt" ? "#6366f1"
                                : o.Typ == "route" ? "#22c55e"
                                : o.Typ == "hoehle" ? "#78716c"
                                : o.Typ == "wald" ? "#16a34a"
                                : "#4b5563";
                            <div class="vollkarte-ort @(istHier ? "hier" : "")" style="border-left: 3px solid @farbe"
                                 @onclick="() => VollkarteOrtWählen(o)">
                                <span class="vk-icon">@OrtIcon(o)</span>
                                <div class="vk-info">
                                    <span class="vk-name">@o.Name</span>
                                    @if (o.Arena != null && !o.IstRivaleStadt)
                                    {
                                        <span class="vk-arena">🏅 @o.Arena.OrdenName @(hatOrden ? "✓" : "")</span>
                                    }
                                    @if (o.IstRivaleStadt)
                                    {
                                        <span class="vk-arena">⚔️ Rivale-Kampf</span>
                                    }
                                </div>
                                @if (istHier) { <span class="vk-hier">📍 Du bist hier</span> }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}
<!-- ══════════════════════════════════════════════════════════════════════
     EINRICHTUNGS-WIZARD (erscheint nach Prof.-Dialog beim ersten Mal)
     ══════════════════════════════════════════════════════════════════════ -->
@if (wizardAktiv)
{
    <div class="wizard-overlay">
        <div class="wizard-box" @onclick:stopPropagation="true">
            <!-- Header -->
            <div class="wizard-header">
                <div class="wizard-schritte">
                    @for (int s = 1; s <= 4; s++)
                    {
                        int step = s;
                        string[] labels = { "🥚 Starter", "🌿 Wilde", "👥 Trainer", "💀 Relikte" };
                        <div class="wizard-schritt-dot @(wizardSchritt == step ? "aktiv" : wizardSchritt > step ? "fertig" : "")">
                            <span class="ws-num">@(wizardSchritt > step ? "✓" : step.ToString())</span>
                            <span class="ws-label">@labels[step - 1]</span>
                        </div>
                        @if (step < 4) { <div class="ws-linie @(wizardSchritt > step ? "fertig" : "")"></div> }
                    }
                </div>
            </div>

            <!-- Schritt 1: Starter -->
            @if (wizardSchritt == 1)
            {
                <div class="wizard-inhalt">
                    <h2 class="wizard-titel">🥚 Wähle deinen Starter!</h2>
                    <p class="wizard-info">Dein erstes Monster begleitet dich auf der gesamten Reise.</p>
                    <div class="wizard-starter-grid">
                        @foreach (var mon in wizardStarterOptionen)
                        {
                            var m = mon;
                            bool gewählt = wizardGewählterStarterId == m.Id;
                            <div class="wizard-starter-karte @(gewählt ? "ausgewaehlt" : "")" @onclick="() => WizardStarterWählen(m.Id)">
                                @if (!string.IsNullOrEmpty(m.BildUrl))
                                {
                                    <img class="starter-bild" src="@m.BildUrl" alt="@m.Name" />
                                }
                                else
                                {
                                    <div class="starter-emoji-gross">@GetTypEmoji(m.Typen.FirstOrDefault() ?? "")</div>
                                }
                                <div class="starter-karte-name">@m.Name</div>
                                <div class="starter-karte-typen">
                                    @foreach (var typ in m.Typen)
                                    {
                                        <span class="typ-badge-mini" style="background: @TypeChart.TypFarben.GetValueOrDefault(typ, "#888")">@typ</span>
                                    }
                                </div>
                                <div class="starter-karte-stats">
                                    <span>KP @m.Stats.GetValueOrDefault("kp", 45)</span>
                                    <span>ATK @m.Stats.GetValueOrDefault("angriff", 45)</span>
                                    <span>SPD @m.Stats.GetValueOrDefault("initiative", 45)</span>
                                </div>
                                @if (gewählt) { <div class="starter-check">✓</div> }
                            </div>
                        }
                    </div>
                    <div class="wizard-starter-aktionen">
                        <button class="btn-wizard-zufall" @onclick="WizardStarterZufälligRegion">
                            🗺️ Zufällig (nur diese Region)
                        </button>
                        <button class="btn-wizard-zufall" @onclick="WizardStarterZufälligAlle">
                            🌍 Zufällig (alle Regionen)
                        </button>
                        <button class="btn-wizard-zufall" @onclick="WizardStarterEchteStarter">
                            ⭐ Zufällige Starter
                        </button>
                    </div>
                </div>
            }
            @if (wizardSchritt == 2)
            {
                <div class="wizard-inhalt">
                    <h2 class="wizard-titel">🌿 Wilde Monster</h2>
                    <p class="wizard-info">Welche Monster begegnest du in der Wildnis?</p>
                    <div class="wizard-optionen">
                        <div class="wizard-option @(Game.Einstellungen.WildModus == WildMonsterModus.RouteGenau ? "aktiv" : "")"
                             @onclick="() => { Game.Einstellungen.WildModus = WildMonsterModus.RouteGenau; Game.Notify(); }">
                            <div class="wo-icon">📍</div>
                            <div class="wo-text">
                                <strong>Route-genau</strong>
                                <span>Nur die Monster die wirklich auf dieser Route vorkommen (wie im echten Spiel)</span>
                            </div>
                        </div>
                        <div class="wizard-option @(Game.Einstellungen.WildModus == WildMonsterModus.ZufälligNurRegion ? "aktiv" : "")"
                             @onclick="() => { Game.Einstellungen.WildModus = WildMonsterModus.ZufälligNurRegion; Game.Notify(); }">
                            <div class="wo-icon">🗺️</div>
                            <div class="wo-text">
                                <strong>Zufällig (nur diese Region)</strong>
                                <span>Zufällige Monster aus der aktuellen Region – keine Monster aus anderen Regionen.</span>
                            </div>
                        </div>
                        <div class="wizard-option @(Game.Einstellungen.WildModus == WildMonsterModus.Zufällig ? "aktiv" : "")"
                             @onclick="() => { Game.Einstellungen.WildModus = WildMonsterModus.Zufällig; Game.Notify(); }">
                            <div class="wo-icon">🌍</div>
                            <div class="wo-text">
                                <strong>Zufällig (alle Generationen)</strong>
                                <span>Zufällige Monster aus allen Regionen und Generationen – Überraschungen garantiert!</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
            @if (wizardSchritt == 3)
            {
                <div class="wizard-inhalt">
                    <h2 class="wizard-titel">👥 Trainer-Teams</h2>
                    <p class="wizard-info">Welche Monster haben die Trainer?</p>
                    <div class="wizard-optionen">
                        <div class="wizard-option @(Game.Einstellungen.TrainerModus == TrainerMonsterModus.Genau ? "aktiv" : "")"
                             @onclick="() => { Game.Einstellungen.TrainerModus = TrainerMonsterModus.Genau; Game.Notify(); }">
                            <div class="wo-icon">📋</div>
                            <div class="wo-text">
                                <strong>Definierte Teams</strong>
                                <span>Trainer haben ihre echten Teams aus dem Spiel (Rocko hat Onix, Misty hat Starmie, ...)</span>
                            </div>
                        </div>
                        <div class="wizard-option @(Game.Einstellungen.TrainerModus == TrainerMonsterModus.Zufällig ? "aktiv" : "")"
                             @onclick="() => { Game.Einstellungen.TrainerModus = TrainerMonsterModus.Zufällig; Game.Notify(); }">
                            <div class="wo-icon">🎲</div>
                            <div class="wo-text">
                                <strong>Zufälliges Team (nur diese Region)</strong>
                                <span>Zufällige Monster aus der aktuellen Region, Level bleibt gleich.</span>
                            </div>
                        </div>
                        <div class="wizard-option @(Game.Einstellungen.TrainerModus == TrainerMonsterModus.ZufälligMitTypen ? "aktiv" : "")"
                             @onclick="() => { Game.Einstellungen.TrainerModus = TrainerMonsterModus.ZufälligMitTypen; Game.Notify(); }">
                            <div class="wo-icon">🎨</div>
                            <div class="wo-text">
                                <strong>Typen beibehalten (nur diese Region)</strong>
                                <span>Zufällige Monster mit gleichen Typen aus der aktuellen Region.</span>
                            </div>
                        </div>
                        <div class="wizard-option @(Game.Einstellungen.TrainerModus == TrainerMonsterModus.ZufälligAlleRegionen ? "aktiv" : "")"
                             @onclick="() => { Game.Einstellungen.TrainerModus = TrainerMonsterModus.ZufälligAlleRegionen; Game.Notify(); }">
                            <div class="wo-icon">🌍</div>
                            <div class="wo-text">
                                <strong>Zufälliges Team (alle Regionen)</strong>
                                <span>Zufällige Monster aus allen Regionen, Level bleibt gleich.</span>
                            </div>
                        </div>
                        <div class="wizard-option @(Game.Einstellungen.TrainerModus == TrainerMonsterModus.ZufälligMitTypenAlleRegionen ? "aktiv" : "")"
                             @onclick="() => { Game.Einstellungen.TrainerModus = TrainerMonsterModus.ZufälligMitTypenAlleRegionen; Game.Notify(); }">
                            <div class="wo-icon">🎨</div>
                            <div class="wo-text">
                                <strong>Typen beibehalten (alle Regionen)</strong>
                                <span>Zufällige Monster mit gleichen Typen aus allen Regionen.</span>
                            </div>
                        </div>

                    </div>
                </div>
            }
            @if (wizardSchritt == 4)
            {
                <div class="wizard-inhalt wizard-relikte">
                    <h2 class="wizard-titel">💀 Relikte <span class="relikt-sub">(Handicaps)</span></h2>
                    <p class="wizard-info">Aktiviere Handicaps für zusätzliche Zähne am Ende. Zähne = Bonus-Upgrades.</p>
                    <div class="relikt-summary-mini">
                        <span>💀 Aktiv: <strong>@Game.Einstellungen.AktiveRelikte.Count</strong></span>
                        <span>🦷 Zähne: <strong>@Game.Einstellungen.GetGesamtZähne()</strong></span>
                        <span>🎁 Bonus: <strong>@Game.Einstellungen.GetBonusStatUpgrades() Upgrades</strong></span>
                    </div>
                    <div class="wizard-relikt-liste">
                        @foreach (var kategorie in MonsterKampf.Data.ReliktDaten.GetKategorien())
                        {
                            <div class="wizard-relikt-kat">
                                <h4>@kategorie</h4>
                                <div class="wizard-relikt-grid">
                                    @foreach (var relikt in MonsterKampf.Data.ReliktDaten.GetNachKategorie(kategorie))
                                    {
                                        bool aktiv = Game.Einstellungen.HatRelikt(relikt.Typ);
                                        var r = relikt;
                                        <div class="wizard-relikt-card @(aktiv ? "aktiv" : "")" @onclick="() => { Game.Einstellungen.ReliktToggle(r.Typ); Game.Notify(); }">
                                            <span class="wr-emoji">@r.Emoji</span>
                                            <div class="wr-info">
                                                <div class="wr-name">@r.Name</div>
                                                <div class="wr-beschr">@r.Beschreibung</div>
                                            </div>
                                            <div class="wr-zaehne">🦷 @r.Zähne</div>
                                            @if (aktiv) { <div class="wr-check">✓</div> }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Footer: Navigation -->
            <div class="wizard-footer">
                @if (wizardSchritt > 1)
                {
                    <button class="btn-wizard-zurueck" @onclick="WizardZurück">← Zurück</button>
                }
                else
                {
                    <div></div>
                }
                <div class="wizard-footer-mitte">
                    @if (wizardSchritt == 1 && wizardGewählterStarterId == null && !wizardStarterZufälligModus)
                    {
                        <span class="wizard-hinweis">⚠️ Bitte wähle einen Starter oder würfle</span>
                    }
                </div>
                @if (wizardSchritt < 4)
                {
                    <button class="btn-wizard-weiter"
                            disabled="@(wizardSchritt == 1 && wizardGewählterStarterId == null && !wizardStarterZufälligModus)"
                            @onclick="WizardWeiter">
                        Weiter →
                    </button>
                }
                else
                {
                    <button class="btn-wizard-fertig" @onclick="WizardAbschließen">
                        ✅ Spiel starten!
                    </button>
                }
            </div>
        </div>
    </div>
}

@if (marktOffen)
{
    var ortRef2 = Game.AktuellerOrt ?? (ausgewähltOrt != null ? Game.AlleOrte.FirstOrDefault(o => o.Id == ausgewähltOrt.Id) : null);
    if (ortRef2 != null)
    {
    // Im generierten Modus: Items nach Orden filtern; klassisch: MarktAngebot
    int aktuelleOrdenAnzahl = Game.Spieler.Orden.Count;
    var marktItemDefs = Game.IstGenerierteKartenModus
        ? Game.AlleItems.Where(i => i.KaufPreis > 0 && i.MinOrdenFürMarkt != 99 && i.MinOrdenFürMarkt <= aktuelleOrdenAnzahl).ToList()
        : Game.AlleItems.Where(i => ortRef2.MarktAngebot.Any(s => s.Id == i.Id) || (i.KaufPreis > 0 && i.MinOrdenFürMarkt != 99 && i.MinOrdenFürMarkt <= aktuelleOrdenAnzahl)).ToList();
    var marktKategorien = marktItemDefs.Select(i => i.Kategorie).Distinct().OrderBy(k => k).ToList();
    <div class="meldung-overlay" @onclick="MarktSchließen">
        <div class="markt-box markt-box-neu" @onclick:stopPropagation="true">
            <div class="markt-header">
                <h3>🏪 Markt – @ortRef2.Name</h3>
                <span class="markt-geld">💰 @Game.Spieler.Geld Münzen</span>
                <button class="btn-schliessen" @onclick="MarktSchließen">✕</button>
            </div>
            <!-- Kaufen / Verkaufen Tabs -->
            <div class="markt-tabs">
                <button class="markt-tab @(marktModus == "kaufen" ? "aktiv" : "")" @onclick='() => { marktModus = "kaufen"; kaufMeldung = ""; }'>🛒 Kaufen</button>
                <button class="markt-tab @(marktModus == "verkaufen" ? "aktiv" : "")" @onclick='() => { marktModus = "verkaufen"; kaufMeldung = ""; }'>💸 Verkaufen</button>
            </div>
            @if (marktModus == "kaufen")
            {
                <!-- Kategorie-Filter -->
                <div class="markt-kategorien">
                    <button class="markt-kat-btn @(aktiveKategorie == "Alle" ? "aktiv" : "")" @onclick='() => aktiveKategorie = "Alle"'>Alle</button>
                    @foreach (var kat in marktKategorien)
                    {
                        var k = kat;
                        <button class="markt-kat-btn @(aktiveKategorie == k ? "aktiv" : "")" @onclick="() => aktiveKategorie = k">@k</button>
                    }
                </div>
                <div class="markt-items">
                    @foreach (var itemDef in marktItemDefs.Where(i => aktiveKategorie == "Alle" || i.Kategorie == aktiveKategorie))
                    {
                        var it = itemDef;
                        bool kannKaufen = Game.Spieler.Geld >= it.KaufPreis;
                        <div class="markt-item @(!kannKaufen ? "zu-teuer" : "")">
                            <span class="item-emoji">@it.Emoji</span>
                            <div class="item-info">
                                <span class="item-name">@it.Name</span>
                                <span class="item-beschreibung">@it.Beschreibung</span>
                                <span class="item-preis">💰 @it.KaufPreis Münzen</span>
                            </div>
                            <div class="item-kauf">
                                <input type="number" class="mengen-input" min="1" max="99"
                                    value="@(marktMengen.TryGetValue(it.Id, out int mv) ? mv : 1)"
                                    @onchange="e => { if (int.TryParse(e.Value?.ToString(), out int v)) marktMengen[it.Id] = Math.Max(1, Math.Min(99, v)); }" />
                                <button class="btn-kaufen" @onclick="() => ItemKaufenNeu(it)" disabled="@(!kannKaufen)">
                                    @(kannKaufen ? "Kaufen" : "Zu teuer")
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Verkaufen -->
                <div class="markt-items">
                    @if (!Game.Spieler.Inventar.Any(i => { var d = Game.GetItemDef(i.ItemId); return d != null && d.VerkaufPreis > 0; }))
                    {
                        <p class="rucksack-leer">Keine verkaufbaren Items im Rucksack.</p>
                    }
                    else
                    {
                        @foreach (var invItem in Game.Spieler.Inventar.Where(i => { var d = Game.GetItemDef(i.ItemId); return d != null && d.VerkaufPreis > 0; }))
                        {
                            var inv = invItem;
                            var def = Game.GetItemDef(inv.ItemId)!;
                            <div class="markt-item">
                                <span class="item-emoji">@inv.Emoji</span>
                                <div class="item-info">
                                    <span class="item-name">@inv.Name <span class="item-menge-badge">×@inv.Menge</span></span>
                                    <span class="item-beschreibung">Verkaufspreis: 💰 @def.VerkaufPreis Münzen</span>
                                </div>
                                <div class="item-kauf">
                                    <input type="number" class="mengen-input" min="1" max="@inv.Menge"
                                        value="@(marktMengen.TryGetValue(inv.ItemId + "_v", out int vv) ? vv : 1)"
                                        @onchange="@(async e => { if (int.TryParse(e.Value?.ToString(), out int vx)) { var key = inv.ItemId + "_v"; marktMengen[key] = Math.Max(1, Math.Min(inv.Menge, vx)); } })" />
                                    <button class="btn-kaufen btn-verkaufen" @onclick="() => ItemVerkaufenNeu(inv.ItemId)">
                                        Verkaufen
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </div>
            }
            @if (!string.IsNullOrEmpty(kaufMeldung))
            {
                <div class="kauf-meldung">@kaufMeldung</div>
            }
        </div>
    </div>
    }
}

@code {
    private string? ausgewähltOrtId;
    private Ort? ausgewähltOrt;
    private string? meldung;
    // Drag & Drop Team-Reihenfolge
    private int DragIndex = -1;
    private int DropIndex = -1;
    private void DragStart(int idx) { DragIndex = idx; DropIndex = -1; }
    private void DragOver(int idx) { DropIndex = idx; }
    private void DragDrop()
    {
        if (DragIndex < 0 || DropIndex < 0 || DragIndex == DropIndex) { DragIndex = DropIndex = -1; return; }
        var team = Game.Spieler.Team;
        var item = team[DragIndex];
        team.RemoveAt(DragIndex);
        team.Insert(DropIndex, item);
        Game.Spieler.AktivesMonsterIndex = 0;
        Game.Notify();
        DragIndex = DropIndex = -1;
    }
    private bool marktOffen = false;
    private bool rucksackOffen = false;
    private string aktiveKategorie = "Alle";
    private string kaufMeldung = "";
    private string marktModus = "kaufen"; // "kaufen" oder "verkaufen"
    private Dictionary<string, int> marktMengen = new();
    private string aktiveRucksackTab = "Alle"; // Rucksack-Registerkarte
    private string? ausgerüstetMonsterFürItem = null; // Monster-ID für Ausrüstungs-Dialog
    private string? ausrüstItemId = null;
    // Stein-Anwenden
    private string? steinItemId = null;
    private string steinItemName = "";
    private string steinItemEmoji = "";
    private string steinItemTrigger = "";
    // Vollkarte
    private bool vollkarteOffen = false;
    private string? vollkarteRegionId = null;
    private string vollkarteName = "";
    private bool vollkarteAlleFreischalten = false; // true = Karte zeigt alle Orte (Abenteuer-Karte)
    // Seed-Code Kopieren
    private bool seedKopiertMeldung = false;

    // NPC Dialog
    private string? npcDialog;
    private string? npcDialogName;
    private string? npcDialogEmoji;
    private string? npcGeschenktItem;
    private string? npcGeschenktItemEmoji;
    private bool npcIstProfessor = false;

    // Einrichtungs-Wizard
    private bool wizardAktiv = false;
    private int wizardSchritt = 1; // 1=Starter, 2=WildeMonster, 3=TrainerTeams, 4=Relikte
    private List<MonsterData> wizardStarterOptionen = new();
    private string? wizardGewählterStarterId = null;
    private bool wizardStarterZufälligModus = false;

    protected override void OnInitialized()
    {
        Game.OnChange += StateHasChanged;
        ausgewähltOrtId = null;
        ausgewähltOrt = null;
    }

    public void Dispose() => Game.OnChange -= StateHasChanged;

    private void OrtAuswählen(Ort ort)
    {
        ausgewähltOrtId = ort.Id;
        ausgewähltOrt = ort;
    }

    private void MinimapKlick(Ort ort, int row, int col)
    {
        if (ort.Id == Game.Spieler.AktuellerOrt)
        {
            ausgewähltOrtId = ort.Id;
            ausgewähltOrt = ort;
            return;
        }
        // Richtung aus Grid-Position ableiten (3x3: Mitte = [1,1])
        string? richtung = (row, col) switch
        {
            (0, 1) => "Nord",
            (2, 1) => "Sued",
            (1, 0) => "West",
            (1, 2) => "Ost",
            (0, 0) => "NW",
            (0, 2) => "NO",
            (2, 0) => "SW",
            (2, 2) => "SO",
            _      => null
        };
        var fehler = Game.OrtBetreten(ort.Id, richtung);
        if (fehler != null)
        {
            meldung = fehler;
            return;
        }
        ausgewähltOrtId = null;
        ausgewähltOrt = null;
    }

    private void ZumOrtReisen()
    {
        if (ausgewähltOrt == null) return;
        // Richtung aus Verbindungen des aktuellen Ortes ableiten
        var aktOrt = Game.AktuellerOrt;
        string? richtung = null;
        if (aktOrt != null)
        {
            if (aktOrt.Nord == ausgewähltOrt.Id) richtung = "Nord";
            else if (aktOrt.Sued == ausgewähltOrt.Id) richtung = "Sued";
            else if (aktOrt.Ost == ausgewähltOrt.Id) richtung = "Ost";
            else if (aktOrt.West == ausgewähltOrt.Id) richtung = "West";
            else if (aktOrt.Teleport == ausgewähltOrt.Id) richtung = "Teleport";
            else if (aktOrt.Untergrund == ausgewähltOrt.Id) richtung = "Untergrund";
        }
        var fehler = Game.OrtBetreten(ausgewähltOrt.Id, richtung);
        if (fehler != null)
        {
            meldung = fehler;
            return;
        }
        ausgewähltOrtId = null;
        ausgewähltOrt = null;
    }

    private void ImGrasErkunden()
    {
        var ortRef = ausgewähltOrt != null
            ? Game.AlleOrte.FirstOrDefault(o => o.Id == ausgewähltOrt.Id)
            : Game.AktuellerOrt;
        if (ortRef == null) return;
        var wild = Game.ZufälligesWildMonster(ortRef);
        if (wild != null)
            Game.WildkampfStarten(wild);
        else
            meldung = "Keine wilden Monster in diesem Gebiet.";
    }

    private void NpcSprechen(GesprächsNPC npc)
    {
        var (dialog, itemName, itemEmoji) = Game.NpcSprechen(npc);
        npcDialog = dialog;
        npcDialogName = npc.Name;
        npcDialogEmoji = npc.Emoji;
        npcGeschenktItem = itemName;
        npcGeschenktItemEmoji = itemEmoji;
        npcIstProfessor = npc.IstProfessor;
    }

    private void NpcDialogSchließen()
    {
        bool warProfessor = npcIstProfessor;
        bool wizardNochNichtGemacht = !Game.WizardAbgeschlossen;
        npcDialog = null;
        npcGeschenktItem = null;
        npcGeschenktItemEmoji = null;
        npcIstProfessor = false;
        // Wenn Professor und Wizard noch nicht abgeschlossen → Wizard starten
        if (warProfessor && wizardNochNichtGemacht && Game.IstGenerierteKartenModus)
            WizardStarten();
    }

    private void WizardStarten()
    {
        wizardSchritt = 1;
        wizardGewählterStarterId = null;
        wizardStarterZufälligModus = false;
        // Immer die echten Kanto-Starter (Glumanda, Shiggy, Bisasam) anzeigen
        wizardStarterOptionen = Game.GetStarterOptionen();
        wizardAktiv = true;
    }

    private void WizardWeiter()
    {
        if (wizardSchritt < 4)
            wizardSchritt++;
        else
            WizardAbschließen();
    }

    private void WizardZurück()
    {
        if (wizardSchritt > 1) wizardSchritt--;
    }

    private void WizardAbschließen()
    {
        if (wizardGewählterStarterId != null)
            Game.StarterWählenImWizard(wizardGewählterStarterId);
        Game.WizardAbschliessen();
        wizardAktiv = false;
    }

    private void WizardStarterWählen(string id)
    {
        wizardGewählterStarterId = id;
        wizardStarterZufälligModus = false;
    }

    private void WizardStarterZufälligLaden()
    {
        wizardStarterOptionen = Game.GetZufälligeStarterOptionen();
        wizardGewählterStarterId = null;
        wizardStarterZufälligModus = true;
    }

    private void WizardStarterZufälligRegion()
    {
        var regionId = (Game.Spieler.AktuellerOrt?.Length >= 3)
            ? Game.Spieler.AktuellerOrt[..3] : "KAN";
        wizardStarterOptionen = Game.GetZufälligeStarterNurRegion(regionId);
        wizardGewählterStarterId = null;
        wizardStarterZufälligModus = true;
    }

    private void WizardStarterZufälligAlle()
    {
        wizardStarterOptionen = Game.GetZufälligeStarterOptionen();
        wizardGewählterStarterId = null;
        wizardStarterZufälligModus = true;
    }

    private void WizardStarterEchteStarter()
    {
        wizardStarterOptionen = Game.GetZufälligeEchteStarter();
        wizardGewählterStarterId = null;
        wizardStarterZufälligModus = true;
    }

    private void RucksackOeffnen() => rucksackOffen = true;
    private void RucksackSchließen() => rucksackOffen = false;

    private void RucksackItemKlick(InventarItem item)
    {
        bool istKarteItem = item.ItemId.StartsWith("ITEM-KARTE", StringComparison.OrdinalIgnoreCase)
            || item.Name.EndsWith("-Karte", StringComparison.OrdinalIgnoreCase)
            || item.Name.EndsWith("karte", StringComparison.OrdinalIgnoreCase);
        if (!istKarteItem) return;

        // Abenteuer-Karte (generierte Karte) → zeigt ALLE Orte der generierten Karte
        if (item.ItemId == "ITEM-KARTE-GEN" && Game.IstGenerierteKartenModus)
        {
            vollkarteName = "Abenteuer-Karte";
            vollkarteRegionId = null; // null = alle Orte
            vollkarteAlleFreischalten = true; // Karte zeigt alle Orte (kein Fog-of-War)
            rucksackOffen = false;
            vollkarteOffen = true;
            return;
        }

        // Region aus Item-Name ableiten (z.B. "Kanto-Karte" → "KAN")
        vollkarteName = item.Name;
        vollkarteAlleFreischalten = false;
        vollkarteRegionId = item.Name switch
        {
            var n when n.Contains("Kanto",  StringComparison.OrdinalIgnoreCase) => "KAN",
            var n when n.Contains("Johto",  StringComparison.OrdinalIgnoreCase) => "JOH",
            var n when n.Contains("Hoenn",  StringComparison.OrdinalIgnoreCase) => "HOE",
            var n when n.Contains("Sinnoh", StringComparison.OrdinalIgnoreCase) => "SIN",
            var n when n.Contains("Unova",  StringComparison.OrdinalIgnoreCase) => "UNO",
            var n when n.Contains("Kalos",  StringComparison.OrdinalIgnoreCase) => "KAL",
            var n when n.Contains("Alola",  StringComparison.OrdinalIgnoreCase) => "ALO",
            var n when n.Contains("Galar",  StringComparison.OrdinalIgnoreCase) => "GAL",
            var n when n.Contains("Paldea", StringComparison.OrdinalIgnoreCase) => "PAL",
            _ => null // alle Orte anzeigen
        };
        rucksackOffen = false;
        vollkarteOffen = true;
    }

    private void VollkarteSchliessen() { vollkarteOffen = false; vollkarteAlleFreischalten = false; }

    private bool neuGenBestaetigung = false;

    private void NeuGenerierenBestaetigen()
    {
        // Direkt neu generieren (gleiche Regionen, neuer Seed)
        Game.NeuGenerieren();
    }

    private async Task SeedKodierenKopieren()
    {
        if (Game.AktuelleGenerierteKarte == null) return;
        var code = KartenGenerator.ExportiereKartenCode(Game.AktuelleGenerierteKarte);
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
        seedKopiertMeldung = true;
        StateHasChanged();
        await Task.Delay(2000);
        seedKopiertMeldung = false;
        StateHasChanged();
    }

    private void VollkarteOrtWählen(Ort ort)
    {
        vollkarteOffen = false;
        ausgewähltOrtId = ort.Id;
        ausgewähltOrt = ort;
    }

    private void TrainerKämpfen(TrainerKampf trainer) => Game.TrainerKampfStarten(trainer);
    private void ArenaKämpfen(Ort ort) => Game.ArenaKampfStarten(ort);
    private void MeldungSchließen() => meldung = null;
    private void MonsterZentrumHeilen() => meldung = Game.MonsterZentrumHeilen();

    private void MarktOeffnen()
    {
        marktOffen = true;
        aktiveKategorie = "Alle";
        kaufMeldung = "";
    }

    private void MarktSchließen()
    {
        marktOffen = false;
        kaufMeldung = "";
    }

    private async Task SpielstandSpeichern()
    {
        await Game.SpielstandSpeichern();
        meldung = "💾 Spielstand gespeichert!";
    }

    private async Task SpielstandSpeichernAktuell()
    {
        await Game.AktuellenSpielstandSpeichern();
        meldung = Game.IstEigeneMapModus
            ? "💾 Eigener Map-Spielstand gespeichert!"
            : "💾 Spielstand gespeichert!";
    }

    private async Task SpielstandLaden()
    {
        await Game.SpielstandLaden();
        meldung = "📂 Spielstand geladen!";
    }

    private async Task ZumNormalenSpielstandWechseln()
    {
        await Game.ZumNormalenSpielstandWechseln();
    }

    private async Task ItemKaufen(ShopItem item)
    {
        kaufMeldung = Game.ItemKaufen(item);
        await Task.Delay(2500);
        if (kaufMeldung.StartsWith("✅"))
            kaufMeldung = "";
    }

    private async Task ItemKaufenNeu(ItemDef item)
    {
        int menge = marktMengen.TryGetValue(item.Id, out int m) ? m : 1;
        kaufMeldung = Game.ItemKaufen(item, menge);
        await Task.Delay(2500);
        if (kaufMeldung.StartsWith("✅"))
            kaufMeldung = "";
    }

    private async Task ItemVerkaufenNeu(string itemId)
    {
        int menge = marktMengen.TryGetValue(itemId + "_v", out int m) ? m : 1;
        kaufMeldung = Game.ItemVerkaufen(itemId, menge);
        await Task.Delay(2500);
        if (kaufMeldung.StartsWith("✅"))
            kaufMeldung = "";
    }

    private async Task RucksackItemAnwenden(InventarItem item)
    {
        var def = Game.GetItemDef(item.ItemId);
        if (def == null) return;
        // Ausrüstungsitems → Monster auswählen
        if (def.Effekt.Typ == "Ausrüstung")
        {
            ausrüstItemId = item.ItemId;
            return;
        }
        // Entwicklungssteine → Monster-Auswahl anzeigen
        if (def.Effekt.Typ == "Entwicklungsstein")
        {
            steinItemId = item.ItemId;
            steinItemName = def.Name;
            steinItemEmoji = def.Emoji;
            steinItemTrigger = def.Effekt.StatusTyp ?? "";
            return;
        }
        // Heilung/Status: auf erstes krankes Monster anwenden
        var ziel = Game.Spieler.Team.FirstOrDefault(m => m.AktuelleKp < m.MaxKp || (m.Status != null && m.Status != "none"));
        if (ziel == null) ziel = Game.Spieler.Team.FirstOrDefault();
        if (ziel == null) return;
        meldung = Game.ItemAnwenden(item.ItemId, ziel);
        await Task.Delay(100);
    }

    private void SteinAufMonsterAnwenden(MonsterInstanz mon)
    {
        if (steinItemId == null) return;
        meldung = Game.ItemAnwenden(steinItemId, mon);
        steinItemId = null;
    }

    private void ItemAusrüsten(string monsterKey)
    {
        if (ausrüstItemId == null) return;
        var parts = monsterKey.Split('_');
        string speziesId = string.Join("_", parts[..^1]);
        int level = int.TryParse(parts[^1], out int lv) ? lv : -1;
        var mon = Game.Spieler.Team.FirstOrDefault(m => m.SpeziesId == speziesId && m.Level == level)
                  ?? Game.Spieler.Team.FirstOrDefault(m => m.SpeziesId == speziesId);
        if (mon != null) meldung = Game.ItemAusrüsten(mon, ausrüstItemId);
        ausrüstItemId = null;
    }
    private void ItemAusrüstenMon(MonsterInstanz mon)
    {
        if (ausrüstItemId == null) return;
        meldung = Game.ItemAusrüsten(mon, ausrüstItemId);
        ausrüstItemId = null;
    }

    private string OrtIcon(Ort ort) => ort.Typ switch
    {
        "stadt"  => ort.Arena != null && !ort.IstRivaleStadt ? "🏆" : "🏙️",
        "route"  => "🌿",
        "hoehle" => "⛰️",
        "wald"   => "🌲",
        _        => "📍"
    };

    private string RegionName(string ortId) => ortId.Length >= 3 ? ortId[..3] switch
    {
        "KAN" => "Kanto",
        "JOH" => "Johto",
        "HOE" => "Hoenn",
        "SIN" => "Sinnoh",
        "UNG" => "Unova",
        "KAL" => "Kalos",
        "ALO" => "Alola",
        "GAL" => "Galar",
        "PAL" => "Paldea",
        _     => "Unbekannt"
    } : "Unbekannt";

    private string GetTypEmoji(string typ) =>
        TypeChart.TypEmojis.GetValueOrDefault(typ, "❓");

    private string KpFarbe(MonsterInstanz mon)
    {
        float pct = mon.MaxKp > 0 ? (float)mon.AktuelleKp / mon.MaxKp : 0;
        return pct > 0.5f ? "kp-gruen" : pct > 0.25f ? "kp-gelb" : "kp-rot";
    }
    // ── Generierte Karte: Fog-of-War Helfer ─────────────────────────────────
    private bool GenOrtZugänglich(string ortId)
    {
        if (!Game.IstGenerierteKartenModus) return true;
        return Game.AktuelleGenerierteKarte?.FreigeschalteteOrte.Contains(ortId) ?? false;
    }
    private bool GenOrtImNebel(string ortId)
    {
        if (!Game.IstGenerierteKartenModus) return false;
        return !(Game.AktuelleGenerierteKarte?.FreigeschalteteOrte.Contains(ortId) ?? false);
    }
    private void ProfessorHeilen()
    {
        foreach (var mon in Game.Spieler.Team)
        {
            mon.AktuelleKp = mon.MaxKp;
            mon.Status = "none";
            mon.StatusZähler = 0;
            foreach (var atk in mon.Attacken)
                atk.AktuelleAp = atk.MaxAp;
        }
        meldung = "Alle Monster wurden geheilt!";
        Game.Notify();
    }
}
