@inject GameService Game
@inject IJSRuntime JS
@implements IDisposable
@using MonsterKampf.Services

<div class="weltkarte-screen">
    <!-- Linke Sidebar: Spieler-Info -->
    <div class="sidebar">
        <div class="spieler-info">
            <h3>🎮 @Game.Spieler.Name</h3>
            <p class="geld">💰 @Game.Spieler.Geld Münzen</p>
            <div class="orden-liste">
                @foreach (var orden in Game.Spieler.Orden)
                {
                    <span class="orden-badge" title="@orden">🏅</span>
                }
                @if (!Game.Spieler.Orden.Any())
                {
                    <span class="keine-orden">Noch keine Orden</span>
                }
            </div>
        </div>

        <div class="team-liste">
            <h4>Mein Team</h4>
            @foreach (var mon in Game.Spieler.Team)
            {
                <div class="team-eintrag @(mon.IstOhnmächtig ? "ohnmächtig" : "")">
                    <span class="team-emoji">@GetTypEmoji(mon.Typen.FirstOrDefault() ?? "")</span>
                    <div class="team-info">
                        <span class="team-name">@mon.Name</span>
                        <span class="team-level">Lv.@mon.Level</span>
                    </div>
                    <div class="team-kp-balken">
                        <div class="kp-fill @KpFarbe(mon)"
                             style="width: @(mon.MaxKp > 0 ? (mon.AktuelleKp * 100 / mon.MaxKp) : 0)%"></div>
                    </div>
                    <span class="team-kp-text">@mon.AktuelleKp/@mon.MaxKp</span>
                </div>
            }
        </div>

        <!-- Rucksack-Button -->
        @if (Game.Spieler.Inventar.Any())
        {
            <button class="btn-rucksack" @onclick="RucksackOeffnen">
                🎒 Rucksack (@Game.Spieler.Inventar.Sum(i => i.Menge))
            </button>
        }

        @if (Game.IstEigeneMapModus)
        {
            <div class="eigene-map-modus-badge">
                🗺️ Eigene Map
                <span class="eigene-map-kein-bonus-klein">(keine Boni)</span>
            </div>
        }

        <div class="speichern-buttons">
            <button class="btn-speichern" @onclick="SpielstandSpeichernAktuell">💾 Speichern</button>
            @if (!Game.IstEigeneMapModus)
            {
                <button class="btn-laden" @onclick="SpielstandLaden">📂 Laden</button>
            }
        </div>

        @if (Game.IstGenerierteKartenModus)
        {
            <button class="btn-generieren btn-neu-generieren" @onclick="NeuGenerierenBestaetigen">
                🎲 Reload / neu generieren
            </button>
        }
        @if (Game.IstEigeneMapModus)
        {
            <button class="btn-hauptmenu btn-eigene-map-verlassen" @onclick="ZumNormalenSpielstandWechseln">
                ← Gen 1–8 Spielstand
            </button>
        }
        else
        {
            <button class="btn-hauptmenu" @onclick="Game.ZuHauptmenü">🏠 Hauptmenü</button>
        }
        <button class="btn-pokedex-klein" @onclick="Game.ZuPokédex">📖 Pokédex</button>
        <button class="btn-editor-klein" @onclick="Game.ZuMapEditor">🗺️ Map-Editor</button>
        <button class="btn-monster-editor-klein" @onclick="Game.ZuMonsterEditor">🐾 Monster-Editor</button>
        <button class="btn-admin-klein" @onclick="Game.ZuAdminPanel">🔧 Admin</button>
    </div>

    <!-- Hauptbereich: Karte + Ort-Details -->
    <div class="karte-bereich">
        <h2 class="karte-titel">
            @if (Game.IstGenerierteKartenModus)
            {
                <span>🗺️ Generierte Karte</span>
                @if (Game.AktuelleGenerierteKarte != null)
                {
                    <button class="btn-seed-kopieren" title="Karten-Code kopieren"
                            @onclick="SeedKodierenKopieren">
                        🔑 @(Game.AktuelleGenerierteKarte.SeedCode.Length > 8 ? Game.AktuelleGenerierteKarte.SeedCode[..8] + "..." : Game.AktuelleGenerierteKarte.SeedCode)
                        <span class="seed-kopier-icon">@(seedKopiertMeldung ? "✓" : "📋")</span>
                    </button>
                }
            }
            else
            {
                <span>🗺️ Weltkarte</span>
            }
        </h2>

        <!-- Minimap + Ort-Details nebeneinander -->
        <div class="karte-haupt-layout">

        <!-- 3x3 Minimap -->
        <div class="minimap-container">
        @{
            var aktOrt = Game.AktuellerOrt;
            Ort? GetOrt(string? id) => id == null ? null : Game.AlleOrte.FirstOrDefault(o => o.Id == id);
            var nord = GetOrt(aktOrt?.Nord);
            var süd  = GetOrt(aktOrt?.Sued);
            var ost  = GetOrt(aktOrt?.Ost);
            var west = GetOrt(aktOrt?.West);
            // Nur die 4 Hauptrichtungen anzeigen (keine Ecken NW/NO/SW/SO)
            var felder = new Ort?[3, 3]
            {
                { null, nord,   null },
                { west, aktOrt, ost  },
                { null, süd,   null }
            };
        }
        @if (aktOrt != null)
        {
            <div class="minimap-region-label">
                <span class="minimap-region-icon">🌍</span>
                <span>@RegionName(aktOrt.Id)</span>
                <span class="minimap-ort-aktuell">📍 @aktOrt.Name</span>
            </div>
            <div class="minimap-grid">
                @for (int row = 0; row < 3; row++)
                {
                    @for (int col = 0; col < 3; col++)
                    {
                        var feld = felder[row, col];
                        bool istZentrum = row == 1 && col == 1;
                        bool istAusgewählt = feld?.Id == ausgewähltOrtId;
                        if (feld != null)
                        {
                            var f = feld;
                            <div class="minimap-zelle @(istZentrum ? "zentrum" : "") @(istAusgewählt ? "ausgewaehlt" : "")"
                                 style="background: @WeltData.OrtFarben.GetValueOrDefault(f.Farbe, "#374151")"
                                 draggable="false"
                                 @ondragstart:preventDefault
                                 @onclick="() => MinimapKlick(f, row, col)">
                                <span class="minimap-icon">@OrtIcon(f)</span>
                                <span class="minimap-name">@f.Name</span>
                                @if (f.Arena != null && Game.Spieler.Orden.Contains(f.Arena.OrdenName))
                                {
                                    <span class="minimap-orden">✓</span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="minimap-zelle leer"></div>
                        }
                    }
                }
            </div>
        }
        else
        {
            <div class="minimap-leer">📍 Kein Startort gefunden</div>
        }
        </div>

        <!-- Ort-Details (rechts daneben) -->
        <div class="location-info">
        @{
            var anzeigeOrt = ausgewähltOrt ?? aktOrt;
        }
        @if (anzeigeOrt != null)
        {
            bool istHier2 = anzeigeOrt.Id == Game.Spieler.AktuellerOrt;
            var ortRef3 = Game.AlleOrte.First(o => o.Id == anzeigeOrt.Id);
            // Zugangsprüfung: neue einfache Methode
            string? zugangsFehler2 = istHier2 ? null : Game.ZugangPrüfen(ortRef3.Id);
            <div class="ort-details">
                <div class="ort-details-header">
                    <h3>@anzeigeOrt.Name</h3>
                    <span class="ort-typ-badge">@(char.ToUpper(anzeigeOrt.Typ[0]) + anzeigeOrt.Typ[1..])</span>
                </div>
                @if (!string.IsNullOrEmpty(anzeigeOrt.Beschreibung))
                {
                    <p class="ort-beschreibung">@anzeigeOrt.Beschreibung</p>
                }
                <div class="ort-aktionen">
                    @if (!istHier2)
                    {
                        @if (zugangsFehler2 != null)
                        {
                            <div class="ort-gesperrt-hinweis">
                                <span class="gesperrt-icon">⛔</span>
                                <span>@zugangsFehler2.Replace("⛔ ", "")</span>
                            </div>
                            <button class="btn-reisen btn-reisen-gesperrt" disabled>
                                🔒 Zugang gesperrt
                            </button>
                        }
                        else
                        {
                            <button class="btn-reisen" @onclick="ZumOrtReisen">
                                🚶 Nach @anzeigeOrt.Name reisen
                            </button>
                        }
                    }
                    else
                    {
                        <span class="aktueller-ort-label">📍 Du bist hier</span>

                        <!-- Wilde Monster -->
                        @if (ortRef3.WildMonster.Any())
                        {
                            <div class="ort-sektion">
                                <div class="ort-sektion-header">🌿 Wilde Monster</div>
                                <div class="wild-monster-liste">
                                    @foreach (var wm in ortRef3.WildMonster)
                                    {
                                        var monData = Game.AlleMonster.FirstOrDefault(m => m.Id == wm.MonsterId);
                                        if (monData != null)
                                        {
                                            <span class="wild-monster-chip">
                                                @GetTypEmoji(monData.Typen.FirstOrDefault() ?? "") @monData.Name
                                                <span class="wild-level">Lv.@wm.MinLevel–@wm.MaxLevel</span>
                                            </span>
                                        }
                                    }
                                </div>
                                <button class="btn-erkunden" @onclick="ImGrasErkunden">
                                    🌿 Im Gras erkunden
                                </button>
                            </div>
                        }

                        <!-- NPCs (Sensei, etc.) -->
                        @if (ortRef3.NPCs.Any())
                        {
                            <div class="ort-sektion">
                                <div class="ort-sektion-header">💬 Personen</div>
                                @foreach (var npc in ortRef3.NPCs)
                                {
                                    var n = npc;
                                    bool bereitsGesprochen = Game.Spieler.BesproacheneNPCs.Contains(n.Id);
                                    <button class="btn-npc @(bereitsGesprochen ? "gesprochen" : "")"
                                            @onclick="() => NpcSprechen(n)">
                                        @n.Emoji @n.Name
                                        @if (!bereitsGesprochen && n.GibtItemId != null)
                                        {
                                            <span class="npc-item-hint">🎁</span>
                                        }
                                    </button>
                                }
                            </div>
                        }

                        <!-- Kämpfe (Trainer + Arena) -->
                        @if (ortRef3.Trainer.Any(t => !Game.Spieler.BesiegteTrainer.Contains(t.Id) && t.Klasse != "Arena" && t.Klasse != "Arena/Boss") || ortRef3.Arena != null)
                        {
                            <div class="ort-sektion">
                                <div class="ort-sektion-header">⚔️ Kämpfe</div>
                                @foreach (var trainer in ortRef3.Trainer.Where(t => !Game.Spieler.BesiegteTrainer.Contains(t.Id) && t.Klasse != "Arena" && t.Klasse != "Arena/Boss"))
                                {
                                    var t2 = trainer;
                                    <button class="btn-trainer" @onclick="() => TrainerKämpfen(t2)">
                                        🧑 @t2.Klasse @t2.Name
                                    </button>
                                }
                                @if (ortRef3.Arena != null)
                                {
                                    bool bereitsGewonnen = Game.Spieler.Orden.Contains(ortRef3.Arena!.OrdenName);
                                    <button class="btn-arena @(bereitsGewonnen ? "gewonnen" : "")"
                                            @onclick="() => ArenaKämpfen(ortRef3)"
                                            disabled="@bereitsGewonnen">
                                        🏆 @(bereitsGewonnen ? $"✓ {ortRef3.Arena!.OrdenName}" : $"Arena: {ortRef3.Arena!.Leiter}")
                                    </button>
                                }
                            </div>
                        }

                        <!-- Einrichtungen -->
                        @if (ortRef3.HatMonsterCenter || ortRef3.HatMarkt || ortRef3.MarktAngebot.Any())
                        {
                            <div class="ort-sektion">
                                <div class="ort-sektion-header">🏢 Einrichtungen</div>
                                @if (ortRef3.HatMonsterCenter)
                                {
                                    <button class="btn-center" @onclick="MonsterZentrumHeilen">
                                        🏥 Monster Center
                                    </button>
                                }
                                @if (ortRef3.HatMarkt || ortRef3.MarktAngebot.Any())
                                {
                                    <button class="btn-markt" @onclick="MarktOeffnen">
                                        🏪 Markt (@ortRef3.MarktAngebot.Count Items)
                                    </button>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        }
        </div><!-- /location-info -->
        </div><!-- /karte-haupt-layout -->
    </div>
</div>

<!-- NPC Gesprächs-Dialog -->
@if (npcDialog != null)
{
    <div class="meldung-overlay" @onclick="NpcDialogSchließen">
        <div class="npc-dialog-box" @onclick:stopPropagation="true">
            <div class="npc-dialog-header">
                <span class="npc-dialog-emoji">@npcDialogEmoji</span>
                <span class="npc-dialog-name">@npcDialogName</span>
            </div>
            <p class="npc-dialog-text">@npcDialog</p>
            @if (npcGeschenktItem != null)
            {
                <div class="npc-item-erhalten">
                    <span>🎁 Du hast erhalten:</span>
                    <strong>@npcGeschenktItemEmoji @npcGeschenktItem</strong>
                </div>
            }
            <button class="btn-ok" @onclick="NpcDialogSchließen">OK</button>
        </div>
    </div>
}

@if (meldung != null)
{
    <div class="meldung-overlay" @onclick="MeldungSchließen">
        <div class="meldung-box">
            <p>@meldung</p>
            <button class="btn-ok" @onclick="MeldungSchließen">OK</button>
        </div>
    </div>
}

<!-- Rucksack-Overlay -->
@if (rucksackOffen)
{
    <div class="meldung-overlay" @onclick="RucksackSchließen">
        <div class="rucksack-box" @onclick:stopPropagation="true">
            <div class="markt-header">
                <h3>🎒 Rucksack</h3>
                <button class="btn-schliessen" @onclick="RucksackSchließen">✕</button>
            </div>
            <div class="rucksack-items">
                @if (!Game.Spieler.Inventar.Any())
                {
                    <p class="rucksack-leer">Dein Rucksack ist leer.</p>
                }
                else
                {
                    @foreach (var item in Game.Spieler.Inventar)
                    {
                        var itm = item;
                        bool istKarteItem = itm.ItemId.StartsWith("ITEM-KARTE", StringComparison.OrdinalIgnoreCase)
                            || itm.Name.EndsWith("-Karte", StringComparison.OrdinalIgnoreCase)
                            || itm.Name.EndsWith("karte", StringComparison.OrdinalIgnoreCase);
                        <div class="rucksack-item @(istKarteItem ? "karte-item" : "")" @onclick="() => RucksackItemKlick(itm)">
                            <span class="item-emoji">@itm.Emoji</span>
                            <div class="item-info">
                                <span class="item-name">@itm.Name</span>
                                <span class="item-menge">×@itm.Menge</span>
                            </div>
                            @if (istKarteItem)
                            {
                                <span class="karte-item-hinweis">🗺️ Anzeigen</span>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

@if (vollkarteOffen)
{
    var vollkarteRegion = vollkarteRegionId;
    var vollkarteOrte = string.IsNullOrEmpty(vollkarteRegion)
        ? Game.AlleOrte
        : Game.AlleOrte.Where(o => o.Id.StartsWith(vollkarteRegion + "-", StringComparison.OrdinalIgnoreCase)).ToList();
    <div class="meldung-overlay" @onclick="VollkarteSchliessen">
        <div class="vollkarte-box" @onclick:stopPropagation="true">
            <div class="markt-header">
                <h3>🗺️ @vollkarteName</h3>
                <span class="vollkarte-anzahl">@vollkarteOrte.Count Orte</span>
                <button class="btn-schliessen" @onclick="VollkarteSchliessen">✕</button>
            </div>
            <div class="vollkarte-inhalt">
                <!-- Legende -->
                <div class="vollkarte-legende">
                    <span class="vk-leg"><span class="vk-dot" style="background:#6366f1"></span>Stadt</span>
                    <span class="vk-leg"><span class="vk-dot" style="background:#22c55e"></span>Route</span>
                    <span class="vk-leg"><span class="vk-dot" style="background:#78716c"></span>Höhle</span>
                    <span class="vk-leg"><span class="vk-dot" style="background:#16a34a"></span>Wald</span>
                    <span class="vk-leg"><span class="vk-dot" style="background:#f59e0b"></span>Arena</span>
                </div>
                <!-- Ortsliste -->
                <div class="vollkarte-liste">
                    @foreach (var ort in vollkarteOrte)
                    {
                        var o = ort;
                        bool istHier = o.Id == Game.Spieler.AktuellerOrt;
                        bool hatOrden = o.Arena != null && Game.Spieler.Orden.Contains(o.Arena.OrdenName);
                        string farbe = o.Arena != null ? "#f59e0b"
                            : o.Typ == "stadt" ? "#6366f1"
                            : o.Typ == "route" ? "#22c55e"
                            : o.Typ == "hoehle" ? "#78716c"
                            : o.Typ == "wald" ? "#16a34a"
                            : "#4b5563";
                        <div class="vollkarte-ort @(istHier ? "hier" : "")" style="border-left: 3px solid @farbe"
                             @onclick="() => VollkarteOrtWählen(o)">
                            <span class="vk-icon">@OrtIcon(o)</span>
                            <div class="vk-info">
                                <span class="vk-name">@o.Name</span>
                                @if (o.Arena != null)
                                {
                                    <span class="vk-arena">🏅 @o.Arena.OrdenName @(hatOrden ? "✓" : "")</span>
                                }
                            </div>
                            @if (istHier) { <span class="vk-hier">📍 Du bist hier</span> }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
@if (marktOffen)
{
    var ortRef2 = Game.AktuellerOrt ?? (ausgewähltOrt != null ? Game.AlleOrte.FirstOrDefault(o => o.Id == ausgewähltOrt.Id) : null);
    if (ortRef2 != null)
    {
    <div class="meldung-overlay" @onclick="MarktSchließen">
        <div class="markt-box" @onclick:stopPropagation="true">
            <div class="markt-header">
                <h3>🏪 Markt – @ortRef2.Name</h3>
                <span class="markt-geld">💰 @Game.Spieler.Geld Münzen</span>
                <button class="btn-schliessen" @onclick="MarktSchließen">✕</button>
            </div>
            <div class="markt-kategorien">
                @foreach (var kat in ortRef2.MarktAngebot.Select(i => i.Kategorie).Distinct())
                {
                    <button class="markt-kat-btn @(aktiveKategorie == kat ? "aktiv" : "")" @onclick="() => aktiveKategorie = kat">@kat</button>
                }
                <button class="markt-kat-btn @(aktiveKategorie == "Alle" ? "aktiv" : "")" @onclick='() => aktiveKategorie = "Alle"'>Alle</button>
            </div>
            <div class="markt-items">
                @foreach (var item in ortRef2.MarktAngebot.Where(i => aktiveKategorie == "Alle" || i.Kategorie == aktiveKategorie))
                {
                    var it = item;
                    bool kannKaufen = Game.Spieler.Geld >= it.Preis;
                    <div class="markt-item @(!kannKaufen ? "zu-teuer" : "")">
                        <span class="item-emoji">@it.Emoji</span>
                        <div class="item-info">
                            <span class="item-name">@it.Name</span>
                            <span class="item-beschreibung">@it.Beschreibung</span>
                        </div>
                        <div class="item-kauf">
                            <span class="item-preis">💰 @it.Preis</span>
                            <button class="btn-kaufen" @onclick="() => ItemKaufen(it)" disabled="@(!kannKaufen)">
                                @(kannKaufen ? "Kaufen" : "Zu teuer")
                            </button>
                        </div>
                    </div>
                }
            </div>
            @if (!string.IsNullOrEmpty(kaufMeldung))
            {
                <div class="kauf-meldung">@kaufMeldung</div>
            }
        </div>
    </div>
    }
}

@code {
    private string? ausgewähltOrtId;
    private Ort? ausgewähltOrt;
    private string? meldung;
    private bool marktOffen = false;
    private bool rucksackOffen = false;
    private string aktiveKategorie = "Alle";
    private string kaufMeldung = "";
    // Vollkarte
    private bool vollkarteOffen = false;
    private string? vollkarteRegionId = null;
    private string vollkarteName = "";
    // Seed-Code Kopieren
    private bool seedKopiertMeldung = false;

    // NPC Dialog
    private string? npcDialog;
    private string? npcDialogName;
    private string? npcDialogEmoji;
    private string? npcGeschenktItem;
    private string? npcGeschenktItemEmoji;

    protected override void OnInitialized()
    {
        Game.OnChange += StateHasChanged;
        ausgewähltOrtId = null;
        ausgewähltOrt = null;
    }

    public void Dispose() => Game.OnChange -= StateHasChanged;

    private void OrtAuswählen(Ort ort)
    {
        ausgewähltOrtId = ort.Id;
        ausgewähltOrt = ort;
    }

    private void MinimapKlick(Ort ort, int row, int col)
    {
        if (ort.Id == Game.Spieler.AktuellerOrt)
        {
            ausgewähltOrtId = ort.Id;
            ausgewähltOrt = ort;
            return;
        }
        // Richtung aus Grid-Position ableiten (3x3: Mitte = [1,1])
        string? richtung = (row, col) switch
        {
            (0, 1) => "Nord",
            (2, 1) => "Sued",
            (1, 0) => "West",
            (1, 2) => "Ost",
            (0, 0) => "NW",
            (0, 2) => "NO",
            (2, 0) => "SW",
            (2, 2) => "SO",
            _      => null
        };
        var fehler = Game.OrtBetreten(ort.Id, richtung);
        if (fehler != null)
        {
            meldung = fehler;
            return;
        }
        ausgewähltOrtId = null;
        ausgewähltOrt = null;
    }

    private void ZumOrtReisen()
    {
        if (ausgewähltOrt == null) return;
        // Richtung aus Verbindungen des aktuellen Ortes ableiten
        var aktOrt = Game.AktuellerOrt;
        string? richtung = null;
        if (aktOrt != null)
        {
            if (aktOrt.Nord == ausgewähltOrt.Id) richtung = "Nord";
            else if (aktOrt.Sued == ausgewähltOrt.Id) richtung = "Sued";
            else if (aktOrt.Ost == ausgewähltOrt.Id) richtung = "Ost";
            else if (aktOrt.West == ausgewähltOrt.Id) richtung = "West";
            else if (aktOrt.Teleport == ausgewähltOrt.Id) richtung = "Teleport";
            else if (aktOrt.Untergrund == ausgewähltOrt.Id) richtung = "Untergrund";
        }
        var fehler = Game.OrtBetreten(ausgewähltOrt.Id, richtung);
        if (fehler != null)
        {
            meldung = fehler;
            return;
        }
        ausgewähltOrtId = null;
        ausgewähltOrt = null;
    }

    private void ImGrasErkunden()
    {
        var ortRef = ausgewähltOrt != null
            ? Game.AlleOrte.FirstOrDefault(o => o.Id == ausgewähltOrt.Id)
            : Game.AktuellerOrt;
        if (ortRef == null) return;
        var wild = Game.ZufälligesWildMonster(ortRef);
        if (wild != null)
            Game.WildkampfStarten(wild);
        else
            meldung = "Keine wilden Monster in diesem Gebiet.";
    }

