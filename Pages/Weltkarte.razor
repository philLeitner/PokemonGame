    private void RucksackOeffnen() => rucksackOffen = true;
    private void RucksackSchließen() => rucksackOffen = false;

    private void RucksackItemKlick(InventarItem item)
    {
        bool istKarteItem = item.ItemId.StartsWith("ITEM-KARTE", StringComparison.OrdinalIgnoreCase)
            || item.Name.EndsWith("-Karte", StringComparison.OrdinalIgnoreCase)
            || item.Name.EndsWith("karte", StringComparison.OrdinalIgnoreCase);
        if (!istKarteItem) return;
        // Region aus Item-Name ableiten (z.B. "Kanto-Karte" → "KAN")
        vollkarteName = item.Name;
        vollkarteRegionId = item.Name switch
        {
            var n when n.Contains("Kanto",  StringComparison.OrdinalIgnoreCase) => "KAN",
            var n when n.Contains("Johto",  StringComparison.OrdinalIgnoreCase) => "JOH",
            var n when n.Contains("Hoenn",  StringComparison.OrdinalIgnoreCase) => "HOE",
            var n when n.Contains("Sinnoh", StringComparison.OrdinalIgnoreCase) => "SIN",
            var n when n.Contains("Unova",  StringComparison.OrdinalIgnoreCase) => "UNO",
            var n when n.Contains("Kalos",  StringComparison.OrdinalIgnoreCase) => "KAL",
            var n when n.Contains("Alola",  StringComparison.OrdinalIgnoreCase) => "ALO",
            var n when n.Contains("Galar",  StringComparison.OrdinalIgnoreCase) => "GAL",
            var n when n.Contains("Paldea", StringComparison.OrdinalIgnoreCase) => "PAL",
            _ => null // alle Orte anzeigen
        };
        rucksackOffen = false;
        vollkarteOffen = true;
    }

    private void VollkarteSchliessen() => vollkarteOffen = false;

