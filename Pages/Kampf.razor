@inject GameService Game
@implements IDisposable

@if (Game.AktuellerKampf == null)
{
    <p>Kein aktiver Kampf.</p>
    return;
}

@{
    var kampf = Game.AktuellerKampf;
    var spielerMon = kampf.SpielerMonster;
    var gegnerMon = kampf.GegnerMonster;
}

<div class="kampf-screen">
    <!-- Kampf-Arena -->
    <div class="kampf-arena">
        <!-- Gegner oben -->
        <div class="gegner-bereich">
            <div class="monster-info-leiste gegner-leiste">
                <div class="monster-name-zeile">
                    <span class="monster-name">@gegnerMon.Name</span>
                    <span class="monster-level">Lv.@gegnerMon.Level</span>
                    @if (gegnerMon.Status != "none")
                    {
                        <span class="status-badge status-@gegnerMon.Status">@StatusEmoji(gegnerMon.Status) @StatusLabel(gegnerMon.Status)</span>
                    }
                </div>
                <div class="monster-typen">
                    @foreach (var typ in gegnerMon.Typen)
                    {
                        <span class="typ-badge-klein" style="background: @TypeChart.TypFarben.GetValueOrDefault(typ, "#888")">
                            @TypeChart.TypEmojis.GetValueOrDefault(typ, "") @typ
                        </span>
                    }
                </div>
                <div class="kp-leiste-container">
                    <span class="kp-label">KP</span>
                    <div class="kp-leiste">
                        <div class="kp-fill @KpFarbe(gegnerMon)"
                             style="width: @(gegnerMon.MaxKp > 0 ? (gegnerMon.AktuelleKp * 100 / gegnerMon.MaxKp) : 0)%">
                        </div>
                    </div>
                    <span class="kp-zahl">@gegnerMon.AktuelleKp/@gegnerMon.MaxKp</span>
                </div>
            </div>
            <div class="monster-sprite gegner-sprite">
                <img src="@GetMonsterBildPfad(gegnerMon.SpeziesId)" alt="@gegnerMon.Name" class="monster-bild-sprite"
                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                @{
                    var gegnerTypFarbe = TypeChart.TypFarben.GetValueOrDefault(gegnerMon.Typen.FirstOrDefault() ?? "", "#7c7c7c");
                }
                <div class="monster-emoji-fallback" style="background: @gegnerTypFarbe;display:none">
                    <span class="monster-emoji-gross">@GetTypEmoji(gegnerMon.Typen.FirstOrDefault() ?? "")</span>
                </div>
            </div>
        </div>

        <!-- Spieler unten -->
        <div class="spieler-bereich">
            <div class="monster-sprite spieler-sprite">
                <img src="@GetMonsterBildPfad(spielerMon.SpeziesId)" alt="@spielerMon.Name" class="monster-bild-sprite"
                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                @{
                    var spielerTypFarbe = TypeChart.TypFarben.GetValueOrDefault(spielerMon.Typen.FirstOrDefault() ?? "", "#7c7c7c");
                }
                <div class="monster-emoji-fallback" style="background: @spielerTypFarbe;display:none">
                    <span class="monster-emoji-gross spieler-emoji">@GetTypEmoji(spielerMon.Typen.FirstOrDefault() ?? "")</span>
                </div>
            </div>
            <div class="monster-info-leiste spieler-leiste">
                <div class="monster-name-zeile">
                    <span class="monster-name">@spielerMon.AngezeigterName</span>
                    <span class="monster-level">Lv.@spielerMon.Level</span>
                    @if (spielerMon.Status != "none")
                    {
                        <span class="status-badge status-@spielerMon.Status">@StatusEmoji(spielerMon.Status) @StatusLabel(spielerMon.Status)</span>
                    }
                </div>
                <div class="monster-typen">
                    @foreach (var typ in spielerMon.Typen)
                    {
                        <span class="typ-badge-klein" style="background: @TypeChart.TypFarben.GetValueOrDefault(typ, "#888")">
                            @TypeChart.TypEmojis.GetValueOrDefault(typ, "") @typ
                        </span>
                    }
                </div>
                <div class="kp-leiste-container">
                    <span class="kp-label">KP</span>
                    <div class="kp-leiste">
                        <div class="kp-fill @KpFarbe(spielerMon)"
                             style="width: @(spielerMon.MaxKp > 0 ? (spielerMon.AktuelleKp * 100 / spielerMon.MaxKp) : 0)%">
                        </div>
                    </div>
                    <span class="kp-zahl">@spielerMon.AktuelleKp/@spielerMon.MaxKp</span>
                </div>
                <div class="exp-leiste-container">
                    <div class="exp-leiste">
                        <div class="exp-fill" style="width: @ExpProzent(spielerMon)%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Kampf-Log -->
    <div class="kampf-log" @ref="logRef">
        @foreach (var eintrag in kampf.Log.TakeLast(5))
        {
            <p class="log-eintrag">@eintrag</p>
        }
    </div>

    <!-- Aktions-Bereich -->
    <div class="aktions-bereich">

        @if (kampf.Phase == KampfPhase.Beendet)
        {
            <div class="kampf-ergebnis @(kampf.SpielerGewonnen ? "gewonnen" : "verloren")">
                <h3>@(kampf.SpielerGewonnen ? "🎉 Sieg!" : "💀 Niederlage!")</h3>
                @if (kampf.SpielerGewonnen && kampf.ErfahrungGewonnen > 0)
                {
                    <p>+@kampf.ErfahrungGewonnen EP</p>
                }
                <p class="kampf-weiter-hint">⏳ Weiter in Kürze...</p>
            </div>
        }
        else if (kampf.Phase == KampfPhase.AttackeLernen && kampf.LernMonster != null && kampf.NeueAttacke != null)
        {
            @if (lernDialog_WelcheErsetzen)
            {
                <!-- Welche Attacke ersetzen? -->
                <div class="attacke-lern-dialog">
                    <div class="lern-dialog-titel">❓ Welche Attacke soll vergessen werden?</div>
                    <div class="lern-neue-attacke-info">
                        <span class="lern-neue-name">@kampf.NeueAttacke.Name</span>
                        <span class="lern-neue-typ" style="background:@TypeChart.TypFarben.GetValueOrDefault(kampf.NeueAttacke.Typ, "#888")">@kampf.NeueAttacke.Typ</span>
                        @if (kampf.NeueAttacke.Staerke.HasValue && kampf.NeueAttacke.Staerke > 0)
                        {
                            <span class="lern-neue-staerke">⚔️ @kampf.NeueAttacke.Staerke</span>
                        }
                        @if (kampf.NeueAttacke.Genauigkeit.HasValue)
                        {
                            <span class="lern-neue-gen">🎯 @kampf.NeueAttacke.Genauigkeit%</span>
                        }
                        @if (kampf.NeueAttacke.Ap.HasValue)
                        {
                            <span class="lern-neue-ap">@kampf.NeueAttacke.Ap AP</span>
                        }
                    </div>
                    <div class="lern-attacken-liste">
                        @foreach (var atk in kampf.LernMonster.Attacken)
                        {
                            <button class="lern-attacke-btn" @onclick="() => AttackeErsetzenWaehlen(atk)">
                                <span class="lern-atk-name">@atk.Name</span>
                                <span class="lern-atk-typ" style="background:@TypeChart.TypFarben.GetValueOrDefault(atk.Typ, "#888")">@atk.Typ</span>
                                @if (atk.Staerke.HasValue && atk.Staerke > 0)
                                {
                                    <span class="lern-atk-info">⚔️ @atk.Staerke | 🎯 @(atk.Genauigkeit?.ToString() ?? "—")% | @atk.AktuelleAp/@atk.MaxAp AP</span>
                                }
                                else
                                {
                                    <span class="lern-atk-info">Status | @atk.AktuelleAp/@atk.MaxAp AP</span>
                                }
                            </button>
                        }
                    </div>
                    <button class="lern-btn-abbrechen" @onclick="AttackeLernenAbbrechen">✖ Abbrechen</button>
                </div>
            }
            else if (lernDialog_SicherheitsAbfrage != null)
            {
                <!-- Sicherheitsabfrage: Wirklich diese Attacke vergessen? -->
                @if (lernDialog_SicherheitsAbfrage.Name == "(keine)")
                {
                    <!-- Ablehnen bestätigen -->
                    <div class="attacke-lern-dialog">
                        <div class="lern-dialog-titel">⚠️ Willst du @kampf.NeueAttacke.Name wirklich nicht lernen?</div>
                        <p class="lern-dialog-text">@kampf.LernMonster.AngezeigterName lernt @kampf.NeueAttacke.Name nicht.</p>
                        <div class="lern-dialog-buttons">
                            <button class="lern-btn-ja" @onclick="AttackeLernenWirklichNicht">✅ Ja, nicht lernen</button>
                            <button class="lern-btn-nein" @onclick="AttackeLernenZurueck">❌ Nein, zurück</button>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Attacke ersetzen bestätigen -->
                    <div class="attacke-lern-dialog">
                        <div class="lern-dialog-titel">⚠️ Willst du @lernDialog_SicherheitsAbfrage.Name wirklich vergessen?</div>
                        <p class="lern-dialog-text">@kampf.LernMonster.AngezeigterName vergisst @lernDialog_SicherheitsAbfrage.Name und lernt @kampf.NeueAttacke.Name.</p>
                        <div class="lern-dialog-buttons">
                            <button class="lern-btn-ja" @onclick="AttackeLernenWirklichJa">✅ Ja, ersetzen</button>
                            <button class="lern-btn-nein" @onclick="AttackeLernenZurueck">❌ Nein, zurück</button>
                        </div>
                    </div>
                }
            }
            else
            {
                <!-- Hauptfrage: Neue Attacke lernen? -->
                <div class="attacke-lern-dialog">
                    <div class="lern-dialog-titel">🎉 @kampf.LernMonster.AngezeigterName möchte eine neue Attacke lernen!</div>
                    <div class="lern-neue-attacke-info">
                        <span class="lern-neue-name">@kampf.NeueAttacke.Name</span>
                        <span class="lern-neue-typ" style="background:@TypeChart.TypFarben.GetValueOrDefault(kampf.NeueAttacke.Typ, "#888")">@kampf.NeueAttacke.Typ</span>
                        @if (kampf.NeueAttacke.Staerke.HasValue && kampf.NeueAttacke.Staerke > 0)
                        {
                            <span class="lern-neue-staerke">⚔️ @kampf.NeueAttacke.Staerke Stärke</span>
                        }
                        @if (kampf.NeueAttacke.Genauigkeit.HasValue)
                        {
                            <span class="lern-neue-gen">🎯 @kampf.NeueAttacke.Genauigkeit%</span>
                        }
                        @if (kampf.NeueAttacke.Ap.HasValue)
                        {
                            <span class="lern-neue-ap">@kampf.NeueAttacke.Ap AP</span>
                        }
                        @if (!string.IsNullOrEmpty(kampf.NeueAttacke.Statuseffekt))
                        {
                            <span class="lern-neue-status">💤 @StatuseffektLabel(kampf.NeueAttacke.Statuseffekt)</span>
                        }
                    </div>
                    <p class="lern-dialog-text">Willst du diese Attacke erlernen?</p>
                    @if (kampf.LernMonster.Attacken.Count >= 4)
                    {
                        <p class="lern-dialog-hinweis">⚠️ @kampf.LernMonster.AngezeigterName kennt bereits 4 Attacken. Eine muss vergessen werden.</p>
                    }
                    <div class="lern-dialog-buttons">
                        <button class="lern-btn-ja" @onclick="AttackeLernenJa">✅ Ja</button>
                        <button class="lern-btn-nein" @onclick="AttackeLernenNein">❌ Nein</button>
                    </div>
                </div>
            }
        }
        else if (kampf.Phase == KampfPhase.Evolution)
        {
            <div class="evolution-panel">
                <div class="evolution-text">✨ @kampf.EntwickeltSichMonster?.AngezeigterName entwickelt sich...</div>
                <div class="evolution-arrow">→ @kampf.EntwickeltSichZuName</div>
            </div>
        }
        else if (kampf.Phase == KampfPhase.Fangen)
        {
            <div class="fang-animation">
                <div class="fang-ball-anim"><span class="fang-ball-emoji">@GetBallEmoji(kampf)</span></div>
                <p class="fang-text">Ball fliegt...</p>
                <div class="warten-punkte"><span>.</span><span>.</span><span>.</span></div>
            </div>
        }
        else if (kampf.Phase == KampfPhase.MonsterWechsel)
        {
            <div class="wechsel-panel">
                <p class="wechsel-titel">Wähle dein nächstes Monster:</p>
                <div class="team-wechsel-liste">
                    @foreach (var mon in Game.Spieler.Team.Where(m => !m.IstOhnmächtig && m != spielerMon))
                    {
                        float defMulti2 = 1f;
                        if (gegnerMon != null && mon.Typen.Count > 0)
                        {
                            foreach (var gt in gegnerMon.Typen)
                                defMulti2 *= TypeChart.GetVerteidigungsMultiplikator(gt, mon.Typen);
                        }
                        string defBadgeKlasse2 = defMulti2 == 0f ? "effekt-immun" : defMulti2 <= 0.5f ? "effekt-stark" : defMulti2 >= 2f ? "effekt-schwach" : "";
                        string defBadgeText2 = defMulti2 == 0f ? "✗ Immun" : defMulti2 <= 0.25f ? "×¼ Res." : defMulti2 <= 0.5f ? "×½ Res." : defMulti2 >= 4f ? "×4 Schwach" : defMulti2 >= 2f ? "×2 Schwach" : "";
                        <button class="btn-team-mon" @onclick="() => ErzwungenesWechseln(mon)">
                            <div class="wechsel-mon-zeile">
                                <span class="team-mon-name">@mon.AngezeigterName</span>
                                @if (!string.IsNullOrEmpty(defBadgeText2))
                                {
                                    <span class="effekt-badge @defBadgeKlasse2">@defBadgeText2</span>
                                }
                            </div>
                            <span class="team-mon-info">Lv.@mon.Level | @mon.AktuelleKp/@mon.MaxKp KP</span>
                        </button>
                    }
                </div>
            </div>
        }
        else if (kampf.Phase == KampfPhase.Intro)
        {
            <div class="kampf-intro">
                <p>@kampf.Log.LastOrDefault()</p>
                <p class="kampf-intro-hint">⏳ Kampf beginnt gleich...</p>
            </div>
        }
        else if (kampf.Phase == KampfPhase.SpielerZug)
        {
            @if (aktivesPanel == "haupt")
            {
                <!-- Haupt-Menü -->
                <div class="haupt-menu">
                    <button class="btn-haupt-aktion btn-attacke" @onclick='() => aktivesPanel = "attacken"'>⚔️ Attacke</button>
                    <button class="btn-haupt-aktion btn-item" @onclick='() => aktivesPanel = "items"'>🎒 Items</button>
                    <button class="btn-haupt-aktion btn-wechsel" @onclick='() => aktivesPanel = "wechsel"'>🔄 Wechsel</button>
                    @if (kampf.KannFangen)
                    {
                        <button class="btn-haupt-aktion btn-fangen" @onclick='() => aktivesPanel = "fangen"'>⚪ Fangen</button>
                    }
                    @if (kampf.Typ == KampfTyp.Wild)
                    {
                        <button class="btn-haupt-aktion btn-fliehen" @onclick="Fliehen">🏃 Fliehen</button>
                    }
                </div>
            }
            else if (aktivesPanel == "attacken")
            {
                <div class="panel-header">
                    <button class="btn-zurueck" @onclick='() => aktivesPanel = "haupt"'>← Zurück</button>
                    <span>Attacke wählen:</span>
                </div>
                <div class="attacken-grid">
                    @foreach (var attacke in spielerMon.Attacken)
                    {
                        <button class="attacke-btn typ-@attacke.Typ.ToLower()"
                                style="border-color: @TypeChart.TypFarben.GetValueOrDefault(attacke.Typ, "#888"); background: @TypeChart.TypFarben.GetValueOrDefault(attacke.Typ, "#888")22"
                                @onclick="() => AttackeAusführen(attacke)"
                                disabled="@(!attacke.HatAp)">
                            <div class="attacke-btn-kopf">
                                <span class="attacke-typ-icon">@TypeChart.TypEmojis.GetValueOrDefault(attacke.Typ, "")</span>
                                <span class="attacke-name">@attacke.Name</span>
                                <span class="attacke-ap-badge">@attacke.AktuelleAp/@attacke.MaxAp AP</span>
                            </div>
                            <div class="attacke-btn-details">
                                <span class="attacke-typ-badge" style="background:@TypeChart.TypFarben.GetValueOrDefault(attacke.Typ, "#888")">@attacke.Typ</span>
                                <span class="attacke-kat-badge">@(attacke.Kategorie == "Physisch" ? "💪 Physisch" : attacke.Kategorie == "Speziell" ? "✨ Speziell" : "🛡️ Status")</span>
                                @if (attacke.Staerke.HasValue && attacke.Staerke > 0)
                                {
                                    <span class="attacke-staerke">⚔️ @attacke.Staerke Stärke</span>
                                }
                                @if (attacke.Genauigkeit.HasValue)
                                {
                                    <span class="attacke-genauigkeit">🎯 @attacke.Genauigkeit%</span>
                                }
                                @if (!attacke.Staerke.HasValue || attacke.Staerke == 0)
                                {
                                    <span class="attacke-status-hinweis">🛡️ Kein direkter Schaden</span>
                                }
                                @{
                                    var gegnerTypenListe = gegnerMon?.Typen ?? new List<string>();
                                    if (gegnerTypenListe.Count > 0 && attacke.Kategorie != "Status")
                                    {
                                        float effMulti = TypeChart.GetVerteidigungsMultiplikator(attacke.Typ, gegnerTypenListe);
                                        if (effMulti == 0f)
                                        {
                                            <span class="effekt-badge effekt-immun">✗ Immun</span>
                                        }
                                        else if (effMulti <= 0.5f)
                                        {
                                            <span class="effekt-badge effekt-schwach">×@(effMulti < 0.4f ? "¼" : "½") Schwach</span>
                                        }
                                        else if (effMulti >= 4f)
                                        {
                                            <span class="effekt-badge effekt-stark">×4 Stark!</span>
                                        }
                                        else if (effMulti >= 2f)
                                        {
                                            <span class="effekt-badge effekt-stark">×2 Stark!</span>
                                        }
                                    }
                                }
                                @if (!string.IsNullOrEmpty(attacke.Statuseffekt))
                                {
                                    var statusIcon = attacke.Statuseffekt switch
                                    {
                                        "verbrannt"     => "🔥",
                                        "eingefroren"   => "🧊",
                                        "gelähmt"       => "⚡",
                                        "vergiftet"     => "☠️",
                                        "eingeschlafen" => "💤",
                                        "verwirrt"      => "😵",
                                        _               => "✨"
                                    };
                                    var statusText = StatuseffektLabel(attacke.Statuseffekt);
                                    var chanceText = attacke.StatuseffektChance.HasValue && attacke.StatuseffektChance < 100
                                        ? $" ({attacke.StatuseffektChance}%)"
                                        : "";
                                    <span class="attacke-status-effekt">@statusIcon @statusText@chanceText</span>
                                }
                                @if (attacke.Generation == 9)
                                {
                                    <span class="attacke-gen9-badge">Gen 9</span>
                                }
                            </div>
                        </button>
                    }
                </div>
            }
            else if (aktivesPanel == "items")
            {
                <div class="panel-header">
                    <button class="btn-zurueck" @onclick='() => { aktivesPanel = "haupt"; gewähltesItemId = null; }'>← Zurück</button>
                    <span>@(gewähltesItemId == null ? "Item wählen:" : "Auf wen anwenden?")</span>
                </div>
                @if (gewähltesItemId == null)
                {
                    <div class="item-liste">
                        @{
                            // Bälle (ITEM-011 bis ITEM-019) und Ausrüstung aus dem Kampf-Item-Panel ausfiltern
                            var kampfItems = Game.Spieler.Inventar
                                .Where(i => i.Menge > 0 && i.Kategorie != "Pokébälle" && i.Kategorie != "Ausrüstung")
                                .ToList();
                        }
                        @if (!kampfItems.Any())
                        {
                            <p class="leer-text">Keine Items vorhanden.</p>
                        }
                        @foreach (var item in kampfItems)
                        {
                            <button class="btn-item-verwenden" @onclick="() => gewähltesItemId = item.ItemId">
                                <span class="item-emoji">@item.Emoji</span>
                                <span class="item-name">@item.Name</span>
                                <span class="item-menge">x@item.Menge</span>
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="team-wechsel-liste">
                        @foreach (var mon in Game.Spieler.Team)
                        {
                            <button class="btn-team-mon" @onclick="() => ItemAnwenden(mon)">
                                <span class="team-mon-name">@mon.AngezeigterName</span>
                                <span class="team-mon-info">Lv.@mon.Level | @mon.AktuelleKp/@mon.MaxKp KP @(mon.Status != "none" ? "| " + StatusEmoji(mon.Status) : "")</span>
                            </button>
                        }
                    </div>
                }
            }
            else if (aktivesPanel == "wechsel")
            {
                <div class="panel-header">
                    <button class="btn-zurueck" @onclick='() => aktivesPanel = "haupt"'>← Zurück</button>
                    <span>Monster wechseln:</span>
                </div>
                <div class="team-wechsel-liste">
                    @foreach (var mon in Game.Spieler.Team)
                    {
                        bool istAktiv = mon == spielerMon;
                        float defMulti = 1f;
                        if (gegnerMon != null && mon.Typen.Count > 0)
                        {
                            foreach (var gt in gegnerMon.Typen)
                                defMulti *= TypeChart.GetVerteidigungsMultiplikator(gt, mon.Typen);
                        }
                        string defBadgeKlasse = defMulti == 0f ? "effekt-immun" : defMulti <= 0.5f ? "effekt-stark" : defMulti >= 2f ? "effekt-schwach" : "";
                        string defBadgeText = defMulti == 0f ? "✗ Immun" : defMulti <= 0.25f ? "×¼ Res." : defMulti <= 0.5f ? "×½ Res." : defMulti >= 4f ? "×4 Schwach" : defMulti >= 2f ? "×2 Schwach" : "";
                        <button class="btn-team-mon @(istAktiv ? "aktiv-mon" : "") @(mon.IstOhnmächtig ? "ohnmaechtig-mon" : "")"
                                disabled="@(istAktiv || mon.IstOhnmächtig)"
                                @onclick="() => WechsleMitGegnerZug(mon)">
                            <div class="wechsel-mon-zeile">
                                <span class="team-mon-name">@mon.AngezeigterName @(istAktiv ? "(aktiv)" : "")</span>
                                @if (!string.IsNullOrEmpty(defBadgeText) && !istAktiv && !mon.IstOhnmächtig)
                                {
                                    <span class="effekt-badge @defBadgeKlasse">@defBadgeText</span>
                                }
                            </div>
                            <span class="team-mon-info">Lv.@mon.Level | @mon.AktuelleKp/@mon.MaxKp KP @(mon.IstOhnmächtig ? "💀" : "")</span>
                        </button>
                    }
                </div>
            }
            else if (aktivesPanel == "fangen")
            {
                <div class="panel-header">
                    <button class="btn-zurueck" @onclick='() => aktivesPanel = "haupt"'>← Zurück</button>
                    <span>Ball wählen:</span>
                </div>
                <div class="fang-info-box">
                    <span class="fang-widerstand-label">Widerstand: <strong>@GegnerWiderstand(gegnerMon)/10</strong></span>
                    @if (!string.IsNullOrEmpty(HpHinweis(gegnerMon))) { <span class="fang-bonus-chip">@HpHinweis(gegnerMon)</span> }
                    @if (!string.IsNullOrEmpty(StatusHinweis(gegnerMon))) { <span class="fang-bonus-chip">@StatusHinweis(gegnerMon)</span> }
                </div>
                <div class="ball-liste">
                    @foreach (var ball in new[] {
                        ("ITEM-011", "⚪", "Monsterball R"),
                        ("ITEM-012", "🔵", "Monsterball UR"),
                        ("ITEM-013", "🔴", "Monsterball S"),
                        ("ITEM-014", "🟣", "Monsterball SR")
                    })
                    {
                        int menge = Game.Spieler.GetItemMenge(ball.Item1);
                        <button class="@("btn-ball" + (menge == 0 ? " kein-ap" : ""))"
                                disabled="@(menge == 0)"
                                @onclick="() => BallWerfen(ball.Item1)">
                            <span>@ball.Item2 @ball.Item3</span>
                            <span class="item-menge">x@menge</span>
                        </button>
                    }
                </div>
            }
        }
        else if (kampf.Phase == KampfPhase.GegnerZug)
        {
            <div class="warten-anzeige">
                <div class="warten-punkte">
                    <span>.</span><span>.</span><span>.</span>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private ElementReference logRef;
    private string aktivesPanel = "haupt";
    private string? gewähltesItemId;
    private bool autoWeiterGestartet = false;

    // Attacken-Lern-Dialog Zustand
    private bool lernDialog_WelcheErsetzen = false;
    private AttackeInstanz? lernDialog_SicherheitsAbfrage = null;

    // Helper-Methode für Monster-Bilder
    private string GetMonsterBildPfad(string speziesId) => $"/sprites/monster/{speziesId}.png";

    protected override void OnInitialized()
    {
        Game.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Game.AktuellerKampf?.Phase == KampfPhase.Intro)
        {
            await Task.Delay(1200);
            KampfBeginnen();
            StateHasChanged();
        }
        // Auto-Weiter nach Kampfende
        if (!autoWeiterGestartet && Game.AktuellerKampf?.Phase == KampfPhase.Beendet)
        {
            autoWeiterGestartet = true;
            await Task.Delay(2000);
            Game.KampfBeenden();
        }
    }

    public void Dispose() => Game.OnChange -= StateHasChanged;

    private void KampfBeginnen()
    {
        if (Game.AktuellerKampf != null)
            Game.AktuellerKampf.Phase = KampfPhase.SpielerZug;
        aktivesPanel = "haupt";
    }

    private async Task AttackeAusführen(AttackeInstanz attacke)
    {
        aktivesPanel = "haupt";
        await Game.AttackeAusführen(attacke);
    }

    private void ItemAufZielWählen(string itemId)
    {
        gewähltesItemId = itemId;
    }

    private async Task ItemAnwenden(MonsterInstanz ziel)
    {
        if (gewähltesItemId == null) return;
        string id = gewähltesItemId;
        gewähltesItemId = null;
        aktivesPanel = "haupt";
        await Game.ItemImKampfVerwenden(id, ziel);
    }

    private async Task WechsleMitGegnerZug(MonsterInstanz mon)
    {
        aktivesPanel = "haupt";
        await Game.MonsterWechseln(mon);
    }

    private async Task ErzwungenesWechseln(MonsterInstanz mon)
    {
        await Game.MonsterWechseln(mon);
    }

    private async Task BallWerfen(string ballId)
    {
        aktivesPanel = "haupt";
        await Game.MonsterFangen(ballId);
    }

    private async Task Fliehen()
    {
        aktivesPanel = "haupt";
        await Game.KampfFliehen();
    }

    private string GetTypEmoji(string typ) =>
        TypeChart.TypEmojis.GetValueOrDefault(typ, "❓");

    private string KpFarbe(MonsterInstanz mon)
    {
        float pct = mon.MaxKp > 0 ? (float)mon.AktuelleKp / mon.MaxKp : 0;
        return pct > 0.5f ? "kp-gruen" : pct > 0.25f ? "kp-gelb" : "kp-rot";
    }

    private string ExpProzent(MonsterInstanz mon)
    {
        int benötigt = Math.Max(1, (mon.Level + 1) * (mon.Level + 1) * 10);
        return Math.Max(0, Math.Min(100, (int)((float)mon.ErfahrungsPunkte / benötigt * 100))).ToString();
    }

    private string StatusEmoji(string status) => status switch
    {
        "vergiftet"     => "☠️",
        "verbrannt"     => "🔥",
        "gelähmt"       => "⚡",
        "eingeschlafen" => "💤",
        "eingefroren"   => "🧧",
        _               => ""
    };

    private string StatusLabel(string status) => status switch
    {
        "vergiftet"     => "Gift",
        "verbrannt"     => "Brand",
        "gelähmt"       => "Lähm.",
        "eingeschlafen" => "Schlaf",
        "eingefroren"   => "Eis",
        _               => ""
    };

    private string StatuseffektLabel(string s) => s switch
    {
        "verbrannt"     => "Kann verbrennen",
        "eingefroren"   => "Kann einfrieren",
        "gelähmt"       => "Kann lähmen",
        "vergiftet"     => "Kann vergiften",
        "eingeschlafen" => "Kann einschläfern",
        "verwirrt"      => "Kann verwirren",
        _               => s
    };

    // ─ Attacken-Lern-Dialog Methoden ─
    private void AttackeLernenJa()
    {
        var kampf = Game.AktuellerKampf;
        if (kampf?.LernMonster == null) return;
        if (kampf.LernMonster.Attacken.Count < 4)
        {
            // Platz vorhanden: direkt lernen (zuErsetzen = null, aber Platz da)
            _ = Game.AttackeLernenAbschliessen(null);
            lernDialog_WelcheErsetzen = false;
            lernDialog_SicherheitsAbfrage = null;
        }
        else
        {
            // 4 Attacken: Auswahl welche ersetzt wird
            lernDialog_WelcheErsetzen = true;
            lernDialog_SicherheitsAbfrage = null;
        }
    }

    private void AttackeLernenNein()
    {
        // Sicherheitsabfrage anzeigen (mit null = "keine spezifische Attacke")
        lernDialog_SicherheitsAbfrage = new AttackeInstanz { Name = "(keine)" };
        lernDialog_WelcheErsetzen = false;
    }

    private void AttackeErsetzenWaehlen(AttackeInstanz zuErsetzen)
    {
        // Sicherheitsabfrage: wirklich diese Attacke vergessen?
        lernDialog_SicherheitsAbfrage = zuErsetzen;
        lernDialog_WelcheErsetzen = false;
    }

    private void AttackeLernenAbbrechen()
    {
        // Zurück zur Hauptfrage
        lernDialog_WelcheErsetzen = false;
        lernDialog_SicherheitsAbfrage = null;
    }

    private void AttackeLernenWirklichJa()
    {
        // Attacke ersetzen bestätigt: alte Attacke vergessen, neue lernen
        if (lernDialog_SicherheitsAbfrage != null)
        {
            _ = Game.AttackeLernenAbschliessen(lernDialog_SicherheitsAbfrage);
        }
        lernDialog_WelcheErsetzen = false;
        lernDialog_SicherheitsAbfrage = null;
    }

    private void AttackeLernenWirklichNicht()
    {
        // Ablehnen bestätigt: Attacke nicht lernen
        lernDialog_WelcheErsetzen = false;
        lernDialog_SicherheitsAbfrage = null;
        _ = Game.AttackeLernenAbschliessen(null);
    }

    private void AttackeLernenZurueck()
    {
        // Zurück: Wenn wir aus "welche ersetzen" kamen, dahin zurück
        if (lernDialog_SicherheitsAbfrage != null && lernDialog_SicherheitsAbfrage.Name != "(keine)")
        {
            lernDialog_WelcheErsetzen = true;
        }
        lernDialog_SicherheitsAbfrage = null;
    }

    // ─ Fang-Hilfsmethoden ─
    private string GetBallEmoji(KampfZustand k)
    {
        var log = k.Log.LastOrDefault(l => l.Contains("Monsterball UR") || l.Contains("Monsterball S") || l.Contains("Monsterball SR") || l.Contains("Monsterball")) ?? "";
        return log.Contains("Monsterball UR") ? "🔵" : log.Contains("Monsterball S") ? "🟡" : log.Contains("Monsterball SR") ? "🟣" : "⚪";
    }
    private int GegnerWiderstand(MonsterInstanz m)
    {
        int w = (int)Math.Round(10.0 - (m.Fangrate / 255.0) * 9.0);
        return Math.Clamp(w, 1, 10);
    }
    private string HpHinweis(MonsterInstanz m)
    {
        float hp = m.MaxKp > 0 ? (float)m.AktuelleKp / m.MaxKp : 1f;
        return hp < 0.10f ? "❤️‍🔥 sehr schwach (+3)" : hp < 0.25f ? "🔶 schwach (+2)" : hp < 0.50f ? "🟡 angeschlagen (+1)" : "";
    }
    private string StatusHinweis(MonsterInstanz m)
    {
        int bon = m.Status is "eingeschlafen" or "eingefroren" ? 3
                : m.Status is "vergiftet" or "gelähmt" or "verbrannt" ? 1 : 0;
        return bon > 0 ? $"{m.Status} (+{bon})" : "";
    }
}
