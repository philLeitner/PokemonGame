@using MonsterKampf.Models
@inject GameService Game
@implements IDisposable

<div class="pokedex-screen">

    <!-- ── Header ── -->
    <div class="pokedex-header">
        <button class="btn-zurueck" @onclick="Game.ZuWeltkarte">← Zurück</button>
        <h2>📖 Monsterübersicht</h2>
        <span class="gefangen-zahl">@gefangenCount / @Game.AlleMonster.Count gefangen</span>
    </div>

    <!-- ── Filter-Leiste ── -->
    <div class="pokedex-filter-bar">
        <input class="pokedex-suchfeld" type="text" placeholder="🔍 Name oder #Nr. suchen..."
               @bind="suchText" @bind:event="oninput" />
        <select class="pokedex-filter" @bind="filterTyp">
            <option value="">🎨 Alle Typen</option>
            @foreach (var typ in TypeChart.TypFarben.Keys)
            {
                <option value="@typ">@TypeChart.TypEmojis.GetValueOrDefault(typ,"") @typ</option>
            }
        </select>
        <label class="pokedex-nur-gefangen">
            <input type="checkbox" @bind="nurGefangen" /> Nur gefangen
        </label>
    </div>

    <!-- ── Region-Chips ── -->
    <div class="pokedex-region-filter">
        <span class="region-filter-label">Region:</span>
        @foreach (var region in AlleRegionen)
        {
            bool aktiv = ausgewählteRegionen.Contains(region.Key);
            bool verfügbar = RegionVerfügbar(region.Key);
            <button class="region-chip @(aktiv ? "aktiv" : "") @(!verfügbar ? "nicht-verfuegbar" : "")"
                    @onclick="() => RegionToggle(region.Key)">
                @region.Value.Emoji @region.Value.Name
            </button>
        }
    </div>

    <!-- ── Haupt-Bereich ── -->
    <div class="pokedex-inhalt">

        <!-- Links: Monster-Gitter -->
        <div class="pokedex-gitter-wrapper">
            <div class="pokedex-gitter">
                @{
                    var gefiltert = GefilterteMonster().ToList();
                }
                @if (!gefiltert.Any())
                {
                    <div class="pokedex-leer-liste">
                        <p>Keine Monster gefunden.</p>
                        <button class="btn-filter-reset" @onclick="FilterZuruecksetzen">Filter zurücksetzen</button>
                    </div>
                }
                @foreach (var mon in gefiltert)
                {
                    bool istGefangen = IstGefangen(mon.Id);
                    bool istGesehen = IstGesehen(mon.Id);
                    bool istAusgewaehlt = ausgewähltId == mon.Id;
                    int nr = GetNummer(mon.Id);
                    string kartenKlasse = istGefangen ? "gefangen" : istGesehen ? "gesehen" : "unbekannt";
                    <div class="pokedex-karte @(istAusgewaehlt ? "ausgewaehlt" : "") @kartenKlasse"
                         @onclick="() => AuswaehlenKlick(mon)">
                        <span class="pokedex-nr">#@nr.ToString("D3")</span>
                        @if (istGefangen)
                        {
                            <!-- Gefangen: alles sichtbar + Team/Box Badge -->
                            <div class="pokedex-bild-container">
                                <img class="pokedex-bild" src="@mon.Bild" alt="@mon.Name"
                                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                                <div class="pokedex-bild-fallback" style="display:none">
                                    @TypeChart.TypEmojis.GetValueOrDefault(mon.Typen.FirstOrDefault() ?? "", "❓")
                                </div>
                                @if (IstImTeam(mon.Id))
                                {
                                    <span class="karte-status-badge team">⚔️</span>
                                }
                                else
                                {
                                    <span class="karte-status-badge box">📦</span>
                                }
                            </div>
                            <span class="pokedex-name">@mon.Name</span>
                            <div class="pokedex-typen-mini">
                                @foreach (var typ in mon.Typen)
                                {
                                    <span class="typ-badge-mini"
                                          style="background:@TypeChart.TypFarben.GetValueOrDefault(typ,"#888")">
                                        @typ
                                    </span>
                                }
                            </div>
                        }
                        else if (istGesehen)
                        {
                            <!-- Gesehen: Bild sichtbar, Name sichtbar, Typen sichtbar, aber ausgegraut -->
                            <div class="pokedex-bild-container">
                                <img class="pokedex-bild gesehen-bild" src="@mon.Bild" alt="@mon.Name"
                                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                                <div class="pokedex-bild-fallback" style="display:none">
                                    @TypeChart.TypEmojis.GetValueOrDefault(mon.Typen.FirstOrDefault() ?? "", "❓")
                                </div>
                                <span class="karte-status-badge gesehen-badge">👁️</span>
                            </div>
                            <span class="pokedex-name">@mon.Name</span>
                            <div class="pokedex-typen-mini">
                                @foreach (var typ in mon.Typen)
                                {
                                    <span class="typ-badge-mini"
                                          style="background:@TypeChart.TypFarben.GetValueOrDefault(typ,"#888"); opacity:0.6">
                                        @typ
                                    </span>
                                }
                            </div>
                        }
                        else
                        {
                            <!-- Nicht gesehen: alles versteckt -->
                            <div class="pokedex-unbekannt-bild">❓</div>
                            <span class="pokedex-name unbekannt-name">???</span>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Rechts: Detail-Panel -->
        <div class="pokedex-detail">
            @if (ausgewähltMon == null)
            {
                <div class="pokedex-detail-leer">
                    <span>📖</span>
                    <p>Wähle ein Monster aus</p>
                </div>
            }
            else
            {
                bool istGefangen2 = IstGefangen(ausgewähltMon.Id);
                bool istGesehen2 = IstGesehen(ausgewähltMon.Id);
                int nr2 = GetNummer(ausgewähltMon.Id);

                <!-- Detail-Header -->
                <div class="detail-header">
                    @if (istGefangen2 || istGesehen2)
                    {
                        <img class="detail-bild-gross @(istGesehen2 && !istGefangen2 ? "gesehen-bild" : "")" src="@ausgewähltMon.Bild" alt="@ausgewähltMon.Name"
                             onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                        <div class="detail-bild-fallback" style="display:none">
                            @TypeChart.TypEmojis.GetValueOrDefault(ausgewähltMon.Typen.FirstOrDefault() ?? "", "❓")
                        </div>
                    }
                    else
                    {
                        <div class="detail-bild-fallback">❓</div>
                    }
                    <div class="detail-info">
                        <div class="detail-nr">#@nr2.ToString("D3") · @GetRegionName(nr2)</div>
                        <div class="detail-name">@(istGefangen2 || istGesehen2 ? ausgewähltMon.Name : "????")</div>
                        @if (istGefangen2 || istGesehen2)
                        {
                            <div class="detail-typen">
                                @foreach (var typ in ausgewähltMon.Typen)
                                {
                                    <span class="typ-badge-mini"
                                          style="background:@TypeChart.TypFarben.GetValueOrDefault(typ,"#888"); font-size:0.78rem; padding:0.15rem 0.5rem; @(istGesehen2 && !istGefangen2 ? "opacity:0.7" : "")">
                                        @TypeChart.TypEmojis.GetValueOrDefault(typ,"") @typ
                                    </span>
                                }
                            </div>
                            <div class="detail-badges">
                                @if (istGefangen2)
                                {
                                    @if (IstImTeam(ausgewähltMon.Id))
                                    {
                                        <span class="team-badge">⚔️ Im Team</span>
                                    }
                                    else
                                    {
                                        <span class="gefangen-badge">📦 Gefangen</span>
                                    }
                                }
                                else
                                {
                                    <span class="gesehen-badge-detail">👁️ Gesehen</span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="detail-badges">
                                <span style="font-size:0.78rem;color:var(--text-dunkel)">❓ Noch nicht entdeckt</span>
                            </div>
                        }
                    </div>
                </div>

                @if (istGefangen2 || istGesehen2)
                {
                    <!-- Fundorte (bei gesehen + gefangen) -->
                    var fundorte = GetFundorte(ausgewähltMon.Id);
                    if (fundorte.Any())
                    {
                        <div class="detail-sektion">
                            <div class="detail-sektion-titel">📍 Fundorte</div>
                            <div class="fundort-liste">
                                @foreach (var ort in fundorte)
                                {
                                    <span class="fundort-chip">@ort</span>
                                }
                            </div>
                        </div>
                    }

                    @if (!istGefangen2)
                    {
                        <!-- Gesehen: nur gesehene Attacken anzeigen -->
                        var geseheneAtkIds = Game.Spieler.GeseheneAttacken.GetValueOrDefault(ausgewähltMon.Id, new List<string>());
                        @if (geseheneAtkIds.Any())
                        {
                            <div class="detail-sektion">
                                <div class="detail-sektion-titel">⚔️ Gesehene Attacken</div>
                                <table class="attacken-tabelle">
                                    <thead>
                                        <tr><th>Name</th><th>Typ</th><th>Stärke</th><th>Treffer</th><th>AP</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var atkId in geseheneAtkIds)
                                        {
                                            var ad2 = Game.AlleAttacken.FirstOrDefault(a => a.Id == atkId);
                                            @if (ad2 != null)
                                            {
                                                string tf2 = TypeChart.TypFarben.GetValueOrDefault(ad2.Typ, "#888");
                                                <tr>
                                                    <td>@ad2.Name</td>
                                                    <td><span class="attacke-typ-badge-dex" style="background:@tf2">@TypeChart.TypEmojis.GetValueOrDefault(ad2.Typ,"") @ad2.Typ</span></td>
                                                    <td class="attacke-wert">@(ad2.Staerke > 0 ? ad2.Staerke.ToString() : "—")</td>
                                                    <td class="attacke-wert">@(ad2.Genauigkeit.HasValue ? $"{ad2.Genauigkeit}%" : "—")</td>
                                                    <td class="attacke-wert">@ad2.Ap</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                                <p style="font-size:0.72rem;color:var(--text-dunkel);margin-top:0.4rem;font-style:italic">⚠️ Nur die im Kampf gesehenen Attacken. Fange es für alle Attacken!</p>
                            </div>
                        }
                    }

                    @if (istGefangen2)
                    {
                    <!-- Basiswerte (nur bei gefangen) -->
                    <div class="detail-sektion">
                        <div class="detail-sektion-titel">📊 Basiswerte</div>
                        @foreach (var stat in ausgewähltMon.Stats)
                        {
                            string statName = stat.Key switch
                            {
                                "kp"                  => "KP",
                                "angriff"             => "Angriff",
                                "verteidigung"        => "Verteidigung",
                                "spezialangriff"      => "Sp.Angriff",
                                "spezialverteidigung" => "Sp.Verteidigung",
                                "initiative"          => "Initiative",
                                _                     => stat.Key
                            };
                            int pct = (int)((float)stat.Value / 255f * 100);
                            string statFarbe = stat.Value >= 100 ? "#4CAF50"
                                             : stat.Value >= 70  ? "#8BC34A"
                                             : stat.Value >= 50  ? "#FFC107"
                                             : "#F44336";
                            <div class="stat-zeile-dex">
                                <span class="stat-label-dex">@statName</span>
                                <span class="stat-wert-dex">@stat.Value</span>
                                <div class="stat-balken-bg-dex">
                                    <div class="stat-balken-dex" style="width:@pct%;background:@statFarbe"></div>
                                </div>
                            </div>
                        }
                        <div style="font-size:0.72rem;color:var(--text-dunkel);text-align:right;margin-top:0.3rem">
                            Gesamt: <strong style="color:var(--text-hell)">@ausgewähltMon.Stats.Values.Sum()</strong>
                        </div>
                    </div>

                    <!-- Attacken (alle lernbaren) -->
                    <div class="detail-sektion">
                        <div class="detail-sektion-titel">⚔️ Lernbare Attacken</div>
                        <table class="attacken-tabelle">
                            <thead>
                                <tr>
                                    <th>Lv.</th>
                                    <th>Name</th>
                                    <th>Typ</th>
                                    <th>Stärke</th>
                                    <th>Treffer</th>
                                    <th>AP</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var eintrag in ausgewähltMon.Attacken.OrderBy(a => a.Level))
                                {
                                    var ad = Game.AlleAttacken.FirstOrDefault(a => a.Id == eintrag.AttackeId);
                                    @if (ad != null)
                                    {
                                        string tf = TypeChart.TypFarben.GetValueOrDefault(ad.Typ, "#888");
                                        <tr>
                                            <td><span class="attacke-level-badge">@eintrag.Level</span></td>
                                            <td>@ad.Name</td>
                                            <td>
                                                <span class="attacke-typ-badge-dex" style="background:@tf">
                                                    @TypeChart.TypEmojis.GetValueOrDefault(ad.Typ,"") @ad.Typ
                                                </span>
                                            </td>
                                            <td class="attacke-wert">@(ad.Staerke > 0 ? ad.Staerke.ToString() : "—")</td>
                                            <td class="attacke-wert">@(ad.Genauigkeit.HasValue ? $"{ad.Genauigkeit}%" : "—")</td>
                                            <td class="attacke-wert">@ad.Ap</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    } <!-- Ende istGefangen2 Block -->

                    <!-- Entwicklung -->
                    var entwicklungData = !string.IsNullOrEmpty(ausgewähltMon.EntwickeltZu) ? Game.AlleMonster.FirstOrDefault(m => m.Id == ausgewähltMon.EntwickeltZu) : null;
                    var vorstufe = Game.AlleMonster.FirstOrDefault(m => m.EntwickeltZu == ausgewähltMon.Id);
                    <div class="detail-sektion">
                        <div class="detail-sektion-titel">🔄 Entwicklung</div>
                        <div class="entwicklung-kette">
                            @if (vorstufe != null)
                            {
                                bool vsGefangen = IstGefangen(vorstufe.Id);
                                <div class="entwicklung-stufe" @onclick="() => AuswaehlenKlick(vorstufe)">
                                    @if (vsGefangen)
                                    {
                                        <img class="entwicklung-bild" src="@vorstufe.Bild" alt="@vorstufe.Name" />
                                    }
                                    else
                                    {
                                        <div style="width:48px;height:48px;display:flex;align-items:center;justify-content:center;font-size:1.6rem;opacity:0.4">❓</div>
                                    }
                                    <span class="entwicklung-name">@(vsGefangen ? vorstufe.Name : "???")</span>
                                </div>
                                <div class="entwicklung-pfeil">
                                    <span>→</span>
                                    @if (vorstufe.EntwicklungLevel.HasValue)
                                    {
                                        <span class="entwicklung-level">Lv.@vorstufe.EntwicklungLevel</span>
                                    }
                                </div>
                            }

                            <!-- Aktuelles Monster -->
                            <div class="entwicklung-stufe aktuell">
                                <img class="entwicklung-bild" src="@ausgewähltMon.Bild" alt="@ausgewähltMon.Name" />
                                <span class="entwicklung-name">@ausgewähltMon.Name</span>
                            </div>

                            @if (entwicklungData != null)
                            {
                                bool e1Gefangen = IstGefangen(entwicklungData.Id);
                                <div class="entwicklung-pfeil">
                                    <span>→</span>
                                    @if (ausgewähltMon.EntwicklungLevel.HasValue)
                                    {
                                        <span class="entwicklung-level">Lv.@ausgewähltMon.EntwicklungLevel</span>
                                    }
                                </div>
                                <div class="entwicklung-stufe" @onclick="() => AuswaehlenKlick(entwicklungData)">
                                    @if (e1Gefangen)
                                    {
                                        <img class="entwicklung-bild" src="@entwicklungData.Bild" alt="@entwicklungData.Name" />
                                    }
                                    else
                                    {
                                        <div style="width:48px;height:48px;display:flex;align-items:center;justify-content:center;font-size:1.6rem;opacity:0.4">❓</div>
                                    }
                                    <span class="entwicklung-name">@(e1Gefangen ? entwicklungData.Name : "???")</span>
                                </div>

                                @if (!string.IsNullOrEmpty(entwicklungData.EntwickeltZu))
                                {
                                    var entwicklung2 = Game.AlleMonster.FirstOrDefault(m => m.Id == entwicklungData.EntwickeltZu);
                                    @if (entwicklung2 != null)
                                    {
                                        bool e2Gefangen = IstGefangen(entwicklung2.Id);
                                        <div class="entwicklung-pfeil">
                                            <span>→</span>
                                            @if (entwicklungData.EntwicklungLevel.HasValue)
                                            {
                                                <span class="entwicklung-level">Lv.@entwicklungData.EntwicklungLevel</span>
                                            }
                                        </div>
                                        <div class="entwicklung-stufe" @onclick="() => AuswaehlenKlick(entwicklung2)">
                                            @if (e2Gefangen)
                                            {
                                                <img class="entwicklung-bild" src="@entwicklung2.Bild" alt="@entwicklung2.Name" />
                                            }
                                            else
                                            {
                                                <div style="width:48px;height:48px;display:flex;align-items:center;justify-content:center;font-size:1.6rem;opacity:0.4">❓</div>
                                            }
                                            <span class="entwicklung-name">@(e2Gefangen ? entwicklung2.Name : "???")</span>
                                        </div>
                                    }
                                }
                            }
                            else if (vorstufe == null)
                            {
                                <span style="font-size:0.78rem;color:var(--text-dunkel);font-style:italic">Keine Entwicklung</span>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <!-- Nicht gesehen: Nichts bekannt -->
                    <div class="detail-sektion">
                        <p class="noch-nicht-gefangen">
                            ❓ Dieses Monster wurde noch nicht entdeckt.<br />
                            Erkunde die Welt um es zu finden!
                        </p>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private string suchText = "";
    private string filterTyp = "";
    private bool nurGefangen = false;
    private HashSet<string> ausgewählteRegionen = new();
    private string? ausgewähltId = null;
    private MonsterData? ausgewähltMon = null;
    private HashSet<string> gefangeneIds = new();
    private int gefangenCount = 0;
    private HashSet<string> monsterAufKarte = new();

    private record RegionInfo(string Name, string Emoji, int Von, int Bis);
    private static readonly Dictionary<string, RegionInfo> AlleRegionen = new()
    {
        { "gen1", new("Kanto",   "🔴", 1,   151) },
        { "gen2", new("Johto",   "🟡", 152, 251) },
        { "gen3", new("Hoenn",   "🟢", 252, 386) },
        { "gen4", new("Sinnoh",  "🔵", 387, 493) },
        { "gen5", new("Einall",  "⚫", 494, 649) },
        { "gen6", new("Kalos",   "🔷", 650, 721) },
        { "gen7", new("Alola",   "🌺", 722, 809) },
        { "gen8", new("Galar",   "🏴", 810, 905) },
        { "gen9", new("Paldea",  "🟠", 906, 1025) },
    };

    protected override void OnInitialized()
    {
        Game.OnChange += AktualisierenUndNeuzeichnen;
        AktualisierenGefangen();
        AktualisierenKartenMonster();
        AutoRegionVorauswaehlen();
    }

    public void Dispose() => Game.OnChange -= AktualisierenUndNeuzeichnen;

    private void AktualisierenUndNeuzeichnen()
    {
        AktualisierenGefangen();
        StateHasChanged();
    }

    private void AktualisierenGefangen()
    {
        gefangeneIds = new HashSet<string>(
            Game.Spieler.Team.Select(m => m.SpeziesId)
            .Concat(Game.Spieler.Box.Select(m => m.SpeziesId))
        );
        gefangenCount = Game.AlleMonster.Count(m => gefangeneIds.Contains(m.Id));
    }

    private void AktualisierenKartenMonster()
    {
        monsterAufKarte = new HashSet<string>(
            Game.AlleOrte.SelectMany(o => o.WildMonster.Select(wm => wm.MonsterId))
        );
    }

    private void AutoRegionVorauswaehlen()
    {
        var regionenMitKartenMonster = AlleRegionen
            .Where(r => monsterAufKarte.Any(id => {
                int nr = GetNummer(id);
                return nr >= r.Value.Von && nr <= r.Value.Bis;
            }))
            .Select(r => r.Key)
            .ToHashSet();

        ausgewählteRegionen = regionenMitKartenMonster.Count > 0
            ? regionenMitKartenMonster
            : new HashSet<string> { "gen1" };
    }

    private bool RegionVerfügbar(string regionKey)
    {
        var r = AlleRegionen[regionKey];
        return monsterAufKarte.Any(id => {
            int nr = GetNummer(id);
            return nr >= r.Von && nr <= r.Bis;
        });
    }

    private void RegionToggle(string regionKey)
    {
        if (ausgewählteRegionen.Contains(regionKey))
            ausgewählteRegionen.Remove(regionKey);
        else
            ausgewählteRegionen.Add(regionKey);
    }

    private void FilterZuruecksetzen()
    {
        suchText = "";
        filterTyp = "";
        nurGefangen = false;
        AutoRegionVorauswaehlen();
    }

    private bool IstGefangen(string monsterId) => gefangeneIds.Contains(monsterId);
    private bool IstGesehen(string monsterId) => Game.Spieler.GeseheneMonster.Contains(monsterId);
    private bool IstImTeam(string monsterId) => Game.Spieler.Team.Any(m => m.SpeziesId == monsterId);

    private int GetNummer(string id)
    {
        if (id.StartsWith("PKM-") && int.TryParse(id[4..], out int nr)) return nr;
        int idx = Game.AlleMonster.FindIndex(m => m.Id == id);
        return idx >= 0 ? idx + 1 : 0;
    }

    private string GetRegionName(int nr) => AlleRegionen
        .FirstOrDefault(r => nr >= r.Value.Von && nr <= r.Value.Bis)
        .Value?.Name ?? "Unbekannt";

    private List<string> GetFundorte(string monsterId) =>
        Game.AlleOrte
            .Where(o => o.WildMonster.Any(wm => wm.MonsterId == monsterId))
            .Select(o => o.Name)
            .Distinct()
            .OrderBy(n => n)
            .ToList();

    private IEnumerable<MonsterData> GefilterteMonster()
    {
        var liste = Game.AlleMonster.AsEnumerable();

        if (ausgewählteRegionen.Any())
        {
            liste = liste.Where(m => {
                int nr = GetNummer(m.Id);
                return ausgewählteRegionen.Any(rk => {
                    var r = AlleRegionen[rk];
                    return nr >= r.Von && nr <= r.Bis;
                });
            });
        }

        if (!string.IsNullOrWhiteSpace(suchText))
        {
            string suche = suchText.Trim().ToLower();
            liste = liste.Where(m =>
                m.Name.ToLower().Contains(suche) ||
                GetNummer(m.Id).ToString() == suche ||
                GetNummer(m.Id).ToString("D3") == suche);
        }

        if (!string.IsNullOrEmpty(filterTyp))
            liste = liste.Where(m => m.Typen.Contains(filterTyp));

        if (nurGefangen)
            liste = liste.Where(m => IstGefangen(m.Id));

        return liste;
    }

    private void AuswaehlenKlick(MonsterData mon)
    {
        ausgewähltId = mon.Id;
        ausgewähltMon = mon;
    }
}
