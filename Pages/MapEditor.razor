    // ─── Markt-Item Verwaltung ────────────────────────────────────────────────
    private bool marktItemAuswahlOffen = false;
    private string itemSuche = "";
    private string neuesItemName = "";
    private int neuesItemPreis = 200;
    private string neuesItemEmoji = "📦";
    private string neuesItemKategorie = "Heilung";
    private string neuesItemBeschreibung = "";
    private string neuesItemWoBekommt = "";
    private static int _itemZähler = 200;

    private List<ShopItem> _alleItemsCache = new();
    private List<ShopItem> AlleItemsGefiltert => _alleItemsCache
        .Where(i => string.IsNullOrEmpty(itemSuche) ||
                    i.Name.Contains(itemSuche, StringComparison.OrdinalIgnoreCase) ||
                    i.Kategorie.Contains(itemSuche, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private void MarktItemAuswahlÖffnen()
    {
        _alleItemsCache = WeltData.AlleItems();
        itemSuche = "";
        marktItemAuswahlOffen = true;
    }

    private void ItemAuswahlBestätigen(Ort ort, ShopItem item)
    {
        if (!ort.MarktAngebot.Any(x => x.Id == item.Id))
        {
            ort.MarktAngebot.Add(new ShopItem
            {
                Id = item.Id,
                Name = item.Name,
                Beschreibung = item.Beschreibung,
                Preis = item.Preis,
                Emoji = item.Emoji,
                Kategorie = item.Kategorie,
                WoBekommt = item.WoBekommt
            });
            Speichern();
        }
        marktItemAuswahlOffen = false;
    }

    private void NeuesItemErstellen(Ort ort)
    {
        if (string.IsNullOrWhiteSpace(neuesItemName)) return;
        _itemZähler++;
        var neues = new ShopItem
        {
            Id = $"item-custom-{_itemZähler}",
            Name = neuesItemName.Trim(),
            Beschreibung = neuesItemBeschreibung.Trim(),
            Preis = neuesItemPreis,
            Emoji = string.IsNullOrEmpty(neuesItemEmoji) ? "📦" : neuesItemEmoji,
            Kategorie = neuesItemKategorie,
            WoBekommt = string.IsNullOrEmpty(neuesItemWoBekommt) ? "Hier" : neuesItemWoBekommt
        };
        ort.MarktAngebot.Add(neues);
        // Felder zurücksetzen
        neuesItemName = "";
        neuesItemBeschreibung = "";
        neuesItemPreis = 200;
        neuesItemEmoji = "📦";
        neuesItemWoBekommt = "";
        Speichern();
    }

    private string SperreBeschreibung(Ort ort)
    {
        var teile = new List<string>();
        if (ort.LigaZugang) teile.Add("🏆 Liga-Zugang (alle 8 Orden)");
        else if (ort.MinOrdenFürZugang > 0) teile.Add($"🏅 Min. {ort.MinOrdenFürZugang} Orden");
        if (!string.IsNullOrEmpty(ort.BenötigtItem)) teile.Add($"📦 Benötigt: {ort.BenötigtItem}");
        if (!string.IsNullOrEmpty(ort.BenötigtItemQuelle)) teile.Add($"📍 Wo: {ort.BenötigtItemQuelle}");
        if (ort.MaxOrdenFürSperre > 0) teile.Add($"🔒 Gesperrt bis Orden {ort.MaxOrdenFürSperre}");
        return teile.Any() ? string.Join(" | ", teile) : "Kein Zugangsschutz";
    }

