                                        <input class="editor-input" value="@tr.Dialogvor"
                                               @onchange="e => { tr.Dialogvor = e.Value?.ToString() ?? tr.Dialogvor; Speichern(); }" />
                                    </div>
                                    <div class="editor-field editor-field-voll">
                                        <label>Dialog (nach Kampf)</label>
                                        <input class="editor-input" value="@tr.DialogNach"
                                               @onchange="e => { tr.DialogNach = e.Value?.ToString() ?? tr.DialogNach; Speichern(); }" />
                                    </div>
                                    <div class="editor-sub-section">
                                        <div class="editor-sub-title">Team</div>
                                        @foreach (var te in tr.Team.ToList())
                                        {
                                            var t2 = te;
                                            <div class="editor-team-eintrag">
                                                <input class="editor-input editor-input-id" placeholder="PKM-ID"
                                                       value="@t2.MonsterId"
                                                       @onchange="ev => { t2.MonsterId = ev.Value?.ToString() ?? t2.MonsterId; Speichern(); }" />
                                                <span class="editor-label-klein">Lv.</span>
                                                <input class="editor-input editor-input-klein" type="number" min="1" max="100"
                                                       value="@t2.Level"
                                                       @onchange="ev => { if(int.TryParse(ev.Value?.ToString(), out int v)) { t2.Level = v; Speichern(); } }" />
                                                <button class="btn-row-loeschen"
                                                        @onclick="() => { tr.Team.Remove(t2); Speichern(); }">✕</button>
                                            </div>
                                        }
                                        <button class="btn-row-add"
                                                @onclick="() => TrainerMonsterHinzufügen(tr)">
                                            ＋ Monster
                                        </button>
                                    </div>
                                    <button class="btn-trainer-loeschen"
                                            @onclick="() => { ort.Trainer.Remove(tr); offeneTrainer.Remove(tr.Id); Speichern(); }">
                                        🗑️ Trainer löschen
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>

            </div>
        }
        else
        {
            <div class="editor-leer-hinweis">
                <span class="editor-leer-icon">🗺️</span>
                <p>Wähle einen Ort aus der Liste</p>
                <p class="editor-leer-sub">oder klicke auf eine Zelle im Grid</p>
            </div>
        }
    </div>

</div>

<!-- Toolbar unten -->
<div class="editor-toolbar">
    <button class="btn-toolbar" @onclick="AllesZurücksetzen">🔄 Zurücksetzen</button>
    <button class="btn-toolbar btn-export" @onclick="ExportierenAsync">⬇️ JSON exportieren</button>
    <label class="btn-toolbar btn-import">
        📂 JSON importieren
        <InputFile OnChange="ImportierenAsync" accept=".json" style="display:none" />
    </label>
    <span class="editor-toolbar-info">💾 Änderungen werden automatisch im Browser gespeichert</span>
</div>

<!-- ═══ Handy-Popup: Ort-Auswahl für Grid-Zelle ══════════════════════════ -->
@if (popupOffen)
{
    <div class="editor-popup-overlay" @onclick="PopupSchliessen">
        <div class="editor-popup" @onclick:stopPropagation="true">
            <div class="editor-popup-header">
                <span>📍 Ort für Zelle (@popupCol, @popupRow) wählen</span>
                <button class="btn-schliessen" @onclick="PopupSchliessen">✕</button>
            </div>
            <div class="editor-popup-search">
                <input class="editor-search-input" placeholder="🔍 Suchen..."
                       @bind="popupSuche" @bind:event="oninput" />
            </div>
            <div class="editor-popup-liste">
                <!-- Leer-Option -->
                <div class="editor-popup-eintrag editor-popup-leer"
                     @onclick="() => PopupOrtWählen(null)">
                    <span>🚫 Leer lassen</span>
                </div>
                @foreach (var o in PopupGefilterteOrte)
                {
                    var po = o;
                    bool platziert = po.GridX >= 0;
                    <div class="editor-popup-eintrag @(platziert ? "popup-platziert" : "popup-frei")"
                         @onclick="() => PopupOrtWählen(po)">
                        <span class="popup-dot" style="background:@WeltData.OrtFarben.GetValueOrDefault(po.Farbe, "#374151")">@OrtIcon(po)</span>
                        <div class="popup-info">
                            <span class="popup-name">@po.Name</span>
                            <span class="popup-id">@po.Id @(platziert ? $"· ({po.GridX},{po.GridY})" : "· noch nicht platziert")</span>
                        </div>
                        <span class="popup-status-dot @(platziert ? "dot-grau" : "dot-gruen")">●</span>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- ═══ Modal: Neuen Ort erstellen ══════════════════════════════════════ -->
@if (neuOrtModalOffen)
{
    <div class="editor-popup-overlay" @onclick="NeuOrtModalSchliessen">
        <div class="editor-popup editor-neu-ort-modal" @onclick:stopPropagation="true">
            <div class="editor-popup-header">
                <span>＋ Neuen Ort erstellen</span>
                <button class="btn-schliessen" @onclick="NeuOrtModalSchliessen">✕</button>
            </div>
            <div class="editor-neu-ort-body">
                <div class="editor-field">
                    <label>Name</label>
                    <input class="editor-input" placeholder="z.B. Route 1" @bind="neuOrtName" />
                </div>
                <div class="editor-field">
                    <label>Typ</label>
                    <select class="editor-input" @bind="neuOrtTyp">
                        <option value="route">🌿 Route</option>
                        <option value="stadt">🏙️ Stadt</option>
                        <option value="hoehle">⛰️ Höhle</option>
                        <option value="wald">🌲 Wald</option>
                    </select>
                </div>
                <div class="editor-field">
                    <label>Region</label>
                    <select class="editor-input" @bind="neuOrtRegion">
                        @foreach (var kv in RegionNamen.Where(x => x.Key != "ALLE"))
                        {
                            <option value="@kv.Key">@kv.Value</option>
                        }
                    </select>
                </div>
                <div class="editor-field">
                    <label>Kartenfarbe</label>
                    <div class="editor-farb-auswahl">
                        @foreach (var kv in WeltData.OrtFarben)
                        {
                            <button class="farb-btn @(neuOrtFarbe == kv.Key ? "aktiv" : "")"
                                    style="background:@kv.Value"
                                    title="@kv.Key"
                                    @onclick="() => neuOrtFarbe = kv.Key">
                                @(neuOrtFarbe == kv.Key ? "✓" : "")
                            </button>
                        }
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(neuOrtFehler))
                {
                    <p class="editor-fehler-text">⚠️ @neuOrtFehler</p>
                }
            </div>
            <div class="editor-neu-ort-footer">
                <button class="btn-editor-abbrechen" @onclick="NeuOrtModalSchliessen">Abbrechen</button>
                <button class="btn-editor-erstellen" @onclick="NeuOrtErstellen">✓ Erstellen</button>
            </div>
        </div>
    </div>
}

@code {
    private List<Ort> editorOrte = new();
    private string? ausgewähltOrtId;
    private Ort? ausgewähltOrt;
    private string suchbegriff = "";
    private string filterTyp = "Alle";
    private string filterRegion = "KAN";
    private int gridZoom = 100;
    private int gridRows = 10;
    private int gridCols = 10;
    private HashSet<string> offeneTrainer = new();
    private string speicherStatus = "";
    private bool speicherFehler = false;
    // Rechte Spalte Toggle
    private bool rechtesSpalteOffen = true;

    // "Neuen Ort erstellen" Modal
    private bool neuOrtModalOffen = false;
    private string neuOrtName = "";
    private string neuOrtTyp = "route";
    private string neuOrtRegion = "KAN";
    private string neuOrtFarbe = "green";
    private string neuOrtFehler = "";

    // Popup-Zustand
    private bool popupOffen = false;
    private int popupCol = 0;
    private int popupRow = 0;
    private string popupSuche = "";

    // Drag & Drop Zustand
    private string? dragOrtId = null;
    private int dragOverCol = -1;
    private int dragOverRow = -1;

    private static readonly Dictionary<string, string> RegionNamen = new()
    {
        { "ALLE", "🌍 Alle" }, { "KAN", "🔴 Kanto" }, { "JOH", "🟡 Johto" },
        { "HOE", "🔵 Hoenn" }, { "SIN", "⚪ Sinnoh" }, { "UNG", "⚫ Einall" },
        { "KAL", "🟣 Kalos" }, { "ALO", "🟠 Alola" }, { "GAL", "🟢 Galar" }, { "PAL", "🟤 Paldea" }
    };

    private IEnumerable<Ort> GefilterteOrte => editorOrte
        .Where(o => (filterRegion == "ALLE" || o.Id.StartsWith(filterRegion + "-")) &&
                    (filterTyp == "Alle" || o.Typ == filterTyp) &&
                    (string.IsNullOrEmpty(suchbegriff) ||
                     o.Name.Contains(suchbegriff, StringComparison.OrdinalIgnoreCase) ||
                     o.Id.Contains(suchbegriff, StringComparison.OrdinalIgnoreCase)))
        .OrderBy(o => o.GridX >= 0 ? 1 : 0) // Unplatzierte zuerst
        .ThenBy(o => o.Name);

    private IEnumerable<Ort> PopupGefilterteOrte => editorOrte
        .Where(o => (filterRegion == "ALLE" || o.Id.StartsWith(filterRegion + "-")) &&
                    (string.IsNullOrEmpty(popupSuche) ||
                     o.Name.Contains(popupSuche, StringComparison.OrdinalIgnoreCase) ||
                     o.Id.Contains(popupSuche, StringComparison.OrdinalIgnoreCase)))
        .OrderBy(o => o.GridX >= 0 ? 1 : 0) // Unplatzierte zuerst
        .ThenBy(o => o.Name);

    // Aktuelle Daten-Version – bei neuer weltkarte_import.json hier anpassen
    private const string DatenVersion = "verbindung_v3";

    protected override async Task OnInitializedAsync()
    {
        Game.OnChange += StateHasChanged;

        // Versions-Check: wenn gespeicherte Version != aktuelle Version → neu laden
        var gespeicherteVersion = await Storage.GetItemAsync("editor_orte_version");
        bool versionAktuell = gespeicherteVersion == DatenVersion;

        if (versionAktuell)
        {
            var json = await Storage.GetItemAsync("editor_orte");
            if (!string.IsNullOrEmpty(json))
            {
                try
                {
                    var geladen = System.Text.Json.JsonSerializer.Deserialize<List<Ort>>(json,
                        new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                    if (geladen?.Any() == true) { editorOrte = geladen; return; }
                }
                catch { }
            }
        }

        // Neue Daten per HTTP laden (funktioniert in Blazor WASM / GitHub Pages)
        try
        {
            var opts = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var geladen = await Http.GetFromJsonAsync<List<Ort>>("assets/daten/weltkarte_import.json", opts);
            if (geladen?.Any() == true) editorOrte = geladen;
        }
        catch
        {
            editorOrte = WeltData.AlleOrte();
        }
        // Version im LocalStorage merken
        await Storage.SetItemAsync("editor_orte_version", DatenVersion);
        // Neue Daten sofort speichern damit sie beim nächsten Start verfügbar sind
        var neuesJson = System.Text.Json.JsonSerializer.Serialize(editorOrte,
            new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = null });
        await Storage.SetItemAsync("editor_orte", neuesJson);
    }

    public void Dispose() => Game.OnChange -= StateHasChanged;

    private void OrtAuswählen(string id)
    {
        ausgewähltOrtId = id;
        ausgewähltOrt = editorOrte.FirstOrDefault(o => o.Id == id);
    }

    private void GridZelleKlick(int col, int row)
    {
        var ort = editorOrte.FirstOrDefault(o =>
            o.GridX == col && o.GridY == row &&
            (filterRegion == "ALLE" || o.Id.StartsWith(filterRegion + "-")));

        if (ort != null)
        {
            OrtAuswählen(ort.Id);
        }
        else if (ausgewähltOrt != null && ausgewähltOrt.GridX < 0)
        {
            // Direkt platzieren wenn Ort ausgewählt und noch nicht platziert
            ausgewähltOrt.GridX = col;
            ausgewähltOrt.GridY = row;
            Speichern();
        }
        else
        {
            // Popup öffnen für Handy-Auswahl
            popupCol = col;
            popupRow = row;
            popupSuche = "";
            popupOffen = true;
        }
    }

    private void PopupSchliessen() => popupOffen = false;

    private void PopupOrtWählen(Ort? gewählt)
    {
        if (gewählt == null)
        {
            // Leer lassen: vorhandenen Ort von dieser Zelle entfernen
            var vorhandener = editorOrte.FirstOrDefault(o =>
                o.GridX == popupCol && o.GridY == popupRow);
            if (vorhandener != null)
            {
                vorhandener.GridX = -1;
                vorhandener.GridY = -1;
                Speichern();
            }
        }
        else
        {
            // Ort auf diese Zelle setzen (ggf. vorherige Position überschreiben)
            gewählt.GridX = popupCol;
            gewählt.GridY = popupRow;
            OrtAuswählen(gewählt.Id);
            Speichern();
        }
        popupOffen = false;
    }

    // ─── Drag & Drop ─────────────────────────────────────────────────────────
    private void DragStart(string ortId)
    {
        dragOrtId = ortId;
        dragOverCol = -1;
        dragOverRow = -1;
    }

    private void DragEnd()
    {
        dragOrtId = null;
        dragOverCol = -1;
        dragOverRow = -1;
    }

    private void DragDrop(int col, int row)
    {
        if (dragOrtId == null) return;
        var gezogen = editorOrte.FirstOrDefault(o => o.Id == dragOrtId);
        if (gezogen == null) { DragEnd(); return; }

        // Prüfen ob Zielzelle schon belegt ist
        var vorhandener = editorOrte.FirstOrDefault(o =>
            o.GridX == col && o.GridY == row &&
            (filterRegion == "ALLE" || o.Id.StartsWith(filterRegion + "-")));

        if (vorhandener != null && vorhandener.Id != gezogen.Id)
        {
            // Swap: vorhandenen Ort auf die alte Position des gezogenen setzen
            int altX = gezogen.GridX;
            int altY = gezogen.GridY;
            vorhandener.GridX = altX;
            vorhandener.GridY = altY;
        }

        gezogen.GridX = col;
        gezogen.GridY = row;
        OrtAuswählen(gezogen.Id);
        DragEnd();
        Speichern();
    }

    /// <summary>Synchronisiert Verbindungen-Liste aus den Richtungsfeldern + Teleport + Untergrund</summary>
    private void SyncVerbindungen(Ort ort)
    {
        var neu = new List<string>();
        if (!string.IsNullOrEmpty(ort.Nord)) neu.Add(ort.Nord);
        if (!string.IsNullOrEmpty(ort.Sued)) neu.Add(ort.Sued);
        if (!string.IsNullOrEmpty(ort.Ost)) neu.Add(ort.Ost);
        if (!string.IsNullOrEmpty(ort.West)) neu.Add(ort.West);
        if (!string.IsNullOrEmpty(ort.Untergrund)) neu.Add(ort.Untergrund);
        if (!string.IsNullOrEmpty(ort.Teleport)) neu.Add(ort.Teleport);
        ort.Verbindungen = neu.Distinct().ToList();
    }

    private void NeuOrtModalOeffnen()
    {
        // Vorauswahl: aktuelle Region (falls nicht ALLE)
        neuOrtRegion = filterRegion == "ALLE" ? "KAN" : filterRegion;
        neuOrtName = "";
        neuOrtTyp = "route";
        neuOrtFarbe = "green";
        neuOrtFehler = "";
        neuOrtModalOffen = true;
    }

    private void NeuOrtModalSchliessen()
    {
        neuOrtModalOffen = false;
        neuOrtFehler = "";
    }

    private void NeuOrtErstellen()
    {
        var name = neuOrtName.Trim();
        if (string.IsNullOrEmpty(name))
        {
            neuOrtFehler = "Bitte einen Namen eingeben.";
            return;
        }
        // Neue ID generieren: REGION-XXXX (nächste freie Nummer)
        var prefix = neuOrtRegion;
        var vorhandeneNummern = editorOrte
            .Where(o => o.Id.StartsWith(prefix + "-"))
            .Select(o => {
                var teil = o.Id.Substring(prefix.Length + 1);
                return int.TryParse(teil, out int n) ? n : 0;
            })
            .ToHashSet();
        int naechste = 1;
        while (vorhandeneNummern.Contains(naechste)) naechste++;
        var neueId = $"{prefix}-{naechste:D4}";
        var neuer = new Ort
        {
            Id = neueId,
            Name = name,
            Typ = neuOrtTyp,
            Farbe = neuOrtFarbe,
            GridX = -1,
            GridY = -1,
            Beschreibung = "",
        };
        editorOrte.Add(neuer);
        // Region-Filter auf die neue Region setzen
        filterRegion = neuOrtRegion;
        OrtAuswählen(neueId);
        neuOrtModalOffen = false;
        neuOrtFehler = "";
        Speichern();
    }

    private void OrtKopieren()
    {
        if (ausgewähltOrt == null) return;
        var quelle = ausgewähltOrt;

        // Basis-Name ermitteln: "Route 1" → "Route 1", "Route 1.1" → "Route 1", "Route 1.2" → "Route 1"
        string basisName = quelle.Name;
        // Entferne bestehenden .N-Suffix
        var dotIdx = basisName.LastIndexOf('.');
        if (dotIdx >= 0 && int.TryParse(basisName[(dotIdx + 1)..], out _))
            basisName = basisName[..dotIdx];

        // Nächste freie Nummer finden (.1, .2, .3, ...)
        int nr = 1;
        while (editorOrte.Any(o => o.Name == $"{basisName}.{nr}"))
            nr++;
        string neuerName = $"{basisName}.{nr}";

        // Neue ID generieren: gleiche Region, nächste freie Nummer
        string region = quelle.Id.Contains('-') ? quelle.Id.Split('-')[0] : "KAN";
        var regionOrte = editorOrte.Where(o => o.Id.StartsWith(region + "-")).ToList();
        int maxNr = regionOrte
            .Select(o => { var t = o.Id.Split('-'); return t.Length > 1 && int.TryParse(t[1], out int n) ? n : 0; })
            .DefaultIfEmpty(0).Max();
        string neueId = $"{region}-{(maxNr + 1):D4}";

        // Deep-Copy aller Felder außer Verbindungen und Grid-Position
        var kopie = new Ort
        {
            Id         = neueId,
            Name       = neuerName,
            Typ        = quelle.Typ,
            Farbe      = quelle.Farbe,
            GridX      = -1,  // noch nicht platziert
            GridY      = -1,
            Beschreibung = quelle.Beschreibung,
            HatMonsterCenter = quelle.HatMonsterCenter,
            HatMarkt   = quelle.HatMarkt,
            MinOrdenFürZugang = quelle.MinOrdenFürZugang,
            MaxOrdenFürSperre = quelle.MaxOrdenFürSperre,
            BenötigtItem      = quelle.BenötigtItem,
            BenötigtItemName  = quelle.BenötigtItemName,
            BenötigtItemQuelle = quelle.BenötigtItemQuelle,
            IstUnterirdisch   = quelle.IstUnterirdisch,
            LigaZugang        = quelle.LigaZugang,
            // Verbindungen NICHT übernehmen
            WildMonster = quelle.WildMonster.Select(w => new WildBegegnung
            {
                MonsterId = w.MonsterId,
                MinLevel  = w.MinLevel,
                MaxLevel  = w.MaxLevel,
                Chance    = w.Chance
            }).ToList(),
            MarktAngebot = quelle.MarktAngebot.Select(m => new ShopItem
            {
                Id           = m.Id,
                Name         = m.Name,
                Beschreibung = m.Beschreibung,
                Preis        = m.Preis,
                Emoji        = m.Emoji,
                Kategorie    = m.Kategorie,
                WoBekommt    = m.WoBekommt
            }).ToList(),
            Trainer = quelle.Trainer.Select(t => new TrainerKampf
            {
                Id        = $"{neueId}-T{quelle.Trainer.IndexOf(t) + 1}",
                Name      = t.Name,
                Klasse    = t.Klasse,
                Belohnung = t.Belohnung,
                Team      = t.Team.Select(m => new MonsterTeamEintrag
                {
                    MonsterId = m.MonsterId,
                    Level     = m.Level
                }).ToList()
            }).ToList(),
            NPCs = quelle.NPCs.Select(n => new GesprächsNPC
            {
                Id    = $"{neueId}-N{quelle.NPCs.IndexOf(n) + 1}",
                Name  = n.Name,
                Emoji = n.Emoji,
                Dialog = n.Dialog,
                GibtItemId     = n.GibtItemId,
                GibtItemName   = n.GibtItemName,
                GibtItemEmoji  = n.GibtItemEmoji,
                DialogNachGeschenk = n.DialogNachGeschenk
            }).ToList(),
            Arena = quelle.Arena == null ? null : new Arena
            {
                OrdenName          = quelle.Arena.OrdenName,
                OrdenNr            = quelle.Arena.OrdenNr,
                Leiter             = quelle.Arena.Leiter,
                TypSpezialisierung = quelle.Arena.TypSpezialisierung,
                Beschreibung       = quelle.Arena.Beschreibung,
                Team = quelle.Arena.Team.Select(m => new MonsterTeamEintrag
                {
                    MonsterId = m.MonsterId,
                    Level     = m.Level
                }).ToList()
            }
        };

        editorOrte.Add(kopie);
        OrtAuswählen(kopie.Id);
        Speichern();
    }

    private void OrtLöschen()
    {
        if (ausgewähltOrt == null) return;
        editorOrte.Remove(ausgewähltOrt);
        ausgewähltOrtId = null;
        ausgewähltOrt = null;
        Speichern();
    }

    private void TrainerToggle(string id)
    {
        if (offeneTrainer.Contains(id)) offeneTrainer.Remove(id);
        else offeneTrainer.Add(id);
    }

    private async void Speichern()
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(editorOrte,
                new System.Text.Json.JsonSerializerOptions { WriteIndented = false });
            await Storage.SetItemAsync("editor_orte", json);
            speicherStatus = "✓ Gespeichert";
            speicherFehler = false;
            StateHasChanged();
            await Task.Delay(2000);
            speicherStatus = "";
            StateHasChanged();
        }
        catch
        {
            speicherStatus = "⚠️ Fehler";
            speicherFehler = true;
            StateHasChanged();
        }
    }

    private async Task AllesZurücksetzen()
    {
        await Storage.RemoveItemAsync("editor_orte");
        editorOrte = WeltData.AlleOrte();
        ausgewähltOrtId = null;
        ausgewähltOrt = null;
        speicherStatus = "🔄 Zurückgesetzt";
        StateHasChanged();
        await Task.Delay(2000);
        speicherStatus = "";
    }

    private async Task ExportierenAsync()
    {
        var json = System.Text.Json.JsonSerializer.Serialize(editorOrte,
            new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        var bytes = System.Text.Encoding.UTF8.GetBytes(json);
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("eval",
            $"const a=document.createElement('a');a.href='data:application/json;base64,{base64}';a.download='weltkarte.json';a.click()");
    }

    private async Task ImportierenAsync(InputFileChangeEventArgs e)
    {
        try
        {
            using var stream = e.File.OpenReadStream(5 * 1024 * 1024);
            using var reader = new System.IO.StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            var geladen = System.Text.Json.JsonSerializer.Deserialize<List<Ort>>(json,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (geladen != null)
            {
                editorOrte = geladen;
                await Storage.SetItemAsync("editor_orte", json);
                speicherStatus = $"✅ {geladen.Count} Orte importiert!";
                StateHasChanged();
                await Task.Delay(3000);
                speicherStatus = "";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            speicherStatus = $"❌ {ex.Message}";
            speicherFehler = true;
        }
    }

