    /// <summary>Prüft ob zwei Orte zur gleichen Region gehören (anhand ID-Präfix vor dem Bindestrich)</summary>
    private bool SameRegion(Ort a, Ort b)
    {
        var prefixA = a.Id.Contains('-') ? a.Id.Split('-')[0] : a.Id;
        var prefixB = b.Id.Contains('-') ? b.Id.Split('-')[0] : b.Id;
        return prefixA == prefixB;
    }

