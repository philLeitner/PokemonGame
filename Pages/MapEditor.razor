@inject GameService Game
@inject LocalStorageService Storage
@inject IJSRuntime JS
@implements IDisposable

<div class="editor-screen">

    <!-- ═══ PANEL 1: Ortsliste ══════════════════════════════════════════════ -->
    <div class="editor-panel-left">
        <div class="editor-panel-header">
            <span class="editor-panel-title">🗺️ Orte</span>
            <button class="btn-editor-back" @onclick="Game.ZuWeltkarte" title="Zurück zur Weltkarte">✕</button>
        </div>

        <div class="editor-search-box">
            <span class="editor-search-icon">🔍</span>
            <input class="editor-search-input" placeholder="Suchen..."
                   @bind="suchbegriff" @bind:event="oninput" />
        </div>

        <!-- Region-Filter -->
        <div class="editor-region-row">
            <select class="editor-region-select" @bind="filterRegion">
                @foreach (var kv in RegionNamen)
                {
                    <option value="@kv.Key">@kv.Value</option>
                }
            </select>
        </div>

        <div class="editor-filter-row">
            @foreach (var typ in new[] { "Alle", "stadt", "route", "hoehle", "wald" })
            {
                <button class="editor-filter-btn @(filterTyp == typ ? "aktiv" : "")"
                        @onclick="() => filterTyp = typ" title="@typ">
                    @TypIcon(typ)
                </button>
            }
        </div>

        <!-- Legende Farbcodierung -->
        <div class="editor-liste-legende">
            <span class="legende-gruen">●</span> Noch nicht platziert
            <span class="legende-grau" style="margin-left:0.5rem">●</span> Auf Karte
        </div>

        <div class="editor-ort-liste">
            @foreach (var ort in GefilterteOrte)
            {
                bool platziert = ort.GridX >= 0;
                <div class="editor-ort-eintrag @(ausgewähltOrtId == ort.Id ? "aktiv" : "") @(platziert ? "platziert" : "unplatziert")"
                     @onclick="() => OrtAuswählen(ort.Id)">
                    <span class="editor-ort-color-dot"
                          style="background:@WeltData.OrtFarben.GetValueOrDefault(ort.Farbe, "#374151")">
                        @OrtIcon(ort)
                    </span>
                    <div class="editor-ort-info">
                        <span class="editor-ort-name">@ort.Name</span>

                    </div>
                    <div class="editor-ort-badges">
                        @if (ort.HatMonsterCenter) { <span title="Monster Center">🏥</span> }
                        @if (ort.HatMarkt) { <span title="Markt">🏪</span> }
                        @if (ort.Arena != null) { <span title="Arena">🏆</span> }
                        <span class="badge-platziert @(platziert ? "ja" : "nein")" title="@(platziert ? "Auf Karte platziert" : "Noch nicht platziert")">●</span>
                    </div>
                </div>
            }
        </div>

        <div class="editor-panel-footer">
            <button class="btn-editor-neu" @onclick="NeuenOrtErstellen">＋ Neuen Ort erstellen</button>
        </div>
    </div>

    <!-- ═══ PANEL 2: Karten-Grid ═══════════════════════════════════════════ -->
    <div class="editor-panel-mitte">
        <div class="editor-panel-header">
            <span class="editor-panel-title">@(RegionNamen.GetValueOrDefault(filterRegion, filterRegion)) – Grid</span>
            <div class="editor-grid-controls">
                <span class="grid-size-label">Zeilen:</span>
                <button class="btn-grid-ctrl" @onclick="() => gridRows = Math.Max(3, gridRows - 1)">−</button>
                <span class="grid-zoom-label">@gridRows</span>
                <button class="btn-grid-ctrl" @onclick="() => gridRows = Math.Min(25, gridRows + 1)">+</button>
                <span class="grid-size-label">Spalten:</span>
                <button class="btn-grid-ctrl" @onclick="() => gridCols = Math.Max(3, gridCols - 1)">−</button>
                <span class="grid-zoom-label">@gridCols</span>
                <button class="btn-grid-ctrl" @onclick="() => gridCols = Math.Min(25, gridCols + 1)">+</button>
                <span class="grid-size-label">Zoom:</span>
                <button class="btn-grid-ctrl" @onclick="() => gridZoom = Math.Max(60, gridZoom - 10)">−</button>
                <span class="grid-zoom-label">@gridZoom%</span>
                <button class="btn-grid-ctrl" @onclick="() => gridZoom = Math.Min(150, gridZoom + 10)">+</button>
            </div>
        </div>

        <div class="editor-grid-scroll">
            <div class="editor-grid" style="--cell-size: @(gridZoom * 0.8)px; grid-template-columns: repeat(@gridCols, var(--cell-size, 80px)); grid-template-rows: repeat(@gridRows, calc(var(--cell-size, 80px) * 0.7))">
                @for (int row = 0; row < gridRows; row++)
                {
                    @for (int col = 0; col < gridCols; col++)
                    {
                        int r = row, c = col;
                        var ort = editorOrte.FirstOrDefault(o =>
                            o.GridX == c && o.GridY == r &&
                            (filterRegion == "ALLE" || o.Id.StartsWith(filterRegion + "-")));
                        <div class="editor-grid-zelle @(ort != null ? "belegt" : "leer") @(ort?.Id == ausgewähltOrtId ? "aktiv" : "")"
                             style="grid-column: @(c+1); grid-row: @(r+1);"
                             @onclick="() => GridZelleKlick(c, r)"
                             title="@(ort != null ? ort.Name : $"Leer ({c},{r})")">
                            @if (ort != null)
                            {
                                <div class="editor-grid-knopf"
                                     style="background:@WeltData.OrtFarben.GetValueOrDefault(ort.Farbe, "#374151")">
                                    <span class="editor-grid-icon">@OrtIcon(ort)</span>
                                    <span class="editor-grid-name">@ort.Name</span>
                                </div>
                            }
                            else
                            {
                                <div class="editor-grid-leer">
                                    @if (ausgewähltOrt != null && ausgewähltOrt.GridX < 0)
                                    {
                                        <span class="grid-place-hint">+</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        <div class="editor-grid-legende">
            <span>🏙️ Stadt</span><span>🌿 Route</span><span>⛰️ Höhle</span><span>🌲 Wald</span>
            <span class="legende-sep">|</span>
            <span>🏥 Center</span><span>🏪 Markt</span><span>🏆 Arena</span>
            @if (ausgewähltOrt != null && ausgewähltOrt.GridX < 0)
            {
                <span class="legende-tipp">← Klicke eine leere Zelle um <strong>@ausgewähltOrt.Name</strong> zu platzieren</span>
            }
        </div>
    </div>

    <!-- ═══ PANEL 3: Detail-Editor ══════════════════════════════════════════ -->
    <div class="editor-panel-rechts @(ausgewähltOrt != null ? "sichtbar" : "versteckt")">
        @if (ausgewähltOrt != null)
        {
            var ort = ausgewähltOrt;
            <div class="editor-detail-header">
                <div>
                    <h3 class="editor-detail-titel">@ort.Name</h3>
                    <span class="editor-detail-id">@ort.Id</span>
                    @if (!string.IsNullOrEmpty(speicherStatus))
                    {
                        <span class="editor-save-badge @(speicherFehler ? "fehler" : "")">@speicherStatus</span>
                    }
                </div>
                <button class="btn-editor-loeschen" @onclick="OrtLöschen" title="Ort löschen">🗑️</button>
            </div>

            <div class="editor-detail-body">

                <!-- Basis-Daten -->
                <div class="editor-section">
                    <div class="editor-section-title">📋 Basis-Daten</div>
                    <div class="editor-field-grid">
                        <div class="editor-field">
                            <label>Name</label>
                            <input class="editor-input" value="@ort.Name"
                                   @onchange="e => { ort.Name = e.Value?.ToString() ?? ort.Name; Speichern(); }" />
                        </div>
                        <div class="editor-field">
                            <label>Typ</label>
                            <select class="editor-input" value="@ort.Typ"
                                    @onchange="e => { ort.Typ = e.Value?.ToString() ?? ort.Typ; Speichern(); }">
                                <option value="stadt">🏙️ Stadt</option>
                                <option value="route">🌿 Route</option>
                                <option value="hoehle">⛰️ Höhle</option>
                                <option value="wald">🌲 Wald</option>
                            </select>
                        </div>
                        <div class="editor-field">
                            <label>Kartenfarbe</label>
                            <select class="editor-input" value="@ort.Farbe"
                                    @onchange="e => { ort.Farbe = e.Value?.ToString() ?? ort.Farbe; Speichern(); }">
                                @foreach (var kv in WeltData.OrtFarben)
                                {
                                    <option value="@kv.Key">@kv.Key</option>
                                }
                            </select>
                        </div>
                        <div class="editor-field">
                            <label>Grid-Position (X , Y)</label>
                            <div class="editor-xy-row">
                                <input class="editor-input editor-input-klein" type="number" min="-1" max="9"
                                       value="@ort.GridX"
                                       @onchange="e => { if(int.TryParse(e.Value?.ToString(), out int v)) { ort.GridX = v; Speichern(); } }" />
                                <span class="xy-sep">,</span>
                                <input class="editor-input editor-input-klein" type="number" min="-1" max="9"
                                       value="@ort.GridY"
                                       @onchange="e => { if(int.TryParse(e.Value?.ToString(), out int v)) { ort.GridY = v; Speichern(); } }" />
                                @if (ort.GridX >= 0)
                                {
                                    <button class="btn-grid-entfernen" title="Von Karte entfernen"
                                            @onclick="() => { ort.GridX = -1; ort.GridY = -1; Speichern(); }">✕</button>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="editor-field editor-field-voll">
                        <label>Beschreibung</label>
                        <textarea class="editor-input editor-textarea" rows="2"
                                  @onchange="e => { ort.Beschreibung = e.Value?.ToString(); Speichern(); }">@ort.Beschreibung</textarea>
                    </div>
                </div>

                <!-- Einrichtungen -->
                <div class="editor-section">
                    <div class="editor-section-title">🏗️ Einrichtungen</div>
                    <div class="editor-toggle-row">
                        <label class="editor-toggle">
                            <input type="checkbox" checked="@ort.HatMonsterCenter"
                                   @onchange="e => { ort.HatMonsterCenter = (bool)(e.Value ?? false); Speichern(); }" />
                            <span class="toggle-slider"></span>
                            <span class="toggle-label">🏥 Monster Center</span>
                        </label>
                        <label class="editor-toggle">
                            <input type="checkbox" checked="@ort.HatMarkt"
                                   @onchange="e => { ort.HatMarkt = (bool)(e.Value ?? false); Speichern(); }" />
                            <span class="toggle-slider"></span>
                            <span class="toggle-label">🏪 Markt</span>
                        </label>
                    </div>
                </div>

                <!-- Markt-Items -->
                @if (ort.HatMarkt)
                {
                    <div class="editor-section">
                        <div class="editor-section-title-row">
                            <span class="editor-section-title">🏪 Markt-Angebot</span>
                            <button class="btn-section-add" @onclick="() => MarktItemAuswahlÖffnen()">
                                + Aus Datenbank
                            </button>
                        </div>
                        @if (!ort.MarktAngebot.Any())
                        {
                            <p class="editor-leer-text">Noch keine Items. Klicke "+ Aus Datenbank" oder erstelle unten ein neues Item.</p>
                        }
                        @foreach (var item in ort.MarktAngebot.ToList())
                        {
                            var it = item;
                            <div class="editor-markt-eintrag">
                                <span class="markt-emoji">@it.Emoji</span>
                                <div class="markt-info">
                                    <span class="markt-name">@it.Name</span>
                                    <span class="markt-preis">@it.Preis 💰</span>
                                </div>
                                <button class="btn-row-loeschen" @onclick="() => { ort.MarktAngebot.Remove(it); Speichern(); }">✕</button>
                            </div>
                        }
                        <!-- Item-Auswahl Panel -->
                        @if (marktItemAuswahlOffen)
                        {
                            <div class="editor-item-auswahl">
                                <div class="editor-item-auswahl-header">
                                    <span>📦 Item wählen</span>
                                    <button class="btn-schliessen" @onclick="() => marktItemAuswahlOffen = false">✕</button>
                                </div>
                                <input class="editor-search-input" placeholder="🔍 Suchen..." @bind="itemSuche" @bind:event="oninput" />
                                <div class="editor-item-liste">
                                    @foreach (var dbItem in AlleItemsGefiltert)
                                    {
                                        var di = dbItem;
                                        bool bereitsImMarkt = ort.MarktAngebot.Any(x => x.Id == di.Id);
                                        <div class="editor-item-eintrag" style="@(bereitsImMarkt ? "opacity:0.5" : "")" @onclick="() => ItemAuswahlBestätigen(ort, di)">
                                            <span class="markt-emoji">@di.Emoji</span>
                                            <div class="markt-info">
                                                <span class="markt-name">@di.Name @(bereitsImMarkt ? "✓" : "")</span>
                                                <span class="markt-preis">@di.Preis 💰 · @di.WoBekommt</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        <!-- Neues Item erstellen -->
                        <details class="editor-sub-section" style="margin-top:0.75rem">
                            <summary class="editor-sub-title" style="cursor:pointer">✏️ Neues Item erstellen</summary>
                            <div class="editor-field-grid" style="margin-top:0.5rem">
                                <div class="editor-field">
                                    <label>Name</label>
                                    <input class="editor-input" @bind="neuesItemName" placeholder="z.B. Ananassaft" />
                                </div>
                                <div class="editor-field">
                                    <label>Preis (💰)</label>
                                    <input class="editor-input editor-input-klein" type="number" min="0" @bind="neuesItemPreis" />
                                </div>
                                <div class="editor-field">
                                    <label>Emoji</label>
                                    <input class="editor-input editor-input-klein" @bind="neuesItemEmoji" placeholder="🍍" />
                                </div>
                                <div class="editor-field">
                                    <label>Kategorie</label>
                                    <select class="editor-input" @bind="neuesItemKategorie">
                                        <option value="Heilung">Heilung</option>
                                        <option value="Fangen">Fangen</option>
                                        <option value="Status">Status</option>
                                        <option value="Kampf">Kampf</option>
                                        <option value="Spezial">Spezial</option>
                                    </select>
                                </div>
                                <div class="editor-field" style="grid-column:span 2">
                                    <label>Beschreibung</label>
                                    <input class="editor-input" @bind="neuesItemBeschreibung" placeholder="Was macht das Item?" />
                                </div>
                                <div class="editor-field" style="grid-column:span 2">
                                    <label>Wo bekommt man es?</label>
                                    <input class="editor-input" @bind="neuesItemWoBekommt" placeholder="z.B. NPC in Prismania, nach Orden 3..." />
                                </div>
                            </div>
                            <button class="btn-row-add" style="margin-top:0.5rem" @onclick="() => NeuesItemErstellen(ort)">
                                ✅ Item erstellen & zum Markt hinzufügen
                            </button>
                        </details>
                    </div>
                }
                <!-- Sperrbedingungen -->
                <div class="editor-section">
                    <div class="editor-section-title">🔒 Sperrbedingungen</div>
                    <div class="editor-field-grid">
                        <div class="editor-field">
                            <label>Ab Orden (min.)</label>
                            <input class="editor-input editor-input-klein" type="number" min="0" max="8"
                                   value="@ort.MinOrdenFürZugang"
                                   @onchange="e => { if(int.TryParse(e.Value?.ToString(), out int v)) { ort.MinOrdenFürZugang = v; Speichern(); } }" />
                            <span class="editor-field-hint">0 = immer offen</span>
                        </div>
                        <div class="editor-field">
                            <label>Bis Orden gesperrt (max.)</label>
                            <input class="editor-input editor-input-klein" type="number" min="0" max="8"
                                   value="@ort.MaxOrdenFürSperre"
                                   @onchange="e => { if(int.TryParse(e.Value?.ToString(), out int v)) { ort.MaxOrdenFürSperre = v; Speichern(); } }" />
                            <span class="editor-field-hint">0 = keine Max-Sperre</span>
                        </div>
                        <div class="editor-field">
                            <label>Benötigtes Item (ID)</label>
                            <input class="editor-input" value="@(ort.BenötigtItem ?? "")"
                                   placeholder="z.B. sprudelwasser"
                                   @onchange="e => { ort.BenötigtItem = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value.ToString(); Speichern(); }" />
                        </div>
                        <div class="editor-field">
                            <label>Item-Name (Anzeige)</label>
                            <input class="editor-input" value="@(ort.BenötigtItemName ?? "")"
                                   placeholder="z.B. Sprudelwasser"
                                   @onchange="e => { ort.BenötigtItemName = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value.ToString(); Speichern(); }" />
                        </div>
                    </div>
                    <div class="editor-toggle-row" style="margin-top:0.5rem">
                        <label class="editor-toggle">
                            <input type="checkbox" checked="@ort.IstUnterirdisch"
                                   @onchange="e => { ort.IstUnterirdisch = (bool)(e.Value ?? false); Speichern(); }" />
                            <span class="toggle-slider"></span>
                            <span class="toggle-label">🕳️ Unterirdisch (immer zugänglich)</span>
                        </label>
                        <label class="editor-toggle">
                            <input type="checkbox" checked="@ort.LigaZugang"
                                   @onchange="e => { ort.LigaZugang = (bool)(e.Value ?? false); Speichern(); }" />
                            <span class="toggle-slider"></span>
                            <span class="toggle-label">🏆 Liga-Zugang (alle 8 Orden)</span>
                        </label>
                    </div>
                </div>

                <!-- Verbindungen (Richtungen) -->
                <div class="editor-section">
                    <div class="editor-section-title">🔗 Verbindungen</div>

                    <!-- Kompass-Layout -->
                    <div class="editor-kompass">
                        <!-- Nord -->
                        <div class="kompass-nord">
                            <label class="kompass-label">⬆️ Nord</label>
                            <select class="editor-input kompass-select"
                                    value="@(ort.Nord ?? "")"
                                    @onchange="e => { var v = e.Value?.ToString(); ort.Nord = string.IsNullOrEmpty(v) ? null : v; SyncVerbindungen(ort); Speichern(); }">
                                <option value="">— keine —</option>
                                @foreach (var o in editorOrte.Where(o => o.Id != ort.Id).OrderBy(o => o.Name))
                                {
                                    <option value="@o.Id">@o.Name</option>
                                }
                            </select>
                        </div>
                        <!-- Mitte-Zeile: West | [Name] | Ost -->
                        <div class="kompass-mitte-zeile">
                            <div class="kompass-west">
                                <label class="kompass-label">⬅️ West</label>
                                <select class="editor-input kompass-select"
                                        value="@(ort.West ?? "")"
                                        @onchange="e => { var v = e.Value?.ToString(); ort.West = string.IsNullOrEmpty(v) ? null : v; SyncVerbindungen(ort); Speichern(); }">
                                    <option value="">— keine —</option>
                                    @foreach (var o in editorOrte.Where(o => o.Id != ort.Id).OrderBy(o => o.Name))
                                    {
                                        <option value="@o.Id">@o.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="kompass-mitte">
                                <span class="kompass-ort-name">@ort.Name</span>
                            </div>
                            <div class="kompass-ost">
                                <label class="kompass-label">➡️ Ost</label>
                                <select class="editor-input kompass-select"
                                        value="@(ort.Ost ?? "")"
                                        @onchange="e => { var v = e.Value?.ToString(); ort.Ost = string.IsNullOrEmpty(v) ? null : v; SyncVerbindungen(ort); Speichern(); }">
                                    <option value="">— keine —</option>
                                    @foreach (var o in editorOrte.Where(o => o.Id != ort.Id).OrderBy(o => o.Name))
                                    {
                                        <option value="@o.Id">@o.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <!-- Süd -->
                        <div class="kompass-süd">
                            <label class="kompass-label">⬇️ Süd</label>
                            <select class="editor-input kompass-select"
                                    value="@(ort.Süd ?? "")"
                                    @onchange="e => { var v = e.Value?.ToString(); ort.Süd = string.IsNullOrEmpty(v) ? null : v; SyncVerbindungen(ort); Speichern(); }">
                                <option value="">— keine —</option>
                                @foreach (var o in editorOrte.Where(o => o.Id != ort.Id).OrderBy(o => o.Name))
                                {
                                    <option value="@o.Id">@o.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Teleport & Untergrund -->
                    <div class="editor-field-grid" style="margin-top:0.75rem">
                        <div class="editor-field">
                            <label>🌀 Teleport-Ziel</label>
                            <select class="editor-input"
                                    value="@(ort.Teleport ?? "")"
                                    @onchange="e => { var v = e.Value?.ToString(); ort.Teleport = string.IsNullOrEmpty(v) ? null : v; Speichern(); }">
                                <option value="">— kein Teleport —</option>
                                @foreach (var o in editorOrte.Where(o => o.Id != ort.Id).OrderBy(o => o.Name))
                                {
                                    <option value="@o.Id">@o.Name</option>
                                }
                            </select>
                        </div>
                        <div class="editor-field">
                            <label>🕳️ Unterirdischer Gang</label>
                            <select class="editor-input"
                                    value="@(ort.Untergrund ?? "")"
                                    @onchange="e => { var v = e.Value?.ToString(); ort.Untergrund = string.IsNullOrEmpty(v) ? null : v; SyncVerbindungen(ort); Speichern(); }">
                                <option value="">— kein Untergang —</option>
                                @foreach (var o in editorOrte.Where(o => o.Id != ort.Id).OrderBy(o => o.Name))
                                {
                                    <option value="@o.Id">@o.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Verbindungs-Übersicht -->
                    <div class="editor-verbindungen-info">
                        <span class="verbindungen-label">Alle Verbindungen:</span>
                        @if (ort.Verbindungen.Any())
                        {
                            @foreach (var vid in ort.Verbindungen)
                            {
                                var ziel = editorOrte.FirstOrDefault(o => o.Id == vid);
                                <span class="verbindung-chip">@(ziel?.Name ?? vid)</span>
                            }
                        }
                        else
                        {
                            <span class="editor-leer-text">Keine Verbindungen</span>
                        }
                    </div>
                </div>

                <!-- Arena -->
                <div class="editor-section">
                    <div class="editor-section-title-row">
                        <span class="editor-section-title">🏆 Arena</span>
                        @if (ort.Arena == null)
                        {
                            <button class="btn-section-add"
                                    @onclick="() => ArenaHinzufügen(ort)">
                                + Hinzufügen
                            </button>
                        }
                        else
                        {
                            <button class="btn-section-remove"
                                    @onclick="() => { ort.Arena = null; Speichern(); }">Entfernen</button>
                        }
                    </div>
                    @if (ort.Arena != null)
                    {
                        var arena = ort.Arena;
                        <div class="editor-field-grid">
                            <div class="editor-field">
                                <label>Leiter</label>
                                <input class="editor-input" value="@arena.Leiter"
                                       @onchange="e => { arena.Leiter = e.Value?.ToString() ?? arena.Leiter; Speichern(); }" />
                            </div>
                            <div class="editor-field">
                                <label>Orden-Name</label>
                                <input class="editor-input" value="@arena.OrdenName"
                                       @onchange="e => { arena.OrdenName = e.Value?.ToString() ?? arena.OrdenName; Speichern(); }" />
                            </div>
                            <div class="editor-field">
                                <label>Orden-Nr.</label>
                                <input class="editor-input editor-input-klein" type="number" min="1" max="8"
                                       value="@arena.OrdenNr"
                                       @onchange="e => { if(int.TryParse(e.Value?.ToString(), out int v)) { arena.OrdenNr = v; Speichern(); } }" />
                            </div>
                            <div class="editor-field">
                                <label>Typ-Spezialisierung</label>
                                <select class="editor-input" value="@arena.TypSpezialisierung"
                                        @onchange="e => { arena.TypSpezialisierung = e.Value?.ToString() ?? arena.TypSpezialisierung; Speichern(); }">
                                    @foreach (var typ in TypeChart.AlleTypen)
                                    {
                                        <option value="@typ">@TypeChart.TypEmojis.GetValueOrDefault(typ, "") @typ</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="editor-sub-section">
                            <div class="editor-sub-title">Arena-Team</div>
                            @foreach (var te in arena.Team.ToList())
                            {
                                var t2 = te;
                                <div class="editor-team-eintrag">
                                    <input class="editor-input editor-input-id" placeholder="PKM-ID (z.B. PKM-0001)"
                                           value="@t2.MonsterId"
                                           @onchange="ev => { t2.MonsterId = ev.Value?.ToString() ?? t2.MonsterId; Speichern(); }" />
                                    <span class="editor-label-klein">Lv.</span>
                                    <input class="editor-input editor-input-klein" type="number" min="1" max="100"
                                           value="@t2.Level"
                                           @onchange="ev => { if(int.TryParse(ev.Value?.ToString(), out int v)) { t2.Level = v; Speichern(); } }" />
                                    <button class="btn-row-loeschen"
                                            @onclick="() => { arena.Team.Remove(t2); Speichern(); }">✕</button>
                                </div>
                            }
                            <button class="btn-row-add"
                                    @onclick="ArenaMonsterHinzufügen">
                                ＋ Monster hinzufügen
                            </button>
                        </div>
                    }
                </div>

                <!-- Wilde Monster -->
                <div class="editor-section">
                    <div class="editor-section-title-row">
                        <span class="editor-section-title">🌿 Wilde Monster</span>
                        <button class="btn-section-add"
                                @onclick="() => WildMonsterHinzufügen(ort)">
                            + Hinzufügen
                        </button>
                    </div>
                    @if (!ort.WildMonster.Any())
                    {
                        <p class="editor-leer-text">Keine wilden Monster in diesem Gebiet.</p>
                    }
                    @foreach (var wild in ort.WildMonster.ToList())
                    {
                        var w = wild;
                        <div class="editor-wild-eintrag">
                            <input class="editor-input editor-input-id" placeholder="PKM-ID"
                                   value="@w.MonsterId"
                                   @onchange="e => { w.MonsterId = e.Value?.ToString() ?? w.MonsterId; Speichern(); }" />
                            <span class="editor-label-klein">Lv.</span>
                            <input class="editor-input editor-input-klein" type="number" min="1" max="100"
                                   value="@w.MinLevel"
                                   @onchange="e => { if(int.TryParse(e.Value?.ToString(), out int v)) { w.MinLevel = v; Speichern(); } }" />
                            <span class="editor-label-klein">–</span>
                            <input class="editor-input editor-input-klein" type="number" min="1" max="100"
                                   value="@w.MaxLevel"
                                   @onchange="e => { if(int.TryParse(e.Value?.ToString(), out int v)) { w.MaxLevel = v; Speichern(); } }" />
                            <span class="editor-label-klein">%</span>
                            <input class="editor-input editor-input-klein" type="number" min="1" max="100"
                                   value="@w.Chance"
                                   @onchange="e => { if(int.TryParse(e.Value?.ToString(), out int v)) { w.Chance = v; Speichern(); } }" />
                            <button class="btn-row-loeschen"
                                    @onclick="() => { ort.WildMonster.Remove(w); Speichern(); }">✕</button>
                        </div>
                    }
                </div>

                <!-- Trainer -->
                <div class="editor-section">
                    <div class="editor-section-title-row">
                        <span class="editor-section-title">🧑 Trainer</span>
                        <button class="btn-section-add"
                                @onclick="() => TrainerHinzufügen(ort)">
                            + Hinzufügen
                        </button>
                    </div>
                    @if (!ort.Trainer.Any())
                    {
                        <p class="editor-leer-text">Keine Trainer in diesem Gebiet.</p>
                    }
                    @foreach (var trainer in ort.Trainer.ToList())
                    {
                        var tr = trainer;
                        bool offen = offeneTrainer.Contains(tr.Id);
                        <div class="editor-trainer-block">
                            <div class="editor-trainer-header" @onclick="() => TrainerToggle(tr.Id)">
                                <span class="trainer-header-name">🧑 @tr.Name <span class="trainer-klasse">(@tr.Klasse)</span></span>
                                <div class="trainer-header-rechts">
                                    <span class="trainer-belohnung">💰 @tr.Belohnung</span>
                                    <span class="trainer-chevron">@(offen ? "▲" : "▼")</span>
                                </div>
                            </div>
                            @if (offen)
                            {
                                <div class="editor-trainer-body">
                                    <div class="editor-field-grid">
                                        <div class="editor-field">
                                            <label>Name</label>
                                            <input class="editor-input" value="@tr.Name"
                                                   @onchange="e => { tr.Name = e.Value?.ToString() ?? tr.Name; Speichern(); }" />
                                        </div>
                                        <div class="editor-field">
                                            <label>Klasse</label>
                                            <input class="editor-input" value="@tr.Klasse"
                                                   @onchange="e => { tr.Klasse = e.Value?.ToString() ?? tr.Klasse; Speichern(); }" />
                                        </div>
                                        <div class="editor-field">
                                            <label>Belohnung</label>
                                            <input class="editor-input editor-input-klein" type="number"
                                                   value="@tr.Belohnung"
                                                   @onchange="e => { if(int.TryParse(e.Value?.ToString(), out int v)) { tr.Belohnung = v; Speichern(); } }" />
                                        </div>
                                    </div>
                                    <div class="editor-field editor-field-voll">
                                        <label>Dialog (vor Kampf)</label>
                                        <input class="editor-input" value="@tr.Dialogvor"
                                               @onchange="e => { tr.Dialogvor = e.Value?.ToString() ?? tr.Dialogvor; Speichern(); }" />
                                    </div>
                                    <div class="editor-field editor-field-voll">
                                        <label>Dialog (nach Kampf)</label>
                                        <input class="editor-input" value="@tr.DialogNach"
                                               @onchange="e => { tr.DialogNach = e.Value?.ToString() ?? tr.DialogNach; Speichern(); }" />
                                    </div>
                                    <div class="editor-sub-section">
                                        <div class="editor-sub-title">Team</div>
                                        @foreach (var te in tr.Team.ToList())
                                        {
                                            var t2 = te;
                                            <div class="editor-team-eintrag">
                                                <input class="editor-input editor-input-id" placeholder="PKM-ID"
                                                       value="@t2.MonsterId"
                                                       @onchange="ev => { t2.MonsterId = ev.Value?.ToString() ?? t2.MonsterId; Speichern(); }" />
                                                <span class="editor-label-klein">Lv.</span>
                                                <input class="editor-input editor-input-klein" type="number" min="1" max="100"
                                                       value="@t2.Level"
                                                       @onchange="ev => { if(int.TryParse(ev.Value?.ToString(), out int v)) { t2.Level = v; Speichern(); } }" />
                                                <button class="btn-row-loeschen"
                                                        @onclick="() => { tr.Team.Remove(t2); Speichern(); }">✕</button>
                                            </div>
                                        }
                                        <button class="btn-row-add"
                                                @onclick="() => TrainerMonsterHinzufügen(tr)">
                                            ＋ Monster
                                        </button>
                                    </div>
                                    <button class="btn-trainer-loeschen"
                                            @onclick="() => { ort.Trainer.Remove(tr); offeneTrainer.Remove(tr.Id); Speichern(); }">
                                        🗑️ Trainer löschen
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>

            </div>
        }
        else
        {
            <div class="editor-leer-hinweis">
                <span class="editor-leer-icon">🗺️</span>
                <p>Wähle einen Ort aus der Liste</p>
                <p class="editor-leer-sub">oder klicke auf eine Zelle im Grid</p>
            </div>
        }
    </div>

</div>

<!-- Toolbar unten -->
<div class="editor-toolbar">
    <button class="btn-toolbar" @onclick="AllesZurücksetzen">🔄 Zurücksetzen</button>
    <button class="btn-toolbar btn-export" @onclick="ExportierenAsync">⬇️ JSON exportieren</button>
    <label class="btn-toolbar btn-import">
        📂 JSON importieren
        <InputFile OnChange="ImportierenAsync" accept=".json" style="display:none" />
    </label>
    <span class="editor-toolbar-info">💾 Änderungen werden automatisch im Browser gespeichert</span>
</div>

<!-- ═══ Handy-Popup: Ort-Auswahl für Grid-Zelle ══════════════════════════ -->
@if (popupOffen)
{
    <div class="editor-popup-overlay" @onclick="PopupSchliessen">
        <div class="editor-popup" @onclick:stopPropagation="true">
            <div class="editor-popup-header">
                <span>📍 Ort für Zelle (@popupCol, @popupRow) wählen</span>
                <button class="btn-schliessen" @onclick="PopupSchliessen">✕</button>
            </div>
            <div class="editor-popup-search">
                <input class="editor-search-input" placeholder="🔍 Suchen..."
                       @bind="popupSuche" @bind:event="oninput" />
            </div>
            <div class="editor-popup-liste">
                <!-- Leer-Option -->
                <div class="editor-popup-eintrag editor-popup-leer"
                     @onclick="() => PopupOrtWählen(null)">
                    <span>🚫 Leer lassen</span>
                </div>
                @foreach (var o in PopupGefilterteOrte)
                {
                    var po = o;
                    bool platziert = po.GridX >= 0;
                    <div class="editor-popup-eintrag @(platziert ? "popup-platziert" : "popup-frei")"
                         @onclick="() => PopupOrtWählen(po)">
                        <span class="popup-dot" style="background:@WeltData.OrtFarben.GetValueOrDefault(po.Farbe, "#374151")">@OrtIcon(po)</span>
                        <div class="popup-info">
                            <span class="popup-name">@po.Name</span>
                            <span class="popup-id">@po.Id @(platziert ? $"· ({po.GridX},{po.GridY})" : "· noch nicht platziert")</span>
                        </div>
                        <span class="popup-status-dot @(platziert ? "dot-grau" : "dot-gruen")">●</span>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private List<Ort> editorOrte = new();
    private string? ausgewähltOrtId;
    private Ort? ausgewähltOrt;
    private string suchbegriff = "";
    private string filterTyp = "Alle";
    private string filterRegion = "KAN";
    private int gridZoom = 100;
    private int gridRows = 10;
    private int gridCols = 10;
    private HashSet<string> offeneTrainer = new();
    private string speicherStatus = "";
    private bool speicherFehler = false;
    private int _neuZähler = 100;

    // Popup-Zustand
    private bool popupOffen = false;
    private int popupCol = 0;
    private int popupRow = 0;
    private string popupSuche = "";

    private static readonly Dictionary<string, string> RegionNamen = new()
    {
        { "ALLE", "🌍 Alle" }, { "KAN", "🔴 Kanto" }, { "JOH", "🟡 Johto" },
        { "HOE", "🔵 Hoenn" }, { "SIN", "⚪ Sinnoh" }, { "UNG", "⚫ Einall" },
        { "KAL", "🟣 Kalos" }, { "ALO", "🟠 Alola" }, { "GAL", "🟢 Galar" }, { "PAL", "🟤 Paldea" }
    };

    private IEnumerable<Ort> GefilterteOrte => editorOrte
        .Where(o => (filterRegion == "ALLE" || o.Id.StartsWith(filterRegion + "-")) &&
                    (filterTyp == "Alle" || o.Typ == filterTyp) &&
                    (string.IsNullOrEmpty(suchbegriff) ||
                     o.Name.Contains(suchbegriff, StringComparison.OrdinalIgnoreCase) ||
                     o.Id.Contains(suchbegriff, StringComparison.OrdinalIgnoreCase)))
        .OrderBy(o => o.GridX >= 0 ? 1 : 0) // Unplatzierte zuerst
        .ThenBy(o => o.Name);

    private IEnumerable<Ort> PopupGefilterteOrte => editorOrte
        .Where(o => (filterRegion == "ALLE" || o.Id.StartsWith(filterRegion + "-")) &&
                    (string.IsNullOrEmpty(popupSuche) ||
                     o.Name.Contains(popupSuche, StringComparison.OrdinalIgnoreCase) ||
                     o.Id.Contains(popupSuche, StringComparison.OrdinalIgnoreCase)))
        .OrderBy(o => o.GridX >= 0 ? 1 : 0) // Unplatzierte zuerst
        .ThenBy(o => o.Name);

    protected override async Task OnInitializedAsync()
    {
        Game.OnChange += StateHasChanged;
        var json = await Storage.GetItemAsync("editor_orte");
        if (!string.IsNullOrEmpty(json))
        {
            try
            {
                var geladen = System.Text.Json.JsonSerializer.Deserialize<List<Ort>>(json,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (geladen?.Any() == true) { editorOrte = geladen; return; }
            }
            catch { }
        }
        editorOrte = WeltData.AlleOrte();
    }

    public void Dispose() => Game.OnChange -= StateHasChanged;

    private void OrtAuswählen(string id)
    {
        ausgewähltOrtId = id;
        ausgewähltOrt = editorOrte.FirstOrDefault(o => o.Id == id);
    }

    private void GridZelleKlick(int col, int row)
    {
        var ort = editorOrte.FirstOrDefault(o =>
            o.GridX == col && o.GridY == row &&
            (filterRegion == "ALLE" || o.Id.StartsWith(filterRegion + "-")));

        if (ort != null)
        {
            OrtAuswählen(ort.Id);
        }
        else if (ausgewähltOrt != null && ausgewähltOrt.GridX < 0)
        {
            // Direkt platzieren wenn Ort ausgewählt und noch nicht platziert
            ausgewähltOrt.GridX = col;
            ausgewähltOrt.GridY = row;
            Speichern();
        }
        else
        {
            // Popup öffnen für Handy-Auswahl
            popupCol = col;
            popupRow = row;
            popupSuche = "";
            popupOffen = true;
        }
    }

    private void PopupSchliessen() => popupOffen = false;

    private void PopupOrtWählen(Ort? gewählt)
    {
        if (gewählt == null)
        {
            // Leer lassen: vorhandenen Ort von dieser Zelle entfernen
            var vorhandener = editorOrte.FirstOrDefault(o =>
                o.GridX == popupCol && o.GridY == popupRow);
            if (vorhandener != null)
            {
                vorhandener.GridX = -1;
                vorhandener.GridY = -1;
                Speichern();
            }
        }
        else
        {
            // Ort auf diese Zelle setzen (ggf. vorherige Position überschreiben)
            gewählt.GridX = popupCol;
            gewählt.GridY = popupRow;
            OrtAuswählen(gewählt.Id);
            Speichern();
        }
        popupOffen = false;
    }

    /// <summary>Synchronisiert Verbindungen-Liste aus den Richtungsfeldern + Teleport + Untergrund</summary>
    private void SyncVerbindungen(Ort ort)
    {
        var neu = new List<string>();
        if (!string.IsNullOrEmpty(ort.Nord)) neu.Add(ort.Nord);
        if (!string.IsNullOrEmpty(ort.Süd)) neu.Add(ort.Süd);
        if (!string.IsNullOrEmpty(ort.Ost)) neu.Add(ort.Ost);
        if (!string.IsNullOrEmpty(ort.West)) neu.Add(ort.West);
        if (!string.IsNullOrEmpty(ort.Untergrund)) neu.Add(ort.Untergrund);
        if (!string.IsNullOrEmpty(ort.Teleport)) neu.Add(ort.Teleport);
        ort.Verbindungen = neu.Distinct().ToList();
    }

    private void NeuenOrtErstellen()
    {
        _neuZähler++;
        var neuer = new Ort
        {
            Id = $"ort-{_neuZähler:D3}",
            Name = $"Neuer Ort {_neuZähler}",
            Typ = "route",
            Farbe = "green",
            GridX = -1,
            GridY = -1,
            Beschreibung = "",
        };
        editorOrte.Add(neuer);
        OrtAuswählen(neuer.Id);
        Speichern();
    }

    private void OrtLöschen()
    {
        if (ausgewähltOrt == null) return;
        editorOrte.Remove(ausgewähltOrt);
        ausgewähltOrtId = null;
        ausgewähltOrt = null;
        Speichern();
    }

    private void TrainerToggle(string id)
    {
        if (offeneTrainer.Contains(id)) offeneTrainer.Remove(id);
        else offeneTrainer.Add(id);
    }

    private async void Speichern()
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(editorOrte,
                new System.Text.Json.JsonSerializerOptions { WriteIndented = false });
            await Storage.SetItemAsync("editor_orte", json);
            speicherStatus = "✓ Gespeichert";
            speicherFehler = false;
            StateHasChanged();
            await Task.Delay(2000);
            speicherStatus = "";
            StateHasChanged();
        }
        catch
        {
            speicherStatus = "⚠️ Fehler";
            speicherFehler = true;
            StateHasChanged();
        }
    }

    private async Task AllesZurücksetzen()
    {
        await Storage.RemoveItemAsync("editor_orte");
        editorOrte = WeltData.AlleOrte();
        ausgewähltOrtId = null;
        ausgewähltOrt = null;
        speicherStatus = "🔄 Zurückgesetzt";
        StateHasChanged();
        await Task.Delay(2000);
        speicherStatus = "";
    }

    private async Task ExportierenAsync()
    {
        var json = System.Text.Json.JsonSerializer.Serialize(editorOrte,
            new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        var bytes = System.Text.Encoding.UTF8.GetBytes(json);
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("eval",
            $"const a=document.createElement('a');a.href='data:application/json;base64,{base64}';a.download='weltkarte.json';a.click()");
    }

    private async Task ImportierenAsync(InputFileChangeEventArgs e)
    {
        try
        {
            using var stream = e.File.OpenReadStream(5 * 1024 * 1024);
            using var reader = new System.IO.StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            var geladen = System.Text.Json.JsonSerializer.Deserialize<List<Ort>>(json,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (geladen != null)
            {
                editorOrte = geladen;
                await Storage.SetItemAsync("editor_orte", json);
                speicherStatus = $"✅ {geladen.Count} Orte importiert!";
                StateHasChanged();
                await Task.Delay(3000);
                speicherStatus = "";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            speicherStatus = $"❌ {ex.Message}";
            speicherFehler = true;
        }
    }

    private void ArenaHinzufügen(Ort ort)
    {
        ort.Arena = new Arena { OrdenName = "Neuer Orden", Leiter = "Arena-Leiter", TypSpezialisierung = "Normal", OrdenNr = 1 };
        Speichern();
    }

    private void ArenaMonsterHinzufügen()
    {
        if (ausgewähltOrt?.Arena == null) return;
        ausgewähltOrt.Arena.Team.Add(new MonsterTeamEintrag { MonsterId = "PKM-0001", Level = 10 });
        Speichern();
    }

    private void WildMonsterHinzufügen(Ort ort)
    {
        ort.WildMonster.Add(new WildBegegnung { MonsterId = "PKM-0001", MinLevel = 3, MaxLevel = 8, Chance = 20 });
        Speichern();
    }

    private void TrainerHinzufügen(Ort ort)
    {
        ort.Trainer.Add(new TrainerKampf
        {
            Id = $"tr_{ort.Id}_{ort.Trainer.Count + 1}",
            Name = "Neuer Trainer",
            Klasse = "Trainer",
            Belohnung = 200,
            Dialogvor = "Auf zum Kampf!",
            DialogNach = "Gut gekämpft!"
        });
        Speichern();
    }

    private void TrainerMonsterHinzufügen(TrainerKampf tr)
    {
        tr.Team.Add(new MonsterTeamEintrag { MonsterId = "PKM-0001", Level = 5 });
        Speichern();
    }

    // ─── Markt-Item Verwaltung ────────────────────────────────────────────────
    private bool marktItemAuswahlOffen = false;
    private string itemSuche = "";
    private string neuesItemName = "";
    private int neuesItemPreis = 200;
    private string neuesItemEmoji = "📦";
    private string neuesItemKategorie = "Heilung";
    private string neuesItemBeschreibung = "";
    private string neuesItemWoBekommt = "";
    private static int _itemZähler = 200;

    private List<ShopItem> _alleItemsCache = new();
    private List<ShopItem> AlleItemsGefiltert => _alleItemsCache
        .Where(i => string.IsNullOrEmpty(itemSuche) ||
                    i.Name.Contains(itemSuche, StringComparison.OrdinalIgnoreCase) ||
                    i.Kategorie.Contains(itemSuche, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private void MarktItemAuswahlÖffnen()
    {
        _alleItemsCache = WeltData.AlleItems();
        itemSuche = "";
        marktItemAuswahlOffen = true;
    }

    private void ItemAuswahlBestätigen(Ort ort, ShopItem item)
    {
        if (!ort.MarktAngebot.Any(x => x.Id == item.Id))
        {
            ort.MarktAngebot.Add(new ShopItem
            {
                Id = item.Id,
                Name = item.Name,
                Beschreibung = item.Beschreibung,
                Preis = item.Preis,
                Emoji = item.Emoji,
                Kategorie = item.Kategorie,
                WoBekommt = item.WoBekommt
            });
            Speichern();
        }
        marktItemAuswahlOffen = false;
    }

    private void NeuesItemErstellen(Ort ort)
    {
        if (string.IsNullOrWhiteSpace(neuesItemName)) return;
        _itemZähler++;
        var neues = new ShopItem
        {
            Id = $"item-custom-{_itemZähler}",
            Name = neuesItemName.Trim(),
            Beschreibung = neuesItemBeschreibung.Trim(),
            Preis = neuesItemPreis,
            Emoji = string.IsNullOrEmpty(neuesItemEmoji) ? "📦" : neuesItemEmoji,
            Kategorie = neuesItemKategorie,
            WoBekommt = string.IsNullOrEmpty(neuesItemWoBekommt) ? "Hier" : neuesItemWoBekommt
        };
        ort.MarktAngebot.Add(neues);
        // Felder zurücksetzen
        neuesItemName = "";
        neuesItemBeschreibung = "";
        neuesItemPreis = 200;
        neuesItemEmoji = "📦";
        neuesItemWoBekommt = "";
        Speichern();
    }

    private string OrtIcon(Ort ort) => ort.Typ switch
    {
        "stadt"  => ort.Arena != null ? "🏆" : "🏙️",
        "route"  => "🌿",
        "hoehle" => "⛰️",
        "wald"   => "🌲",
        _        => "📍"
    };

    private string TypIcon(string typ) => typ switch
    {
        "Alle"   => "🗺️",
        "stadt"  => "🏙️",
        "route"  => "🌿",
        "hoehle" => "⛰️",
        "wald"   => "🌲",
        _        => "📍"
    };
}
