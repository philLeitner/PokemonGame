    }

    private string OrtIcon(Ort ort) => ort.Typ switch
    {
        "stadt"  => ort.Arena != null ? "🏆" : "🏙️",
        "route"  => "🌿",
        "hoehle" => "⛰️",
        "wald"   => "🌲",
        _        => "📍"
    };

    private string TypIcon(string typ) => typ switch
    {
        "Alle"   => "🗺️",
        "stadt"  => "🏙️",
        "route"  => "🌿",
        "hoehle" => "⛰️",
        "wald"   => "🌲",
        _        => "📍"
    };
