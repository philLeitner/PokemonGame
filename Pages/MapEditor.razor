                        </div>
                        <div class="editor-sub-section">
                            <div class="editor-sub-title">Arena-Team</div>
                            @foreach (var te in arena.Team.ToList())
                            {
                                var t2 = te;
                                <div class="editor-team-eintrag">
                                    <input class="editor-input editor-input-id" placeholder="PKM-ID (z.B. PKM-0001)"
                                           value="@t2.MonsterId"
                                           @onchange="ev => { t2.MonsterId = ev.Value?.ToString() ?? t2.MonsterId; Speichern(); }" />
                                    <span class="editor-label-klein">Lv.</span>
                                    <input class="editor-input editor-input-klein" type="number" min="1" max="100"
                                           value="@t2.Level"
                                           @onchange="ev => { if(int.TryParse(ev.Value?.ToString(), out int v)) { t2.Level = v; Speichern(); } }" />
                                    <button class="btn-row-loeschen"
                                            @onclick="() => { arena.Team.Remove(t2); Speichern(); }">✕</button>
                                </div>
                            }
                            <button class="btn-row-add"
                                    @onclick="ArenaMonsterHinzufügen">
                                ＋ Monster hinzufügen
                            </button>
                        </div>
                    }
                </div>

                <!-- Wilde Monster -->
                <div class="editor-section">
                    <div class="editor-section-title-row">
                        <span class="editor-section-title">🌿 Wilde Monster</span>
                        <button class="btn-section-add"
                                @onclick="() => WildMonsterHinzufügen(ort)">
                            + Hinzufügen
                        </button>
                    </div>
                    @if (!ort.WildMonster.Any())
                    {
                        <p class="editor-leer-text">Keine wilden Monster in diesem Gebiet.</p>
                    }
                    @foreach (var wild in ort.WildMonster.ToList())
                    {
                        var w = wild;
                        <div class="editor-wild-eintrag">
                            <input class="editor-input editor-input-id" placeholder="PKM-ID"
                                   value="@w.MonsterId"
                                   @onchange="e => { w.MonsterId = e.Value?.ToString() ?? w.MonsterId; Speichern(); }" />
                            <span class="editor-label-klein">Lv.</span>
                            <input class="editor-input editor-input-klein" type="number" min="1" max="100"
                                   value="@w.MinLevel"
                                   @onchange="e => { if(int.TryParse(e.Value?.ToString(), out int v)) { w.MinLevel = v; Speichern(); } }" />
                            <span class="editor-label-klein">–</span>
                            <input class="editor-input editor-input-klein" type="number" min="1" max="100"
                                   value="@w.MaxLevel"
                                   @onchange="e => { if(int.TryParse(e.Value?.ToString(), out int v)) { w.MaxLevel = v; Speichern(); } }" />
                            <span class="editor-label-klein">%</span>
                            <input class="editor-input editor-input-klein" type="number" min="1" max="100"
                                   value="@w.Chance"
