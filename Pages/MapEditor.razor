@inject GameService Game
@inject LocalStorageService Storage
@inject IJSRuntime JS
@inject HttpClient Http
@implements IDisposable

<div class="editor-screen">

    <!-- ═══ PANEL 1: Ortsliste ══════════════════════════════════════════════ -->
    <div class="editor-panel-left">
        <div class="editor-panel-header">
            <span class="editor-panel-title">🗺️ Orte</span>
            <button class="btn-editor-back" @onclick="Game.ZuWeltkarte" title="Zurück zur Weltkarte">✕</button>
        </div>

        <div class="editor-search-box">
            <span class="editor-search-icon">🔍</span>
            <input class="editor-search-input" placeholder="Suchen..."
                   @bind="suchbegriff" @bind:event="oninput" />
        </div>

        <!-- Region-Filter -->
        <div class="editor-region-row">
            <select class="editor-region-select" @bind="filterRegion">
                @foreach (var kv in RegionNamen)
                {
                    <option value="@kv.Key">@kv.Value</option>
                }
            </select>
        </div>

        <div class="editor-filter-row">
            @foreach (var typ in new[] { "Alle", "stadt", "route", "hoehle", "wald" })
            {
                <button class="editor-filter-btn @(filterTyp == typ ? "aktiv" : "")"
                        @onclick="() => filterTyp = typ" title="@typ">
                    @TypIcon(typ)
                </button>
            }
        </div>

        <!-- Legende Farbcodierung -->
        <div class="editor-liste-legende">
            <span class="legende-gruen">●</span> Noch nicht platziert
            <span class="legende-grau" style="margin-left:0.5rem">●</span> Auf Karte
        </div>

        <div class="editor-ort-liste">
            @foreach (var ort in GefilterteOrte)
            {
                bool platziert = ort.GridX >= 0;
                <div class="editor-ort-eintrag @(ausgewähltOrtId == ort.Id ? "aktiv" : "") @(platziert ? "platziert" : "unplatziert")"
                     @onclick="() => OrtAuswählen(ort.Id)">
                    <span class="editor-ort-color-dot"
                          style="background:@WeltData.OrtFarben.GetValueOrDefault(ort.Farbe, "#374151")">
                        @OrtIcon(ort)
                    </span>
                    <div class="editor-ort-info">
                        <span class="editor-ort-name">@ort.Name</span>

                    </div>
                    <div class="editor-ort-badges">
                        @if (ort.HatMonsterCenter) { <span title="Monster Center">🏥</span> }
                        @if (ort.HatMarkt) { <span title="Markt">🏪</span> }
                        @if (ort.Arena != null) { <span title="Arena">🏆</span> }
                        <span class="badge-platziert @(platziert ? "ja" : "nein")" title="@(platziert ? "Auf Karte platziert" : "Noch nicht platziert")">●</span>
                    </div>
                </div>
            }
        </div>

        <div class="editor-panel-footer">
            <button class="btn-editor-neu" @onclick="NeuOrtModalOeffnen">＋ Neuen Ort erstellen</button>
        </div>
    </div>

    <!-- ═══ PANEL 2: Karten-Grid ═══════════════════════════════════════════ -->
    <div class="editor-panel-mitte">
        <div class="editor-panel-header">
            <span class="editor-panel-title">@(RegionNamen.GetValueOrDefault(filterRegion, filterRegion)) – Grid</span>
            <div class="editor-grid-controls">
                <span class="grid-size-label">Zeilen:</span>
                <button class="btn-grid-ctrl" @onclick="() => gridRows = Math.Max(3, gridRows - 1)">−</button>
                <span class="grid-zoom-label">@gridRows</span>
                <button class="btn-grid-ctrl" @onclick="() => gridRows = Math.Min(25, gridRows + 1)">+</button>
                <span class="grid-size-label">Spalten:</span>
                <button class="btn-grid-ctrl" @onclick="() => gridCols = Math.Max(3, gridCols - 1)">−</button>
                <span class="grid-zoom-label">@gridCols</span>
                <button class="btn-grid-ctrl" @onclick="() => gridCols = Math.Min(25, gridCols + 1)">+</button>
                <span class="grid-size-label">Zoom:</span>
                <button class="btn-grid-ctrl" @onclick="() => gridZoom = Math.Max(60, gridZoom - 10)">−</button>
                <span class="grid-zoom-label">@gridZoom%</span>
                <button class="btn-grid-ctrl" @onclick="() => gridZoom = Math.Min(150, gridZoom + 10)">+</button>
                <button class="btn-grid-ctrl btn-toggle-rechts" title="Detail-Panel"
                        @onclick="() => rechtesSpalteOffen = !rechtesSpalteOffen">
                    @(rechtesSpalteOffen ? "◀" : "▶")
                </button>
            </div>
        </div>

        <div class="editor-grid-scroll">
            <div class="editor-grid" style="--cell-size: @(gridZoom * 0.8)px; grid-template-columns: repeat(@gridCols, var(--cell-size, 80px)); grid-template-rows: repeat(@gridRows, calc(var(--cell-size, 80px) * 0.7))">
                @for (int row = 0; row < gridRows; row++)
                {
                    @for (int col = 0; col < gridCols; col++)
                    {
                        int r = row, c = col;
                        var ort = editorOrte.FirstOrDefault(o =>
                            o.GridX == c && o.GridY == r &&
                            (filterRegion == "ALLE" || o.Id.StartsWith(filterRegion + "-")));
                        <div class="editor-grid-zelle @(ort != null ? "belegt" : "leer") @(ort?.Id == ausgewähltOrtId ? "aktiv" : "") @(dragOverCol == c && dragOverRow == r ? "drag-over" : "")"
                             style="grid-column: @(c+1); grid-row: @(r+1);"
                             @onclick="() => GridZelleKlick(c, r)"
                             @ondragover:preventDefault="true"
                             @ondragover="() => { dragOverCol = c; dragOverRow = r; }"
                             @ondragleave="() => { if (dragOverCol == c && dragOverRow == r) { dragOverCol = -1; dragOverRow = -1; } }"
                             @ondrop="() => DragDrop(c, r)"
                             title="@(ort != null ? ort.Name : $"Leer ({c},{r})")">
                            @if (ort != null)
                            {
                                <div class="editor-grid-knopf"
                                     draggable="true"
                                     @ondragstart="() => DragStart(ort.Id)"
                                     @ondragend="DragEnd"
                                     style="background:@WeltData.OrtFarben.GetValueOrDefault(ort.Farbe, "#374151"); cursor: grab;">
                                    <span class="editor-grid-icon">@OrtIcon(ort)</span>
                                    <span class="editor-grid-name">@ort.Name</span>
                                </div>
                                @if (ort.MinOrdenFürZugang > 0 || !string.IsNullOrEmpty(ort.BenötigtItem) || ort.LigaZugang)
                                {
                                    <div class="grid-sperre-badge" title="@SperreBeschreibung(ort)">
                                        @if (ort.LigaZugang) { <span>🏆</span> }
                                        else if (ort.MinOrdenFürZugang > 0) { <span>🏅@ort.MinOrdenFürZugang</span> }
                                        else { <span>📦</span> }
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="editor-grid-leer">
                                    @if (dragOrtId != null || (ausgewähltOrt != null && ausgewähltOrt.GridX < 0))
                                    {
                                        <span class="grid-place-hint">+</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        <div class="editor-grid-legende">
            <span>🏙️ Stadt</span><span>🌿 Route</span><span>⛰️ Höhle</span><span>🌲 Wald</span>
            <span class="legende-sep">|</span>
            <span>🏥 Center</span><span>🏪 Markt</span><span>🏆 Arena</span>
            @if (ausgewähltOrt != null && ausgewähltOrt.GridX < 0)
            {
                <span class="legende-tipp">← Klicke eine leere Zelle um <strong>@ausgewähltOrt.Name</strong> zu platzieren</span>
            }
        </div>
    </div>

    <!-- ═══ PANEL 3: Detail-Editor ══════════════════════════════════════════ -->
    <div class="editor-panel-rechts @(ausgewähltOrt != null && rechtesSpalteOffen ? "sichtbar" : "versteckt")">
        @if (ausgewähltOrt != null)
        {
            var ort = ausgewähltOrt;
            <div class="editor-detail-header">
                <div>
                    <h3 class="editor-detail-titel">@ort.Name</h3>
                    <span class="editor-detail-id">@ort.Id</span>
                    @if (!string.IsNullOrEmpty(speicherStatus))
                    {
                        <span class="editor-save-badge @(speicherFehler ? "fehler" : "")">@speicherStatus</span>
                    }
                </div>
                <div class="editor-header-aktionen">
                    <button class="btn-editor-kopieren" @onclick="OrtKopieren" title="Ort kopieren (ohne Verbindungen)">📋</button>
                    <button class="btn-editor-loeschen" @onclick="OrtLöschen" title="Ort löschen">🗑️</button>
                </div>
            </div>

            <div class="editor-detail-body">

                <!-- Basis-Daten -->
                <div class="editor-section">
                    <div class="editor-section-title">📋 Basis-Daten</div>
                    <div class="editor-field-grid">
                        <div class="editor-field">
                            <label>Name</label>
                            <input class="editor-input" value="@ort.Name"
                                   @onchange="e => { ort.Name = e.Value?.ToString() ?? ort.Name; Speichern(); }" />
                        </div>
                        <div class="editor-field">
                            <label>Typ</label>
                            <select class="editor-input" value="@ort.Typ"
                                    @onchange="e => { ort.Typ = e.Value?.ToString() ?? ort.Typ; Speichern(); }">
                                <option value="stadt">🏙️ Stadt</option>
                                <option value="route">🌿 Route</option>
                                <option value="hoehle">⛰️ Höhle</option>
                                <option value="wald">🌲 Wald</option>
                            </select>
                        </div>
                        <div class="editor-field">
                            <label>Kartenfarbe</label>
                            <select class="editor-input" value="@ort.Farbe"
                                    @onchange="e => { ort.Farbe = e.Value?.ToString() ?? ort.Farbe; Speichern(); }">
                                @foreach (var kv in WeltData.OrtFarben)
                                {
                                    <option value="@kv.Key">@kv.Key</option>
                                }
                            </select>
                        </div>
                        <div class="editor-field">
                            <label>Grid-Position (X , Y)</label>
                            <div class="editor-xy-row">
                                <input class="editor-input editor-input-klein" type="number" min="-1" max="9"
                                       value="@ort.GridX"
                                       @onchange="e => { if(int.TryParse(e.Value?.ToString(), out int v)) { ort.GridX = v; Speichern(); } }" />
                                <span class="xy-sep">,</span>
                                <input class="editor-input editor-input-klein" type="number" min="-1" max="9"
                                       value="@ort.GridY"
                                       @onchange="e => { if(int.TryParse(e.Value?.ToString(), out int v)) { ort.GridY = v; Speichern(); } }" />
                                @if (ort.GridX >= 0)
                                {
                                    <button class="btn-grid-entfernen" title="Von Karte entfernen"
                                            @onclick="() => { ort.GridX = -1; ort.GridY = -1; Speichern(); }">✕</button>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="editor-field editor-field-voll">
                        <label>Beschreibung</label>
                        <textarea class="editor-input editor-textarea" rows="2"
                                  @onchange="e => { ort.Beschreibung = e.Value?.ToString(); Speichern(); }">@ort.Beschreibung</textarea>
                    </div>
                </div>

                <!-- Einrichtungen -->
                <div class="editor-section">
                    <div class="editor-section-title">🏗️ Einrichtungen</div>
                    <div class="editor-toggle-row">
                        <label class="editor-toggle">
                            <input type="checkbox" checked="@ort.HatMonsterCenter"
                                   @onchange="e => { ort.HatMonsterCenter = (bool)(e.Value ?? false); Speichern(); }" />
                            <span class="toggle-slider"></span>
                            <span class="toggle-label">🏥 Monster Center</span>
                        </label>
                        <label class="editor-toggle">
                            <input type="checkbox" checked="@ort.HatMarkt"
                                   @onchange="e => { ort.HatMarkt = (bool)(e.Value ?? false); Speichern(); }" />
                            <span class="toggle-slider"></span>
                            <span class="toggle-label">🏪 Markt</span>
                        </label>
                    </div>
                </div>

                <!-- Markt-Items -->
                @if (ort.HatMarkt)
                {
                    <div class="editor-section">
                        <div class="editor-section-title-row">
                            <span class="editor-section-title">🏪 Markt-Angebot</span>
                            <button class="btn-section-add" @onclick="() => MarktItemAuswahlÖffnen()">
                                + Aus Datenbank
                            </button>
                        </div>
                        @if (!ort.MarktAngebot.Any())
                        {
                            <p class="editor-leer-text">Noch keine Items. Klicke "+ Aus Datenbank" oder erstelle unten ein neues Item.</p>
                        }
                        @foreach (var item in ort.MarktAngebot.ToList())
                        {
                            var it = item;
                            <div class="editor-markt-eintrag">
                                <span class="markt-emoji">@it.Emoji</span>
                                <div class="markt-info">
                                    <span class="markt-name">@it.Name</span>
                                    <span class="markt-preis">@it.Preis 💰</span>
                                </div>
                                <button class="btn-row-loeschen" @onclick="() => { ort.MarktAngebot.Remove(it); Speichern(); }">✕</button>
                            </div>
                        }
                        <!-- Item-Auswahl Panel -->
                        @if (marktItemAuswahlOffen)
                        {
                            <div class="editor-item-auswahl">
                                <div class="editor-item-auswahl-header">
                                    <span>📦 Item wählen</span>
                                    <button class="btn-schliessen" @onclick="() => marktItemAuswahlOffen = false">✕</button>
                                </div>
                                <input class="editor-search-input" placeholder="🔍 Suchen..." @bind="itemSuche" @bind:event="oninput" />
                                <div class="editor-item-liste">
                                    @foreach (var dbItem in AlleItemsGefiltert)
                                    {
                                        var di = dbItem;
                                        bool bereitsImMarkt = ort.MarktAngebot.Any(x => x.Id == di.Id);
                                        <div class="editor-item-eintrag" style="@(bereitsImMarkt ? "opacity:0.5" : "")" @onclick="() => ItemAuswahlBestätigen(ort, di)">
                                            <span class="markt-emoji">@di.Emoji</span>
                                            <div class="markt-info">
                                                <span class="markt-name">@di.Name @(bereitsImMarkt ? "✓" : "")</span>
                                                <span class="markt-preis">@di.Preis 💰 · @di.WoBekommt</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        <!-- Neues Item erstellen -->
                        <details class="editor-sub-section" style="margin-top:0.75rem">
                            <summary class="editor-sub-title" style="cursor:pointer">✏️ Neues Item erstellen</summary>
                            <div class="editor-field-grid" style="margin-top:0.5rem">
                                <div class="editor-field">
                                    <label>Name</label>
                                    <input class="editor-input" @bind="neuesItemName" placeholder="z.B. Ananassaft" />
                                </div>
                                <div class="editor-field">
                                    <label>Preis (💰)</label>
                                    <input class="editor-input editor-input-klein" type="number" min="0" @bind="neuesItemPreis" />
                                </div>
                                <div class="editor-field">
                                    <label>Emoji</label>
                                    <input class="editor-input editor-input-klein" @bind="neuesItemEmoji" placeholder="🍍" />
                                </div>
                                <div class="editor-field">
                                    <label>Kategorie</label>
                                    <select class="editor-input" @bind="neuesItemKategorie">
                                        <option value="Heilung">Heilung</option>
                                        <option value="Fangen">Fangen</option>
                                        <option value="Status">Status</option>
                                        <option value="Kampf">Kampf</option>
                                        <option value="Spezial">Spezial</option>
                                    </select>
                                </div>
                                <div class="editor-field" style="grid-column:span 2">
                                    <label>Beschreibung</label>
                                    <input class="editor-input" @bind="neuesItemBeschreibung" placeholder="Was macht das Item?" />
                                </div>
                                <div class="editor-field" style="grid-column:span 2">
                                    <label>Wo bekommt man es?</label>
                                    <input class="editor-input" @bind="neuesItemWoBekommt" placeholder="z.B. NPC in Prismania, nach Orden 3..." />
                                </div>
                            </div>
                            <button class="btn-row-add" style="margin-top:0.5rem" @onclick="() => NeuesItemErstellen(ort)">
                                ✅ Item erstellen & zum Markt hinzufügen
                            </button>
                        </details>
                    </div>
                }
                <!-- Liga-Zugang Toggle -->
                <div class="editor-section">
                    <div class="editor-section-title">🔒 Zugangsbedingungen</div>
                    <div class="editor-toggle-row">
                        <label class="editor-toggle">
                            <input type="checkbox" checked="@ort.IstUnterirdisch"
                                   @onchange="e => { ort.IstUnterirdisch = (bool)(e.Value ?? false); Speichern(); }" />
                            <span class="toggle-slider"></span>
                            <span class="toggle-label">🕳️ Unterirdisch (immer zugänglich)</span>
                        </label>
                        <label class="editor-toggle">
                            <input type="checkbox" checked="@ort.LigaZugang"
                                   @onchange="e => { ort.LigaZugang = (bool)(e.Value ?? false); Speichern(); }" />
                            <span class="toggle-slider"></span>
                            <span class="toggle-label">🏆 Liga-Zugang (alle 8 Orden)</span>
                        </label>
                    </div>
                </div>

                <!-- Verbindungen (Richtungen) -->
                <div class="editor-section">
                    <div class="editor-section-title">🔗 Verbindungen</div>
                    <!-- Kompass-Layout -->
                    <div class="editor-kompass">
                        <!-- Nord -->
                        <div class="kompass-nord">
                            <label class="kompass-label">⬆️ Nord</label>
                            <select class="editor-input kompass-select"
                                    value="@(ort.Nord ?? "")"
                                    @onchange="e => { var v = e.Value?.ToString(); ort.Nord = string.IsNullOrEmpty(v) ? null : v; SyncVerbindungen(ort); Speichern(); }">
                                <option value="">— keine —</option>
                                    @foreach (var o in editorOrte.Where(o => o.Id != ort.Id && SameRegion(o, ort)).OrderBy(o => o.Name))
                                    {
                                        <option value="@o.Id">@o.Name</option>
                                    }
                                </select>
                            @if (ort.Nord != null)
                            {
                                <div class="verbindung-optionen">
                                    <select class="editor-input verbindung-typ-select"
                                            value="@(ort.NordTyp ?? "normal")"
                                            @onchange="e => SetNordTyp(e, ort)">
                                        <option value="normal">🚶 Normal</option>
                                        <option value="untergrund">🕳️ Unterirdisch</option>
                                        <option value="teleport">🌀 Teleport</option>
                                    </select>
                                    <div class="verbindung-sperre-zeile">
                                        <label class="verbindung-sperre-label">🔒 ab Orden</label>
                                        <input class="editor-input editor-input-klein" type="number" min="0" max="8"
                                               value="@ort.NordMinOrden"
                                               @onchange="e => { if(int.TryParse(e.Value?.ToString(), out int v)) { ort.NordMinOrden = v; Speichern(); } }" />
                                    </div>
                                </div>
                            }
                        </div>
                        <!-- Mitte-Zeile: West | [Name] | Ost -->
                        <div class="kompass-mitte-zeile">
                            <div class="kompass-west">
                                <label class="kompass-label">⬅️ West</label>
                                <select class="editor-input kompass-select"
                                        value="@(ort.West ?? "")"
                                        @onchange="e => { var v = e.Value?.ToString(); ort.West = string.IsNullOrEmpty(v) ? null : v; SyncVerbindungen(ort); Speichern(); }">
                                    <option value="">— keine —</option>
                                    @foreach (var o in editorOrte.Where(o => o.Id != ort.Id && SameRegion(o, ort)).OrderBy(o => o.Name))
                                    {
                                        <option value="@o.Id">@o.Name</option>
                                    }
                                </select>
                                @if (ort.West != null)
                                {
                                    <div class="verbindung-optionen">
                                        <select class="editor-input verbindung-typ-select"
                                                value="@(ort.WestTyp ?? "normal")"
                                                @onchange="e => SetWestTyp(e, ort)">
                                            <option value="normal">🚶 Normal</option>
                                            <option value="untergrund">🕳️ Unterirdisch</option>
                                            <option value="teleport">🌀 Teleport</option>
                                        </select>
                                        <div class="verbindung-sperre-zeile">
                                            <label class="verbindung-sperre-label">🔒 ab Orden</label>
                                            <input class="editor-input editor-input-klein" type="number" min="0" max="8"
                                                   value="@ort.WestMinOrden"
                                                   @onchange="e => { if(int.TryParse(e.Value?.ToString(), out int v)) { ort.WestMinOrden = v; Speichern(); } }" />
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="kompass-mitte">
                                <div class="kompass-ort-name">@ort.Name</div>
                            </div>
                            <div class="kompass-ost">
                                <label class="kompass-label">➡️ Ost</label>
                                <select class="editor-input kompass-select"
                                        value="@(ort.Ost ?? "")"
                                        @onchange="e => { var v = e.Value?.ToString(); ort.Ost = string.IsNullOrEmpty(v) ? null : v; SyncVerbindungen(ort); Speichern(); }">
                                    <option value="">— keine —</option>
                                    @foreach (var o in editorOrte.Where(o => o.Id != ort.Id && SameRegion(o, ort)).OrderBy(o => o.Name))
                                    {
                                        <option value="@o.Id">@o.Name</option>
                                    }
                                </select>
                                @if (ort.Ost != null)
                                {
                                    <div class="verbindung-optionen">
                                        <select class="editor-input verbindung-typ-select"
                                                value="@(ort.OstTyp ?? "normal")"
                                                @onchange="e => SetOstTyp(e, ort)">
                                            <option value="normal">🚶 Normal</option>
                                            <option value="untergrund">🕳️ Unterirdisch</option>
                                            <option value="teleport">🌀 Teleport</option>
                                        </select>
                                        <div class="verbindung-sperre-zeile">
                                            <label class="verbindung-sperre-label">🔒 ab Orden</label>
                                            <input class="editor-input editor-input-klein" type="number" min="0" max="8"
                                                   value="@ort.OstMinOrden"
                                                   @onchange="e => { if(int.TryParse(e.Value?.ToString(), out int v)) { ort.OstMinOrden = v; Speichern(); } }" />
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <!-- Süd -->
                        <div class="kompass-sued">
                            <label class="kompass-label">⬇️ Süd</label>
                            <select class="editor-input kompass-select"
                                    value="@(ort.Sued ?? "")"
                                    @onchange="e => { var v = e.Value?.ToString(); ort.Sued = string.IsNullOrEmpty(v) ? null : v; SyncVerbindungen(ort); Speichern(); }">
                                <option value="">— keine —</option>
                                    @foreach (var o in editorOrte.Where(o => o.Id != ort.Id && SameRegion(o, ort)).OrderBy(o => o.Name))
                                    {
                                        <option value="@o.Id">@o.Name</option>
                                    }
                                </select>
                            @if (ort.Sued != null)
                            {
                                <div class="verbindung-optionen">
                                    <select class="editor-input verbindung-typ-select"
                                            value="@(ort.SuedTyp ?? "normal")"
                                            @onchange="e => SetSuedTyp(e, ort)">
                                        <option value="normal">🚶 Normal</option>
                                        <option value="untergrund">🕳️ Unterirdisch</option>
                                        <option value="teleport">🌀 Teleport</option>
                                    </select>
                                    <div class="verbindung-sperre-zeile">
