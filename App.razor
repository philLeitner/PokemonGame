@using MonsterKampf.Services
@using MonsterKampf.Models
@inject GameService Game
@inject NavigationManager Nav
@implements IDisposable

<!-- Wird angezeigt, solange die Spieldaten (JSON) geladen werden -->
@if (!Game.DatenGeladen)
{
    <div class="loading-screen">
        <div class="loading-box">
            <div class="pokeball-anim">⚫</div>
            <h2>Monster Kampf</h2>
            <p class="lade-text @(Game.LadeFehler != null ? "lade-fehler-text" : "")">@Game.LadeStatus</p>

            @if (Game.LadeFehler != null)
            {
                <!-- Fehler-Bereich: Wird nur angezeigt wenn ein Ladefehler aufgetreten ist -->
                <div class="lade-fehler-bereich">
                    <!-- Button zum Ein-/Ausblenden des Fehlerdetails -->
                    <button class="btn-fehler-detail" @onclick="FehlerDetailToggle">
                        @(fehlerDetailSichtbar ? "🔼 Fehler ausblenden" : "🔍 Fehler anzeigen")
                    </button>
                    @if (fehlerDetailSichtbar)
                    {
                        <!-- Vollständiger Fehlertext -->
                        <pre class="fehler-detail-text">@Game.LadeFehler</pre>
                    }
                    <!-- Neu laden Button -->
                    <button class="btn-neu-laden" @onclick="NeuLaden">🔄 Neu laden</button>
                </div>
            }
            else
            {
                <div class="lade-balken">
                    <div class="lade-fortschritt"></div>
                </div>
            }
        </div>
    </div>
}
else
{
    <!-- Router: Je nach aktueller Spielphase wird die entsprechende Seite (Komponente) geladen -->
    @switch (Game.Phase)
    {
        case SpielPhase.Hauptmenü:
            <MonsterKampf.Pages.Hauptmenü />
            break;
        case SpielPhase.StarterWahl:
            <!-- Starter-Auswahl: Spieler wählt sein erstes Monster -->
            <MonsterKampf.Pages.StarterWahl />
            break;
        case SpielPhase.Weltkarte:
            <!-- Weltkarte: Hauptspielbereich mit Minimap und Navigation -->
            <MonsterKampf.Pages.Weltkarte />
            break;
        case SpielPhase.Kampf:
            <!-- Kampf-Bildschirm: Rundenbasierter Kampf gegen Gegner -->
            <MonsterKampf.Pages.Kampf />
            break;
        case SpielPhase.Einstellungen:
            <MonsterKampf.Pages.Einstellungen />
            break;
        case SpielPhase.ZähneShop:
            <!-- Zähne-Shop: Hier können Upgrades mit Zähnen gekauft werden -->
            <MonsterKampf.Pages.ZähneShop />
            break;
        case SpielPhase.EigeneMapStart:
            <MonsterKampf.Pages.EigeneMapStart />
            break;
        case SpielPhase.AdminPanel:
            <MonsterKampf.Pages.AdminPanel />
            break;
        case SpielPhase.Pokédex:
            <!-- Pokédex: Übersicht aller Monster mit Filter und Detailansicht -->
            <MonsterKampf.Pages.Pokédex />
            break;
        case SpielPhase.MonsterEditor:
            <MonsterKampf.Pages.MonsterEditor />
            break;
        case SpielPhase.RegionsWahl:
            <!-- Regionswahl: Spieler wählt die nächste Spielregion -->
            <MonsterKampf.Pages.RegionsWahl />
            break;
        case SpielPhase.NachArenaLeiter:
            <!-- Nach dem Arena-Leiter: Belohnungen und Weiter-Optionen -->
            <MonsterKampf.Pages.NachArenaLeiter />
            break;
        case SpielPhase.StarterWahlNeuRegion:
            <MonsterKampf.Pages.NachArenaLeiter />
            break;
        case SpielPhase.LigaAbschluss:
            <!-- Liga-Abschluss: Alle Arenen einer Region wurden besiegt -->
            <MonsterKampf.Pages.LigaAbschluss />
            break;
        default:
            <MonsterKampf.Pages.Hauptmenü />
            break;
    }
}

@code {
    // Steuert ob der Fehlerdetail-Text sichtbar ist
    private bool fehlerDetailSichtbar = false;

    // Wird aufgerufen, wenn die App startet. Lädt alle JSON-Daten (Monster, Attacken, Items).
    protected override async Task OnInitializedAsync()
    {
        // Auf Änderungen im GameService reagieren und die UI neu rendern
        Game.OnChange += StateHasChanged;
        await Game.DatenLadenAsync();
    }

    // Fehlerdetail ein- oder ausblenden
    private void FehlerDetailToggle() => fehlerDetailSichtbar = !fehlerDetailSichtbar;

    // Seite neu laden (lädt die gesamte App neu)
    private void NeuLaden() => Nav.NavigateTo(Nav.Uri, true);

    // Aufräumen: Event-Handler entfernen wenn die Komponente zerstört wird
    public void Dispose() => Game.OnChange -= StateHasChanged;
}
